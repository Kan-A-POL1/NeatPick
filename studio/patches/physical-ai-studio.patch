+class _SnapshotPublisher:
+    """Copy each finished ``step-*.ckpt`` the trainer writes into the Volume while it trains (junction-2026).
+
+    A checkpoint counts as finished once its size is unchanged between two polls; a final poll (the run is over)
+    publishes everything left. Studio polls the Volume and turns every published snapshot into a model it can run
+    before the training ends.
+    """
+
+    def __init__(self, sources: tuple[Path, ...], target: Path) -> None:
+        self._sources = sources
+        self._target = target
+        self._sizes: dict[str, int] = {}
+        self._published: set[str] = set()
+        self._lock = threading.Lock()
+
+    def poll(self, *, final: bool = False) -> None:
+        import shutil
+
+        with self._lock:
+            try:
+                fresh = False
+                for checkpoint in sorted(c for s in self._sources if s.is_dir() for c in s.glob("step-*.ckpt")):
+                    size = checkpoint.stat().st_size
+                    settled = final or self._sizes.get(checkpoint.name) == size
+                    self._sizes[checkpoint.name] = size
+                    if checkpoint.name in self._published or size == 0 or not settled:
+                        continue
+                    self._target.mkdir(parents=True, exist_ok=True)
+                    partial = self._target / f".{checkpoint.name}.partial"
+                    shutil.copyfile(checkpoint, partial)
+                    partial.rename(self._target / checkpoint.name)
+                    self._published.add(checkpoint.name)
+                    fresh = True
+                    print(f"[snapshot-publisher] published {checkpoint.name} ({size} bytes)", flush=True)
+                if fresh:
+                    volume.commit()
+            except Exception as error:  # noqa: BLE001 - best effort, never break the training
+                print(f"[snapshot-publisher] {type(error).__name__}: {error}", flush=True)
+
+    def run(self, stop: threading.Event, interval_s: float = 10.0) -> None:
+        while not stop.wait(interval_s):
+            self.poll()
+
+
