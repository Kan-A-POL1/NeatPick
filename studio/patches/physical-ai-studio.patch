@@ -0,0 +1,133 @@
+"""junction-2026: benchmark store and statistics."""
+
+from datetime import UTC, datetime, timedelta
+from uuid import uuid4
+
+import pytest
+
+from services.benchmarks import (
+    BenchmarkCreate,
+    BenchmarkStore,
+    BenchmarkTrial,
+    benchmark_csv,
+    benchmark_stats,
+    wilson_interval,
+)
+
+T0 = datetime(2026, 11, 14, 12, 0, tzinfo=UTC)
+
+
+def _trial(index: int, outcome: str, elapsed: float = 5.0, *, timed_out: bool = False) -> BenchmarkTrial:
+    return BenchmarkTrial(
+        index=index,
+        outcome=outcome,
+        elapsed_s=elapsed,
+        timed_out=timed_out,
+        started_at=T0,
+        marked_at=T0 + timedelta(seconds=elapsed),
+    )
+
+
+def test_wilson_interval_matches_the_textbook_values() -> None:
+    low, high = wilson_interval(8, 10)
+    assert low == pytest.approx(0.4902, abs=1e-4)
+    assert high == pytest.approx(0.9433, abs=1e-4)
+    assert wilson_interval(0, 0) is None
+    assert wilson_interval(0, 5)[0] == 0.0
+    assert wilson_interval(5, 5)[1] == 1.0
+
+
+def test_stats_leave_aborted_trials_and_timed_out_successes_out() -> None:
+    stats = benchmark_stats(
+        [
+            _trial(1, "success", 4.0),
+            _trial(2, "success", 6.0),
+            _trial(3, "success", 10.0, timed_out=True),  # done, but marked after the time was up
+            _trial(4, "fail", 10.0, timed_out=True),
+            _trial(5, "aborted", 2.0),
+        ]
+    )
+    assert (stats.trials, stats.successes, stats.failures, stats.aborted) == (5, 3, 1, 1)
+    assert stats.success_rate == pytest.approx(0.75)
+    assert stats.ci_low is not None and stats.ci_low < 0.75 < stats.ci_high
+    assert stats.mean_time_to_success_s == pytest.approx(5.0)
+    assert stats.median_time_to_success_s == pytest.approx(5.0)
+
+
+def test_stats_of_an_empty_benchmark_have_no_rate() -> None:
+    stats = benchmark_stats([])
+    assert stats.success_rate is None and stats.ci_low is None and stats.mean_time_to_success_s is None
+
+
+def test_store_round_trip_filters_and_undo(tmp_path) -> None:
+    store = BenchmarkStore(tmp_path / "benchmarks")
+    project, other_project, model = uuid4(), uuid4(), uuid4()
+    first = store.create(project, "act-1", BenchmarkCreate(name="blue brick", model_id=model, duration_s=10))
+    store.create(project, "act-2", BenchmarkCreate(name="blue brick", model_id=uuid4()))
+    store.create(other_project, "act-1", BenchmarkCreate(name="elsewhere", model_id=model))
+
+    assert {b.model_name for b in store.list(project)} == {"act-1", "act-2"}
+    assert [b.id for b in store.list(project, model)] == [first.id]
+    assert store.list(uuid4()) == []
+
+    for outcome in ("success", "fail"):
+        store.add_trial(first.id, outcome=outcome, elapsed_s=3.21, timed_out=False, started_at=T0, marked_at=T0)
+    trials = store.get(first.id).trials
+    assert [(t.index, t.outcome) for t in trials] == [(1, "success"), (2, "fail")]
+
+    assert [t.index for t in store.remove_last_trial(first.id).trials] == [1]
+    # The next trial continues the numbering from what is left.
+    store.add_trial(first.id, outcome="fail", elapsed_s=10, timed_out=True, started_at=T0, marked_at=T0)
+    assert [t.index for t in store.get(first.id).trials] == [1, 2]
+
+    store.delete(first.id)
+    with pytest.raises(KeyError):
+        store.get(first.id)
+
+
+def test_store_refuses_unknown_benchmarks_and_undo_with_no_trial(tmp_path) -> None:
+    store = BenchmarkStore(tmp_path)
+    with pytest.raises(KeyError):
+        store.add_trial(uuid4(), outcome="success", elapsed_s=1, timed_out=False, started_at=T0, marked_at=T0)
+    benchmark = store.create(uuid4(), "m", BenchmarkCreate(name="x", model_id=uuid4()))
+    with pytest.raises(ValueError, match="no marked trial"):
+        store.remove_last_trial(benchmark.id)
+
+
+def test_a_corrupt_file_does_not_hide_the_others(tmp_path) -> None:
+    store = BenchmarkStore(tmp_path)
+    project = uuid4()
+    store.create(project, "m", BenchmarkCreate(name="ok", model_id=uuid4()))
+    (tmp_path / f"{uuid4()}.json").write_text("{not json")
+    assert [b.name for b in store.list(project)] == ["ok"]
+
+
+def test_csv_has_one_row_per_trial(tmp_path) -> None:
+    store = BenchmarkStore(tmp_path)
+    benchmark = store.create(uuid4(), "m", BenchmarkCreate(name="x", model_id=uuid4()))
+    store.add_trial(benchmark.id, outcome="success", elapsed_s=4.5, timed_out=False, started_at=T0, marked_at=T0)
+    lines = benchmark_csv(store.get(benchmark.id)).strip().splitlines()
+    assert lines[0] == "trial,outcome,elapsed_s,timed_out,started_at,marked_at"
+    assert lines[1].startswith("1,success,4.500,0,2026-11-14T12:00:00")
+
+
+def test_the_target_is_enforced_when_a_mark_is_recorded(tmp_path) -> None:
+    store = BenchmarkStore(tmp_path)
+    benchmark = store.create(uuid4(), "m", BenchmarkCreate(name="x", model_id=uuid4(), target_trials=1))
+    store.add_trial(benchmark.id, outcome="success", elapsed_s=1, timed_out=False, started_at=T0, marked_at=T0)
+    with pytest.raises(ValueError, match="complete"):
+        store.add_trial(benchmark.id, outcome="fail", elapsed_s=1, timed_out=False, started_at=T0, marked_at=T0)
+    # An unmarked trial that ends anyway (stopped, taken over) is still kept as history.
+    store.add_trial(benchmark.id, outcome="aborted", elapsed_s=1, timed_out=False, started_at=T0, marked_at=T0)
+    assert [t.outcome for t in store.get(benchmark.id).trials] == ["success", "aborted"]
+
+
+def test_undo_removes_the_last_mark_and_keeps_aborted_trials(tmp_path) -> None:
+    store = BenchmarkStore(tmp_path)
+    benchmark = store.create(uuid4(), "m", BenchmarkCreate(name="x", model_id=uuid4()))
+    for outcome in ("success", "fail", "aborted"):
+        store.add_trial(benchmark.id, outcome=outcome, elapsed_s=1, timed_out=False, started_at=T0, marked_at=T0)
+    assert [t.outcome for t in store.remove_last_trial(benchmark.id).trials] == ["success", "aborted"]
+    assert [t.outcome for t in store.remove_last_trial(benchmark.id).trials] == ["aborted"]
+    with pytest.raises(ValueError, match="no marked trial"):
+        store.remove_last_trial(benchmark.id)
