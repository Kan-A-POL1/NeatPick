+    created = materialize_snapshot_models(_model(model_dir), tmp_path / "models", {"act-run-step2500"})
+    assert [m.name for m in created] == ["act-run-step5000"]
+    assert not (model_dir / SNAPSHOTS_DIRNAME).exists()
