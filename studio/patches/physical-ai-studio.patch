+    checkpoint.write_text("weights")
+    with patch("training.job._load_policy_from_checkpoint", side_effect=RuntimeError("corrupt")):
+        try:
+            build_live_snapshot_model(_model(tmp_path / "m"), 100, checkpoint, tmp_path / "models")
+        except RuntimeError:
+            pass
+    assert not list((tmp_path / "models").iterdir())
