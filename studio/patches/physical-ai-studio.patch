--- /dev/null
+++ b/application/ui/src/features/runtime-session/workspace/corrections-panel.tsx
@@ -0,0 +1,404 @@
+import { useState, useSyncExternalStore } from 'react';
+
+import { Button, Divider, Flex, Heading, NumberField, Text, toast } from '@geti-ui/ui';
+
+import { fetchClient } from '../../../api/client';
+import { SchemaModelControlConfig } from '../../../api/openapi-spec';
+import { useProjectId } from '../../projects/use-project';
+import { ERROR_TOAST, useRuntimeSession } from '../runtime-session-provider';
+
+import classes from './corrections-panel.module.css';
+
+/**
+ * junction-2026: human corrections during inference (HG-DAgger).
+ *
+ * Pause holds the follower (torque on). The leader must then be lined up with it: the server refuses the take-over
+ * unless every joint stays within ALIGNMENT of its calibrated span for half a second. While the human drives, only
+ * that segment is recorded, into "<model dataset>-corrections". "Fine-tune now" trains a new version of the model
+ * from its own weights on those corrections.
+ */
+const ALIGNMENT = 0.05;
+const TAKE_OVER_MAX_S = 120;
+const CORRECTION_TAG = 'correction';
+const HOLD = { type: 'hold', hz: 20 } as const;
+
+const spanOf = (joint: string) => (joint.includes('gripper') ? 100 : 200);
+
+type Phase = 'idle' | 'paused' | 'correcting' | 'unsafe';
+
+const json = async (response: Response) => {
+    const body = await response.json().catch(() => null);
+    if (!response.ok) {
+        throw new Error((body && (body.message ?? body.detail)) || `HTTP ${response.status}`);
+    }
+    return body;
+};
+
+/** Leader vs follower, per joint, as a fraction of its calibrated span. */
+const useAlignment = () => {
+    const { observations } = useRuntimeSession();
+    const observation = useSyncExternalStore(
+        (onChange) => observations.subscribe(onChange),
+        () => observations.value
+    );
+    const state = observation?.state ?? {};
+    const leader = observation?.leader ?? null;
+    if (leader === null) {
+        return null;
+    }
+    return Object.keys(state).map((joint) => ({
+        joint: joint.replace('.pos', ''),
+        error: Math.abs((leader[joint] ?? 0) - state[joint]) / spanOf(joint),
+    }));
+};
+
+const AlignmentBars = ({ rows }: { rows: { joint: string; error: number }[] | null }) => {
+    if (rows === null) {
+        return <Text UNSAFE_className={classes.hint}>Waiting for the leader arm…</Text>;
+    }
+    return (
+        <div className={classes.bars} role='list' aria-label='Leader alignment'>
+            {rows.map(({ joint, error }) => {
+                const ok = error <= ALIGNMENT;
+                return (
+                    <div key={joint} role='listitem' className={classes.bar}>
+                        <span className={classes.joint}>{joint}</span>
+                        <span className={classes.track}>
+                            <span
+                                className={ok ? classes.fillOk : classes.fillOff}
+                                style={{ width: `${Math.min(100, (error / 0.25) * 100)}%` }}
+                            />
+                            <span className={classes.limit} style={{ left: `${(ALIGNMENT / 0.25) * 100}%` }} />
+                        </span>
+                        <span className={ok ? classes.valueOk : classes.valueOff}>{(error * 100).toFixed(1)} %</span>
+                    </div>
+                );
+            })}
+        </div>
+    );
+};
+
+export const CorrectionsPanel = ({
+    task,
+    modelControl,
+}: {
+    task: string;
+    /** How to resume the model after a correction: the control Play would start. */
+    modelControl: SchemaModelControlConfig;
+}) => {
+    const { state, send } = useRuntimeSession();
+    const { project_id } = useProjectId();
+    const [phase, setPhase] = useState<Phase>('idle');
+    const [isBusy, setIsBusy] = useState(false);
+    const [epochs, setEpochs] = useState(20);
+    const rows = useAlignment();
+    const isAligned = rows !== null && rows.every((row) => row.error <= ALIGNMENT);
+
+    const modelId = state?.model?.model_id;
+    const environmentId = state?.environment?.environment_id;
+    const hasLeader = state?.environment?.leader_id != null;
+    const correctionsLoaded = state?.dataset?.name?.endsWith('-corrections') ?? false;
+    const recorded = correctionsLoaded ? (state?.dataset?.episodes_recorded ?? 0) : 0;
+
+    const command = async (payload: Parameters<typeof send>[0], failure: string) => {
+        const ack = await send(payload);
+        if (!ack.ok) {
+            throw new Error(ack.error?.message ?? failure);
+        }
+    };
+
+    /** Put the follower back on the hold after ``error``, then throw it (with the hold's own failure, if any). */
+    const holdAfter = async (error: unknown): Promise<never> => {
+        const reason = error instanceof Error ? error.message : String(error);
+        try {
+            await command({ command: 'set_control', control: HOLD }, 'Could not hold the follower.');
+        } catch (holdError) {
+            const holdReason = holdError instanceof Error ? holdError.message : String(holdError);
+            // Not "paused": the follower is not known to be held, so no take-over or resume is offered.
+            setPhase('unsafe');
+            throw new Error(`${reason} Holding the follower also failed: ${holdReason}`);
+        }
+        setPhase('paused');
+        throw new Error(`${reason} The follower holds its position.`);
+    };
+
+    const step = async (work: () => Promise<void>) => {
+        setIsBusy(true);
+        try {
+            await work();
+        } catch (error) {
+            toast.negative(error instanceof Error ? error.message : String(error), ERROR_TOAST);
+        } finally {
+            setIsBusy(false);
+        }
+    };
+
+    /** The "<model dataset>-corrections" dataset, created on first use, loaded for recording. */
+    const loadCorrectionsDataset = async () => {
+        if (correctionsLoaded) {
+            return;
+        }
+        const detail = await json(
+            await fetch(fetchClient.PATH('/api/models/{model_id}', { params: { path: { model_id: modelId! } } }))
+        );
+        const source = await json(
+            await fetch(
+                fetchClient.PATH('/api/dataset/{dataset_id}', {
+                    params: { path: { dataset_id: detail.model.dataset_id } },
+                })
+            )
+        );
+        const name = `${source.name}-corrections`;
+        const project = await json(
+            await fetch(fetchClient.PATH('/api/projects/{project_id}', { params: { path: { project_id } } }))
+        );
+        let dataset = (project.datasets ?? []).find((d: { name: string }) => d.name === name);
+        if (!dataset) {
+            dataset = await json(
+                await fetch(fetchClient.PATH('/api/dataset'), {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({
+                        name,
+                        default_task: task,
+                        project_id,
+                        environment_id: environmentId ?? source.environment_id,
+                    }),
+                })
+            );
+        }
+        await command({ command: 'load_dataset', dataset_id: dataset.id }, 'Could not load the corrections dataset.');
+    };
+
+    const pause = () =>
+        step(async () => {
+            // Stop the model first: the follower holds where it is, torque on.
+            try {
+                await command({ command: 'set_control', control: HOLD }, 'Could not pause.');
+            } catch (error) {
+                // The model is stopped either way: confirm a hold, or show the follower as unsafe.
+                await holdAfter(error);
+            }
+            setPhase('paused');
+            await loadCorrectionsDataset();
+        });
+
+    const takeOver = () =>
+        step(async () => {
+            try {
+                await command(
+                    {
+                        command: 'set_control',
+                        control: {
+                            type: 'teleop',
+                            hz: 100,
+                            grace_s: 0.3,
+                            require_alignment: true,
+                            alignment_fraction: ALIGNMENT,
+                            alignment_hold_s: 0.5,
+                            max_duration_s: TAKE_OVER_MAX_S,
+                        },
+                    },
+                    'The leader is not aligned with the follower.'
+                );
+            } catch (error) {
+                // Refused or failed: confirm the hold, or show the follower as unsafe.
+                await holdAfter(error);
+            }
+            try {
+                await command({ command: 'start_episode', task, tag: CORRECTION_TAG }, 'Could not start recording.');
+            } catch (error) {
+                // The follower must not stay on the leader while nothing records: back to the hold.
+                await holdAfter(error);
+            }
+            setPhase('correcting');
+        });
+
+    const finishCorrection = (save: boolean, resumeModel: boolean) =>
+        step(async () => {
+            try {
+                await command(
+                    save ? { command: 'save_episode' } : { command: 'discard_episode' },
+                    'Could not stop recording.'
+                );
+            } catch (error) {
+                // Whatever happened to the episode, the follower leaves the leader: hold, then report.
+                await holdAfter(error);
+            }
+            try {
+                await command(
+                    { command: 'set_control', control: resumeModel ? modelControl : HOLD },
+                    'Could not switch control.'
+                );
+            } catch (error) {
+                await holdAfter(error);
+            }
+            setPhase(resumeModel ? 'idle' : 'paused');
+        });
+
+    const retryHold = () =>
+        step(async () => {
+            await command({ command: 'set_control', control: HOLD }, 'Could not hold the follower.');
+            setPhase('paused');
+        });
+
+    const fineTune = () =>
+        step(async () => {
+            const datasetId = state?.dataset?.dataset_id;
+            if (!datasetId || !modelId) {
+                throw new Error('Record at least one correction first.');
+            }
+            // Unloading copies the recorded corrections into the dataset on disk.
+            await command({ command: 'unload_dataset' }, 'Could not save the corrections.');
+            const detail = await json(
+                await fetch(fetchClient.PATH('/api/models/{model_id}', { params: { path: { model_id: modelId } } }))
+            );
+            const trainers = await json(await fetch(fetchClient.PATH('/api/remote-trainers')));
+            const modal = trainers.find((t: { connection_mode: string }) => t.connection_mode === 'modal');
+            if (!modal) {
+                throw new Error('No Modal training target is configured.');
+            }
+            const base = detail.model;
+            const name = base.name.endsWith('-ft') ? base.name : `${base.name}-ft`;
+            const job = await json(
+                await fetch(fetchClient.PATH('/api/jobs:train'), {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({
+                        project_id,
+                        dataset_id: datasetId,
+                        policy: base.policy,
+                        model_name: name,
+                        base_model_id: base.id,
+                        training_target: 'remote',
+                        remote_trainer_id: modal.id,
+                        modal_gpu: 'L40S',
+                        max_epochs: epochs,
+                        batch_size: 8,
+                    }),
+                })
+            );
+            const version = (base.version ?? 1) + 1;
+            toast.positive(
+                `Fine-tuning ${name} (v${version}) from ${base.name} on ${recorded} correction(s), ` +
+                    `job ${job.id.slice(0, 8)}.`
+            );
+        });
+
+    return (
+        <Flex direction='column' gap='size-150'>
+            <Divider size='S' />
+            <Heading level={4} margin={0}>
+                Corrections
+            </Heading>
+            {!hasLeader && <Text UNSAFE_className={classes.hint}>Connect a leader arm to correct the model.</Text>}
+
+            {phase === 'idle' && (
+                <Button
+                    variant='secondary'
+                    isPending={isBusy}
+                    isDisabled={!hasLeader || !modelId}
+                    onPress={() => void pause()}
+                >
+                    Pause and correct
+                </Button>
+            )}
+
+            {phase === 'paused' && (
+                <>
+                    <Text UNSAFE_className={classes.hint}>
+                        The follower holds its pose. Line the leader up with it (every joint under {ALIGNMENT * 100} %
+                        of its range), then take over.
+                    </Text>
+                    <AlignmentBars rows={rows} />
+                    <Flex gap='size-100' wrap>
+                        <Button isPending={isBusy} isDisabled={!isAligned} onPress={() => void takeOver()}>
+                            Take over
+                        </Button>
+                        <Button
+                            variant='secondary'
+                            isDisabled={isBusy}
+                            onPress={() =>
+                                void step(async () => {
+                                    try {
+                                        await command(
+                                            { command: 'set_control', control: modelControl },
+                                            'Could not resume.'
+                                        );
+                                    } catch (error) {
+                                        await holdAfter(error);
+                                    }
+                                    setPhase('idle');
+                                })
+                            }
+                        >
+                            Resume model
+                        </Button>
+                    </Flex>
+                </>
+            )}
+
+            {phase === 'unsafe' && (
+                <>
+                    <Text UNSAFE_className={classes.hint}>
+                        The follower could not be confirmed held: it may still follow the leader or lose its torque.
+                        Keep a hand near the arm, then retry the hold (or reload the environment).
+                    </Text>
+                    <Button variant='negative' isPending={isBusy} onPress={() => void retryHold()}>
+                        Retry hold
+                    </Button>
+                </>
+            )}
+
+            {phase === 'correcting' && (
+                <>
+                    <Text UNSAFE_className={classes.recording}>
+                        Recording the correction. The follower follows the leader (max {TAKE_OVER_MAX_S} s, then it
+                        holds).
+                    </Text>
+                    <Flex gap='size-100' wrap>
+                        <Button isPending={isBusy} onPress={() => void finishCorrection(true, true)}>
+                            Give back to the model
+                        </Button>
+                        <Button
+                            variant='secondary'
+                            isDisabled={isBusy}
+                            onPress={() => void finishCorrection(true, false)}
+                        >
+                            Save and hold
+                        </Button>
+                        <Button
+                            variant='negative'
+                            isDisabled={isBusy}
+                            onPress={() => void finishCorrection(false, false)}
+                        >
+                            Discard
+                        </Button>
+                    </Flex>
+                </>
+            )}
+
+            <Text UNSAFE_className={classes.hint}>
+                {recorded} correction{recorded === 1 ? '' : 's'} recorded this session
+            </Text>
+            <Flex gap='size-100' alignItems='end'>
+                <NumberField
+                    label='Fine-tune epochs'
+                    value={epochs}
+                    onChange={(value) => setEpochs(Number.isFinite(value) ? Math.max(1, value) : 20)}
+                    minValue={1}
+                    maxValue={500}
+                    width='size-1600'
+                />
+                <Button
+                    variant='accent'
+                    isPending={isBusy}
+                    isDisabled={recorded === 0 || phase === 'correcting'}
+                    onPress={() => void fineTune()}
+                >
+                    Fine-tune now
+                </Button>
+            </Flex>
+        </Flex>
+    );
+};
