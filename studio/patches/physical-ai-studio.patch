+"""junction-2026: Set home / Return home through a runtime session, and what a trial needs to start."""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from uuid import uuid4
+
+import pytest
+
+from runtime_session.store import ACTION, STATE
+from schemas.runtime_session import HoldControlConfig, ModelControlConfig, MoveControlConfig, TrialControlConfig
+from services.arm_poses import get_arm_poses
+
+from .fixtures import FOLLOWER_ID, make_environment
+
+
+async def _until(condition, within: float = 5.0) -> None:
+    deadline = time.monotonic() + within
+    while not condition():
+        assert time.monotonic() < deadline, "condition never held"
+        await asyncio.sleep(0.02)
+
+
+async def test_set_home_then_return_home_moves_there_and_stopping_holds(new_session) -> None:
+    session = await new_session()
+    await session.load_environment(make_environment(cameras=0))
+    store = session.store
+    try:
+        await _until(lambda: store.read(STATE) is not None)
+        here = store.read(STATE).value.tolist()
+        await session.save_pose("home")
+        home = get_arm_poses().poses(FOLLOWER_ID)["home"]
+        assert list(home.values()) == pytest.approx(here)
+
+        await session.set_control(MoveControlConfig(pose="home", target={"forged": 1.0}))
+        control = session.state().control
+        assert isinstance(control, MoveControlConfig) and control.target == home  # the saved pose, not the client's
+        await _until(lambda: store.read(ACTION).value.tolist() == pytest.approx(list(home.values())))
+
+        await session.set_control(None)  # leaving a move never drops the arm
+        assert session.state().control == HoldControlConfig()
+    finally:
+        await session.stop()
+
+
+async def test_return_to_an_unsaved_pose_is_refused(new_session) -> None:
+    session = await new_session()
+    await session.load_environment(make_environment(cameras=0))
+    try:
+        with pytest.raises(ValueError, match="No pose 'nowhere'"):
+            await session.set_control(MoveControlConfig(pose="nowhere"))
+        assert session.state().control is None
+    finally:
+        await session.stop()
+
+
+async def test_a_trial_needs_a_loaded_model(new_session) -> None:
+    session = await new_session()
+    await session.load_environment(make_environment(cameras=0))
+    try:
+        await _until(lambda: session.store.read(STATE) is not None)
+        await session.save_pose("home")
+        with pytest.raises(ValueError, match="Load a model"):
+            await session.set_control(TrialControlConfig(benchmark_id=uuid4(), model=ModelControlConfig()))
+    finally:
+        await session.stop()
