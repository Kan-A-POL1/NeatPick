+
+def test_live_snapshot_becomes_an_exported_model_of_its_own(tmp_path: Path) -> None:
+    checkpoint = tmp_path / "step-002500.ckpt"
+    checkpoint.write_text("weights")
+    parent = _model(tmp_path / "models" / "main")
+    with (
+        patch("training.job._load_policy_from_checkpoint", return_value=MagicMock()) as load,
+        patch("training.job._export") as export,
+    ):
+        created = build_live_snapshot_model(parent, 2500, checkpoint, tmp_path / "models")
+    assert created.name == "act-run-step2500" and created.id != parent.id and created.snapshot_id is None
+    assert (Path(created.path) / CHECKPOINT_NAME).read_text() == "weights"
+    assert not checkpoint.exists()
+    assert load.call_args.args[0].policy == "act"
+    assert export.call_args.args[1] == Path(created.path) and export.call_args.args[3] == ["openvino", "torch"]
