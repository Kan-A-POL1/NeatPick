diff --git a/application/ui/src/features/robots/camera-form/components/crop-overlay.tsx b/application/ui/src/features/robots/camera-form/components/crop-overlay.tsx
new file mode 100644
index 00000000..79a2df87
--- /dev/null
+++ b/application/ui/src/features/robots/camera-form/components/crop-overlay.tsx
@@ -0,0 +1,92 @@
+import { KeyboardEvent, PointerEvent, useRef } from 'react';
+
+import { CameraCrop, Edge, FULL_FRAME, moveCrop, resizeCrop } from '../../../cameras/crop-math';
+import { useCropValue } from './crop-field';
+
+import classes from './crop-overlay.module.css';
+
+const KEY_STEP = 0.01;
+const EDGES: Edge[] = ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'];
+const KEY_MOVES: Record<string, [number, number]> = {
+    ArrowLeft: [-KEY_STEP, 0],
+    ArrowRight: [KEY_STEP, 0],
+    ArrowUp: [0, -KEY_STEP],
+    ArrowDown: [0, KEY_STEP],
+};
+
+type Drag = { x: number; y: number; crop: CameraCrop; edge: Edge | 'move' };
+
+/** The crop frame over a full-frame preview: outside is dimmed, the body moves it, the handles resize it freely. */
+export const CropOverlay = () => {
+    const { crop: saved, setCrop } = useCropValue();
+    const crop = saved ?? FULL_FRAME;
+    const containerRef = useRef<HTMLDivElement>(null);
+    const drag = useRef<Drag | null>(null);
+
+    const start = (edge: Drag['edge']) => (event: PointerEvent<HTMLElement>) => {
+        event.stopPropagation();
+        event.currentTarget.setPointerCapture(event.pointerId);
+        drag.current = { x: event.clientX, y: event.clientY, crop, edge };
+    };
+
+    const onPointerMove = (event: PointerEvent<HTMLElement>) => {
+        const current = drag.current;
+        const box = containerRef.current?.getBoundingClientRect();
+        if (current === null || !box || box.width === 0 || box.height === 0) {
+            return;
+        }
+        const dx = (event.clientX - current.x) / box.width;
+        const dy = (event.clientY - current.y) / box.height;
+        setCrop(
+            current.edge === 'move' ? moveCrop(current.crop, dx, dy) : resizeCrop(current.crop, current.edge, dx, dy)
+        );
+    };
+
+    const onPointerUp = () => {
+        drag.current = null;
+    };
+
+    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+        const move = KEY_MOVES[event.key];
+        if (!move) {
+            return;
+        }
+        event.preventDefault();
+        // Shift + arrows resize from the bottom-right corner; arrows alone move the frame.
+        setCrop(event.shiftKey ? resizeCrop(crop, 'se', move[0], move[1]) : moveCrop(crop, move[0], move[1]));
+    };
+
+    return (
+        <div ref={containerRef} className={classes.container}>
+            <div
+                role='button'
+                tabIndex={0}
+                aria-label='Crop frame: drag it to move, drag its handles to resize, or use the (Shift +) arrow keys'
+                className={classes.frame}
+                style={{
+                    left: `${crop.x * 100}%`,
+                    top: `${crop.y * 100}%`,
+                    width: `${crop.width * 100}%`,
+                    height: `${crop.height * 100}%`,
+                }}
+                onPointerDown={start('move')}
+                onPointerMove={onPointerMove}
+                onPointerUp={onPointerUp}
+                onPointerCancel={onPointerUp}
+                onKeyDown={onKeyDown}
+            >
+                {EDGES.map((edge) => (
+                    <span
+                        key={edge}
+                        aria-hidden='true'
+                        className={`${classes.handle} ${classes[edge]}`}
+                        onPointerDown={start(edge)}
+                        onPointerMove={onPointerMove}
+                        onPointerUp={onPointerUp}
+                        onPointerCancel={onPointerUp}
+                    />
+                ))}
+            </div>
+        </div>
+    );
+};
