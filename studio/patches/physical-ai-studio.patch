+
+
+class _UnpluggedCamera:
+    """Sends frame 1, then nothing new until it is reconnected, then frame 2."""
+
+    def __init__(self) -> None:
+        self.is_connected = False
+        self.connects = 0
+        self.disconnects = 0
+
+    def connect(self) -> None:
+        self.connects += 1
+        self.is_connected = True
+
+    def disconnect(self) -> None:
+        self.disconnects += 1
+        self.is_connected = False
+
+    def read_latest(self) -> MagicMock:
+        return MagicMock(sequence=self.connects)
+
+
+def test_stream_reconnects_a_camera_that_stops_sending_frames() -> None:
+    client = _client(CameraClaimRegistry())
+    camera = _UnpluggedCamera()
+    try:
+        with (
+            patch("api.camera.build_shared_camera", return_value=camera),
+            patch("api.camera.load_undistorter", return_value=None),
+            patch("api.camera.PREVIEW_STALE_S", 0.0),
+            patch("api.camera.Rate") as rate_cls,
+            patch("utils.jpeg.encode_jpeg_rgb", return_value=b"jpeg"),
+        ):
+            rate_cls.return_value.sleep = AsyncMock(side_effect=[None, WebSocketDisconnect()])
+            with client.websocket_connect(f"/api/cameras/ws?camera={quote(_camera_query())}") as websocket:
+                # Frame 1, frame 1 resent while reconnecting, then frame 2 from the reopened camera.
+                assert [websocket.receive_bytes() for _ in range(3)] == [b"jpeg"] * 3
+        assert camera.connects == 2
+        assert camera.disconnects >= 1
+    finally:
+        app.dependency_overrides.clear()
