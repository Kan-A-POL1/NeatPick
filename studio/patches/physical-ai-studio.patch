@@ -0,0 +1,47 @@
+"""junction-2026: keep the follower where it is with torque on, and watch the leader for a correction take-over."""
+
+from __future__ import annotations
+
+import time
+from typing import TYPE_CHECKING
+
+import numpy as np
+
+from runtime_session.controls.base import Control
+from runtime_session.store import ACTION, LEADER, STATE
+
+if TYPE_CHECKING:
+    from physicalai.robot import Robot
+
+    from runtime_session.store import Store
+    from schemas.runtime_session import HoldControlConfig
+
+
+class HoldControl(Control):
+    """Re-send the pose the follower had when it started, so the robot worker keeps its torque on.
+
+    With no control at all the robot worker cuts the torque after ``idle_torque_off_s`` and the arm drops. When a
+    leader is connected, its joints are read each tick into the store's ``leader`` slot for the alignment display.
+    """
+
+    def __init__(self, store: Store, config: HoldControlConfig, leader: Robot | None = None) -> None:
+        super().__init__(store, config, name="HoldControl", hz=config.hz)
+        self.leader = leader
+        self._pose: np.ndarray | None = None
+
+    def on_start(self) -> None:
+        state = self.store.read(STATE)
+        if state is None:
+            raise ValueError("The follower's position is unknown; nothing to hold")
+        self._pose = np.array(state.value, copy=True)
+
+    def on_tick(self) -> None:
+        now = time.monotonic()
+        if self._pose is not None:
+            self.store.write(ACTION, self._pose, timestamp=now)
+        if self.leader is not None:
+            try:
+                observation = self.leader.get_observation()
+            except Exception:  # noqa: BLE001 - a flaky leader read must not stop the hold
+                return
+            self.store.write(LEADER, observation.joint_positions, timestamp=observation.timestamp)
