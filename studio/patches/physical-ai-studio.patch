+"""Registering a run's snapshots as studio models (junction-2026 patch)."""
+
+from pathlib import Path
+from uuid import uuid4
+
+from schemas import Model
+from services.training_snapshots import find_snapshot_dirs, materialize_snapshot_models
+from training.job import CHECKPOINT_NAME, SNAPSHOTS_DIRNAME
+
+
+def _model(path: Path) -> Model:
+    return Model(
+        id=uuid4(),
+        name="act-run",
+        path=str(path),
+        policy="act",
+        properties={},
+        project_id=uuid4(),
+        dataset_id=uuid4(),
+        snapshot_id=uuid4(),
+        train_job_id=uuid4(),
+    )
+
+
+def _snapshot(model_dir: Path, step: int, *, checkpoint: bool = True) -> Path:
+    directory = model_dir / SNAPSHOTS_DIRNAME / f"step-{step:06d}"
+    (directory / "exports" / "openvino").mkdir(parents=True)
+    if checkpoint:
+        (directory / CHECKPOINT_NAME).write_text(str(step))
+    return directory
+
+
+def test_snapshots_are_listed_in_step_order_and_incomplete_ones_skipped(tmp_path: Path) -> None:
+    _snapshot(tmp_path, 1000)
+    _snapshot(tmp_path, 500)
+    _snapshot(tmp_path, 1500, checkpoint=False)
+    (tmp_path / SNAPSHOTS_DIRNAME / "notes").mkdir()
+
+    assert [step for step, _ in find_snapshot_dirs(tmp_path)] == [500, 1000]
+
+
+def test_no_snapshots_directory_means_no_models(tmp_path: Path) -> None:
+    assert materialize_snapshot_models(_model(tmp_path), tmp_path / "models") == []
+
+
+def test_each_snapshot_moves_to_its_own_model_directory(tmp_path: Path) -> None:
+    model_dir = tmp_path / "models" / "main"
+    (model_dir / "exports").mkdir(parents=True)
+    _snapshot(model_dir, 500)
+    _snapshot(model_dir, 1000)
+    _snapshot(model_dir, 1500, checkpoint=False)
+    parent = _model(model_dir)
+
+    created = materialize_snapshot_models(parent, tmp_path / "models")
+
+    assert [m.name for m in created] == ["act-run-step500", "act-run-step1000"]
+    for snapshot_model, step in zip(created, (500, 1000), strict=True):
+        assert snapshot_model.id != parent.id
+        assert snapshot_model.snapshot_id is None
+        assert (snapshot_model.dataset_id, snapshot_model.train_job_id) == (parent.dataset_id, parent.train_job_id)
+        assert (Path(snapshot_model.path) / CHECKPOINT_NAME).read_text() == str(step)
+        assert snapshot_model.available_backends == ["openvino"] or snapshot_model.available_backends == []
+    assert not (model_dir / SNAPSHOTS_DIRNAME).exists()
+    assert (model_dir / "exports").is_dir()
