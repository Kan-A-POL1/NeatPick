diff --git a/application/backend/src/api/hackathon.py b/application/backend/src/api/hackathon.py
new file mode 100644
index 00000000..4f987f9d
--- /dev/null
+++ b/application/backend/src/api/hackathon.py
@@ -0,0 +1,193 @@
+"""junction-2026: the Hackathon page's arm controls (saved poses, teleop) for an environment's follower and leader."""
+
+import asyncio
+from functools import cache
+from typing import Annotated, Any
+from uuid import UUID
+
+from fastapi import APIRouter, HTTPException, Query, status
+from pydantic import BaseModel, StringConstraints
+
+from api.dependencies import EnvironmentServiceDep, RobotClientFactoryDep, RuntimeSessionRegistryDep
+from robots.robot_client_factory import RobotClientFactory
+from runtime_session.registry import RuntimeSessionRegistry
+from schemas.environment import EnvironmentWithRelations
+from services.hackathon_arm import ArmBusyError, HackathonArm, port_holders
+from settings import get_settings
+
+router = APIRouter(prefix="/api/projects/{project_id}/hackathon/arm", tags=["Hackathon"])
+
+PoseName = Annotated[str, StringConstraints(strip_whitespace=True, min_length=1, max_length=64)]
+EnvironmentId = Annotated[UUID, Query(description="Environment whose follower (and leader) to drive")]
+
+
+@cache
+def get_arm() -> HackathonArm:
+    """The one arm controller of this backend."""
+    return HackathonArm(get_settings().storage_dir / "hackathon" / "poses.json")
+
+
+class ArmStatus(BaseModel):
+    follower: str
+    leader: str | None
+    teleop: bool
+    in_use_by: list[str]
+    """Other programs that have the follower's or leader's serial port open."""
+    error: str | None
+    poses: dict[str, dict[str, float]]
+
+
+class SavePose(BaseModel):
+    name: PoseName
+
+
+class Teleop(BaseModel):
+    on: bool
+
+
+class Drivers:
+    def __init__(self, environment: EnvironmentWithRelations, follower: Any, leader: Any | None) -> None:
+        robots = environment.robots[0]
+        self.follower_id, self.follower_name, self.follower = robots.robot.id, robots.robot.name, follower
+        leader_robot = getattr(robots.tele_operator, "robot", None)
+        self.leader_id = leader_robot.id if leader_robot is not None else None
+        self.leader_name = leader_robot.name if leader_robot is not None else None
+        self.leader = leader
+
+
+async def _drivers(
+    project_id: UUID,
+    environment_id: UUID,
+    environments: EnvironmentServiceDep,
+    factory: RobotClientFactory,
+    registry: RuntimeSessionRegistry | None,
+) -> Drivers:
+    """The environment's follower and leader drivers, unconnected; refused while a session holds one (``registry``)."""
+    environment = await environments.get_environment_by_id(project_id, environment_id)
+    if len(environment.robots) != 1:
+        raise HTTPException(status.HTTP_400_BAD_REQUEST, f"Environment {environment.name!r} needs exactly one robot")
+    robot = environment.robots[0]
+    leader_robot = getattr(robot.tele_operator, "robot", None)
+    if registry is not None:
+        for each in (robot.robot, leader_robot):
+            if each is not None:
+                registry.require_robot_free(each.id, each.name)
+    follower, _ = await factory.build_robot_driver(robot.robot, factory)
+    leader = None if leader_robot is None else (await factory.build_robot_driver(leader_robot, factory))[0]
+    return Drivers(environment, follower, leader)
+
+
+async def _run(action: Any, *args: Any) -> Any:
+    try:
+        return await asyncio.to_thread(action, *args)
+    except ArmBusyError as error:
+        raise HTTPException(status.HTTP_409_CONFLICT, str(error)) from error
+    except KeyError as error:
+        raise HTTPException(status.HTTP_404_NOT_FOUND, f"No pose {error.args[0]!r}") from error
+    except (ConnectionError, OSError, RuntimeError, ValueError) as error:
+        raise HTTPException(status.HTTP_409_CONFLICT, f"The arm did not respond: {error}") from error
+
+
+async def _status(drivers: Drivers) -> ArmStatus:
+    arm = get_arm()
+    ports = [drivers.follower.port] + ([drivers.leader.port] if drivers.leader is not None else [])
+    in_use_by = sorted({holder for port in ports for holder in await asyncio.to_thread(port_holders, port)})
+    return ArmStatus(
+        follower=drivers.follower_name,
+        leader=drivers.leader_name,
+        teleop=arm.teleop_on,
+        in_use_by=in_use_by,
+        error=arm.status_error(),
+        poses=arm.poses(drivers.follower_id),
+    )
+
+
+@router.get("")
+async def get_arm_status(
+    project_id: UUID,
+    environment_id: EnvironmentId,
+    environments: EnvironmentServiceDep,
+    factory: RobotClientFactoryDep,
+) -> ArmStatus:
+    """The follower's saved poses, whether teleop is on, and who else has the arm open."""
+    # No session check: a session holding the arm is worth showing, not an error.
+    return await _status(await _drivers(project_id, environment_id, environments, factory, None))
+
+
+@router.post("/teleop")
+async def set_teleop(
+    project_id: UUID,
+    environment_id: EnvironmentId,
+    body: Teleop,
+    environments: EnvironmentServiceDep,
+    factory: RobotClientFactoryDep,
+    registry: RuntimeSessionRegistryDep,
+) -> ArmStatus:
+    """Leader drives follower (on), or the follower holds where it is (off)."""
+    arm = get_arm()
+    drivers = await _drivers(project_id, environment_id, environments, factory, registry)
+    if body.on:
+        if drivers.leader is None or drivers.leader_id is None:
+            raise HTTPException(status.HTTP_400_BAD_REQUEST, "This environment has no leader arm")
+        await _run(arm.start_teleop, drivers.follower_id, drivers.follower, drivers.leader_id, drivers.leader)
+    else:
+        await _run(arm.stop_teleop)
+    return await _status(drivers)
+
+
+@router.post("/poses")
+async def save_pose(
+    project_id: UUID,
+    environment_id: EnvironmentId,
+    body: SavePose,
+    environments: EnvironmentServiceDep,
+    factory: RobotClientFactoryDep,
+    registry: RuntimeSessionRegistryDep,
+) -> ArmStatus:
+    """Save where the follower is now under ``name``, replacing a pose of that name."""
+    drivers = await _drivers(project_id, environment_id, environments, factory, registry)
+    await _run(get_arm().save_pose, drivers.follower_id, drivers.follower, body.name)
+    return await _status(drivers)
+
+
+@router.post("/poses/{name}/go")
+async def go_to_pose(
+    project_id: UUID,
+    name: str,
+    environment_id: EnvironmentId,
+    environments: EnvironmentServiceDep,
+    factory: RobotClientFactoryDep,
+    registry: RuntimeSessionRegistryDep,
+) -> ArmStatus:
+    """Stop teleop, move the follower smoothly to the pose and hold it there (torque on)."""
+    drivers = await _drivers(project_id, environment_id, environments, factory, registry)
+    await _run(get_arm().go_to_pose, drivers.follower_id, drivers.follower, name)
+    return await _status(drivers)
+
+
+@router.delete("/poses/{name}")
+async def delete_pose(
+    project_id: UUID,
+    name: str,
+    environment_id: EnvironmentId,
+    environments: EnvironmentServiceDep,
+    factory: RobotClientFactoryDep,
+) -> ArmStatus:
+    """Forget a saved pose."""
+    drivers = await _drivers(project_id, environment_id, environments, factory, None)
+    await _run(get_arm().delete_pose, drivers.follower_id, name)
+    return await _status(drivers)
+
+
+@router.post("/torque-off")
+async def torque_off(
+    project_id: UUID,
+    environment_id: EnvironmentId,
+    environments: EnvironmentServiceDep,
+    factory: RobotClientFactoryDep,
+    registry: RuntimeSessionRegistryDep,
+) -> ArmStatus:
+    """Stop teleop and let the follower go limp, to pose it by hand: it drops under gravity."""
+    drivers = await _drivers(project_id, environment_id, environments, factory, registry)
+    await _run(get_arm().torque_off, drivers.follower_id, drivers.follower)
+    return await _status(drivers)
