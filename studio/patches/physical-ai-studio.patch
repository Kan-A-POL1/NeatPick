+"""junction-2026: one benchmark trial. The model drives for a fixed time, a human marks it, the follower goes home."""
+
+from __future__ import annotations
+
+import time
+from datetime import UTC, datetime
+from typing import TYPE_CHECKING
+
+import numpy as np
+from loguru import logger
+
+from runtime_session.bus import EVENTS
+from runtime_session.controls.base import Commands, Control
+from runtime_session.controls.model import ModelControl
+from runtime_session.controls.move import PoseMover, pose_vector
+from runtime_session.store import ACTION, STATE
+from schemas.runtime_session import CommandDone, ErrorMessage, TrialMarkCommand
+from services.benchmarks import marked_trials
+
+if TYPE_CHECKING:
+    from runtime_session.bus import Bus
+    from runtime_session.model import ProcessModel
+    from runtime_session.store import Store
+    from schemas.runtime_session import TrialControlConfig, TrialOutcome
+    from services.benchmarks import BenchmarkStore
+
+
+class TrialControl(Control):
+    """``running`` → (mark, or time up → ``awaiting_mark`` → mark) → ``returning`` → ``home``.
+
+    While running, the model drives exactly as :class:`ModelControl` does. A mark is recorded in the benchmark at once;
+    the follower then moves to the home pose at a bounded speed and holds it, torque on, until the next control. A
+    trial that ends before it is marked (stopped, taken over, failed) is recorded as ``aborted``.
+    """
+
+    def __init__(
+        self,
+        store: Store,
+        model: ProcessModel,
+        config: TrialControlConfig,
+        benchmarks: BenchmarkStore,
+        bus: Bus | None = None,
+    ) -> None:
+        super().__init__(store, config, name="TrialControl", hz=config.model.hz, bus=bus)
+        self.trial: TrialControlConfig = config
+        self.benchmarks = benchmarks
+        self.mover = PoseMover(store, pose_vector(store, config.target, config.home_pose), config.model.hz)
+        self.model_control = ModelControl(store, model, config.model)
+        self._model_running = False
+        self._started = 0.0
+        self._started_at = datetime.now(UTC)
+        self._held: np.ndarray | None = None
