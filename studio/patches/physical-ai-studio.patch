@@ -0,0 +1,60 @@
+"""Digital crop/zoom applied to every frame a Studio camera delivers (junction-2026 patch)."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import cv2
+
+if TYPE_CHECKING:
+    import numpy as np
+
+    from schemas.project_camera import CameraCrop
+
+
+def crop_box(crop: CameraCrop, width: int, height: int) -> tuple[int, int, int, int]:
+    """Pixel box ``(x0, y0, x1, y1)`` of ``crop`` in a ``width`` x ``height`` frame, at least 1 px each way."""
+    x0 = min(max(round(crop.x * width), 0), width - 1)
+    y0 = min(max(round(crop.y * height), 0), height - 1)
+    x1 = min(max(round((crop.x + crop.width) * width), x0 + 1), width)
+    y1 = min(max(round((crop.y + crop.height) * height), y0 + 1), height)
+    return x0, y0, x1, y1
+
+
+def output_size(width: int, height: int, crop: CameraCrop | None) -> tuple[int, int]:
+    """Size of the frames a camera delivers: the crop's own shape, as large as fits in ``width`` x ``height``.
+
+    The crop keeps its aspect ratio (nothing is stretched), so a non 4:3 crop of a 640x480 camera gives e.g. 640x360.
+    Sides are even, as the AV1/H.264 recordings need. No crop: the configured size.
+    """
+    if crop is None:
+        return width, height
+    ratio = (crop.width * width) / (crop.height * height)
+    if ratio >= width / height:
+        out_w, out_h = width, width / ratio
+    else:
+        out_w, out_h = height * ratio, height
+    return max(2, round(out_w / 2) * 2), max(2, round(out_h / 2) * 2)
+
+
+def crop_frame(
+    image: np.ndarray,
+    crop: CameraCrop | None,
+    size: tuple[int, int],
+    interpolation: int = cv2.INTER_AREA,
+) -> np.ndarray:
+    """Keep the ``crop`` region of ``image`` and resize it to ``size`` (width, height).
+
+    ``crop`` None returns ``image`` resized to ``size`` only when its shape differs. Use
+    ``cv2.INTER_NEAREST`` for depth so no reading is invented between two surfaces.
+    """
+    width, height = size
+    if crop is not None:
+        x0, y0, x1, y1 = crop_box(crop, image.shape[1], image.shape[0])
+        image = image[y0:y1, x0:x1]
+        # Zooming in upsamples: INTER_AREA is for shrinking, linear keeps edges smooth when enlarging.
+        if interpolation == cv2.INTER_AREA and (x1 - x0 < width or y1 - y0 < height):
+            interpolation = cv2.INTER_LINEAR
+    if image.shape[1] == width and image.shape[0] == height:
+        return image
+    return cv2.resize(image, (width, height), interpolation=interpolation)
