new file mode 100644
index 00000000..a8cf52e0
--- /dev/null
+++ b/application/backend/src/services/training_snapshots.py
@@ -0,0 +1,104 @@
+"""Register the intermediate snapshots a training run exported as standalone studio models.
+
+junction-2026 patch. ``training.run_training_job`` leaves one ``snapshots/step-NNNNNN/`` model directory per
+snapshot inside the main model's directory (see ``snapshot_every_n_steps``). Each one is moved to its own
+directory under ``models_dir`` and described by a :class:`~schemas.Model` named ``<model>-step<N>``.
+"""
+
+import shutil
+from pathlib import Path
+from uuid import uuid4
+
+from loguru import logger
+
+from schemas import Model
+from training.job import CHECKPOINT_NAME, SNAPSHOT_PREFIX, SNAPSHOTS_DIRNAME
+
+
+def find_snapshot_dirs(model_dir: Path) -> list[tuple[int, Path]]:
+    """Return ``(step, directory)`` for every snapshot holding a checkpoint, in step order."""
+    snapshots_dir = model_dir / SNAPSHOTS_DIRNAME
+    if not snapshots_dir.is_dir():
+        return []
+    found: list[tuple[int, Path]] = []
+    for path in snapshots_dir.iterdir():
+        step = path.name.removeprefix(SNAPSHOT_PREFIX)
+        if path.is_dir() and path.name.startswith(SNAPSHOT_PREFIX) and step.isdigit():
+            if (path / CHECKPOINT_NAME).is_file():
+                found.append((int(step), path))
+            else:
+                logger.warning("Ignoring snapshot {} without {}", path, CHECKPOINT_NAME)
+    return sorted(found)
+
+
+def materialize_snapshot_models(model: Model, models_dir: Path, skip_names: set[str] | frozenset[str] = frozenset()) -> list[Model]:
+    """Move each snapshot of ``model`` into its own model directory and describe it.
+
+    The returned models are not persisted yet. They share the parent's dataset and training job but no
+    dataset snapshot row (``snapshot_id`` is None): deleting a model also deletes its snapshot row, which
+    must not break the other models of the same run. Whatever is left of ``snapshots/`` is removed.
+    """
+    snapshot_models: list[Model] = []
+    for step, source in find_snapshot_dirs(Path(model.path)):
+        if snapshot_model_name(model, step) in skip_names:
+            continue  # already imported while the run trained
+        model_id = uuid4()
+        destination = models_dir / str(model_id)
+        try:
+            shutil.move(str(source), str(destination))
+        except OSError:
+            logger.exception("Could not move snapshot {} into the models directory", source)
+            continue
+        snapshot_models.append(
+            model.model_copy(
+                update={
+                    "id": model_id,
+                    "name": snapshot_model_name(model, step),
+                    "path": str(destination),
+                    "snapshot_id": None,
+                    "created_at": None,
+                }
+            )
+        )
+    shutil.rmtree(Path(model.path) / SNAPSHOTS_DIRNAME, ignore_errors=True)
+    return snapshot_models
+
+
+LIVE_EXPORT_BACKENDS = ["openvino", "torch"]
+"""Backends exported for a snapshot imported while its run trains: what Studio's inference runs, and quick."""
+
+
+def snapshot_model_name(model: Model, step: int) -> str:
+    return f"{model.name}-step{step}"
+
+
+def build_live_snapshot_model(model: Model, step: int, checkpoint: Path, models_dir: Path) -> Model:
+    """Turn a checkpoint published mid-run into a standalone, exported model directory (blocking: run in a thread).
+
+    The checkpoint is moved into ``models_dir/<new id>/model.ckpt`` and exported to :data:`LIVE_EXPORT_BACKENDS`,
+    like the snapshots exported at the end of a run.
+    """
+    from training import TrainingJobSpec
+    from training.job import _export, _load_policy_from_checkpoint, _release_memory
+
+    model_id = uuid4()
+    destination = models_dir / str(model_id)
+    destination.mkdir(parents=True)
+    try:
+        shutil.move(str(checkpoint), str(destination / CHECKPOINT_NAME))
+        policy = _load_policy_from_checkpoint(TrainingJobSpec(policy=model.policy), destination / CHECKPOINT_NAME)
+        _export(policy, destination, lambda *_: None, LIVE_EXPORT_BACKENDS)
+        del policy
+        _release_memory()
+    except BaseException:
+        shutil.rmtree(destination, ignore_errors=True)
+        raise
+    return model.model_copy(
+        update={
+            "id": model_id,
+            "name": snapshot_model_name(model, step),
+            "path": str(destination),
+            "snapshot_id": None,
+            "created_at": None,
+        }
+    )
