@@ -0,0 +1,107 @@
+import { useState, type FormEvent } from 'react';
+
+import { ActionButton, ComboBox, Flex, Item, Text, toast } from '@geti-ui/ui';
+import { Checkmark, Close, Edit } from '@geti-ui/ui/icons';
+import { useQueryClient } from '@tanstack/react-query';
+
+import { $api } from '../../../api/client';
+import { getApiErrorMessage } from '../../../api/errors';
+import { SchemaEpisode } from '../../../api/openapi-spec';
+import { getQueryKey } from '../../../query-client/query-client.interface';
+import { getContentsQueryKey, useTagSuggestions } from '../dataset-contents';
+import { getEpisodesQueryKey } from './episodes-query-key';
+
+import classes from './episode-tag.module.css';
+
+const useUpdateEpisodeTag = (dataset_id: string, episode_index: number) => {
+    const queryClient = useQueryClient();
+    const episodeQueryKey = getQueryKey([
+        'get',
+        '/api/dataset/{dataset_id}/episodes/{episode_index}',
+        { params: { path: { dataset_id, episode_index } } },
+    ]);
+
+    return $api.useMutation('put', '/api/dataset/{dataset_id}/episodes/{episode_index}/tag', {
+        meta: {
+            invalidates: [getEpisodesQueryKey(dataset_id), episodeQueryKey, getContentsQueryKey(dataset_id)],
+            awaits: [episodeQueryKey],
+        },
+        onSuccess: (episode) => queryClient.setQueryData(episodeQueryKey, episode),
+    });
+};
+
+/** The episode's tag ("failed to pick", ...), editable; an empty tag removes it. */
+export const EpisodeTagEditor = ({ datasetId, episode }: { datasetId: string; episode: SchemaEpisode }) => {
+    const [draft, setDraft] = useState<string | null>(null);
+    const suggestions = useTagSuggestions(datasetId);
+    const updateTag = useUpdateEpisodeTag(datasetId, episode.episode_index);
+
+    if (draft === null) {
+        return (
+            <Flex alignItems='center' gap='size-50'>
+                {episode.tag ? <span className={classes.episodeLabel}>{episode.tag}</span> : <Text>No tag</Text>}
+                <ActionButton isQuiet aria-label='Edit tag' onPress={() => setDraft(episode.tag ?? '')}>
+                    <Edit />
+                </ActionButton>
+            </Flex>
+        );
+    }
+
+    const save = async () => {
+        const tag = draft.trim();
+        if (tag !== (episode.tag ?? '')) {
+            try {
+                await updateTag.mutateAsync({
+                    params: { path: { dataset_id: datasetId, episode_index: episode.episode_index } },
+                    body: { tag: tag === '' ? null : tag },
+                });
+            } catch (error) {
+                toast.negative(getApiErrorMessage(error) ?? 'Could not change the tag.');
+                return;
+            }
+        }
+        setDraft(null);
+    };
+
+    const onSubmit = (event: FormEvent<HTMLFormElement>) => {
+        event.preventDefault();
+        void save();
+    };
+
+    return (
+        <form onSubmit={onSubmit}>
+            <Flex alignItems='center' gap='size-50'>
+                <ComboBox
+                    // eslint-disable-next-line jsx-a11y/no-autofocus
+                    autoFocus
+                    aria-label='Episode tag'
+                    allowsCustomValue
+                    menuTrigger='focus'
+                    width='size-3000'
+                    inputValue={draft}
+                    onInputChange={setDraft}
+                    defaultItems={suggestions.map((name) => ({ name }))}
+                    isDisabled={updateTag.isPending}
+                >
+                    {(item) => <Item key={item.name}>{item.name}</Item>}
+                </ComboBox>
+                <ActionButton
+                    isQuiet
+                    aria-label='Save tag'
+                    onPress={() => void save()}
+                    isDisabled={updateTag.isPending}
+                >
+                    <Checkmark />
+                </ActionButton>
+                <ActionButton
+                    isQuiet
+                    aria-label='Cancel editing tag'
+                    onPress={() => setDraft(null)}
+                    isDisabled={updateTag.isPending}
+                >
+                    <Close />
+                </ActionButton>
+            </Flex>
+        </form>
+    );
+};
