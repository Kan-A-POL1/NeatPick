new file mode 100644
index 00000000..35d3394c
--- /dev/null
+++ b/application/backend/src/internal_datasets/lerobot/episode_tags.py
@@ -0,0 +1,101 @@
+"""Episode tags ("do nothing", "failed to pick") and markers ("tourne" at frame 95), beside each episode's task.
+
+LeRobot has no place for them, so they live in Studio files in the dataset's ``meta`` folder, keyed by episode
+index. They travel with every copy of the folder; whatever renumbers episodes must renumber them too.
+
+A marker is a button pressed while recording: ``{"label": "tourne", "frame": 95}``, the frame being the first one
+recorded after the press. Markers split an episode into segments for separate policies (pick / turn / place).
+"""
+
+import json
+from collections.abc import Iterable
+from pathlib import Path
+from typing import Any
+
+TAGS_FILE = "meta/studio_episode_tags.json"
+MARKERS_FILE = "meta/studio_episode_markers.json"
+MIN_SEGMENT_FRAMES = 2
+"""lerobot gives a 1-frame episode no video stats, and the dataset then fails to finalize."""
+
+
+def read_tags(root: Path) -> dict[int, str]:
+    """Each tagged episode's tag, by episode index."""
+    path = root / TAGS_FILE
+    if not path.is_file():
+        return {}
+    return {int(index): tag for index, tag in json.loads(path.read_text()).items()}
+
+
+def write_tags(root: Path, tags: dict[int, str]) -> None:
+    """Replace every tag, atomically."""
+    path = root / TAGS_FILE
+    staged = path.with_suffix(".tmp")
+    staged.write_text(json.dumps({str(index): tag for index, tag in sorted(tags.items())}, indent=1))
+    staged.replace(path)
+
+
+def set_tag(root: Path, episode_index: int, tag: str | None) -> None:
+    """Tag the episode; an empty or ``None`` tag removes its tag."""
+    tags = read_tags(root)
+    if tag:
+        tags[episode_index] = tag
+    else:
+        tags.pop(episode_index, None)
+    write_tags(root, tags)
+
+
+def kept_tags[V](tags: dict[int, V], total_episodes: int, deleted: Iterable[int]) -> dict[int, V]:
+    """Tags (or markers) once ``deleted`` are gone, renumbered as LeRobot renumbers the episodes left (in order)."""
+    gone = set(deleted)
+    kept = [index for index in range(total_episodes) if index not in gone]
+    return {new: tags[old] for new, old in enumerate(kept) if old in tags}
+
+
+def read_markers(root: Path) -> dict[int, list[dict[str, Any]]]:
+    """Each marked episode's markers, by episode index."""
+    path = root / MARKERS_FILE
+    if not path.is_file():
+        return {}
+    return {int(index): markers for index, markers in json.loads(path.read_text()).items()}
+
+
+def write_markers(root: Path, markers: dict[int, list[dict[str, Any]]]) -> None:
+    """Replace every marker, atomically; episodes with none are left out."""
+    path = root / MARKERS_FILE
+    staged = path.with_suffix(".tmp")
+    staged.write_text(json.dumps({str(index): kept for index, kept in sorted(markers.items()) if kept}, indent=1))
+    staged.replace(path)
+
+
+def set_markers(root: Path, episode_index: int, markers: list[dict[str, Any]]) -> None:
+    """Replace the episode's markers; an empty list removes them."""
+    every = read_markers(root)
+    every[episode_index] = markers
+    write_markers(root, every)
+
+
+def segment_range(
+    markers: list[dict[str, Any]], length: int, start: str | None, end: str | None, end_at_next_marker: bool
+) -> tuple[int, int] | None:
+    """Frames ``[first, stop)`` of an episode between two markers, or ``None`` if it lacks one or is too short.
+
+    ``start`` / ``end`` name a marker, ``None`` meaning the episode's first / last frame. When a label was pressed
+    more than once, the last press counts (pressing again corrects one pressed too early). ``end_at_next_marker``
+    ends at whichever marker comes first after ``start``, or at the end of the episode.
+    """
+
+    def last(label: str) -> int | None:
+        frames = [marker["frame"] for marker in markers if marker["label"] == label]
+        return max(frames) if frames else None
+
+    first = 0 if start is None else last(start)
+    if first is None:
+        return None
+    if end_at_next_marker:
+        stop = min((marker["frame"] for marker in markers if marker["frame"] > first), default=length)
+    elif end is None:
+        stop = length
+    elif (stop := last(end)) is None:
+        return None
+    stop = min(stop, length)
+    return (first, stop) if stop - first >= MIN_SEGMENT_FRAMES else None
