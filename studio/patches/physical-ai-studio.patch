+"""junction-2026: the follower poses shared with the Hackathon page, and the smooth move profile."""
+
+import json
+from uuid import uuid4
+
+import numpy as np
+
+from services.arm_poses import MOVE_MAX_S, ArmPoses, move_profile
+
+
+def test_poses_are_kept_per_follower_in_the_hackathon_format(tmp_path) -> None:
+    path = tmp_path / "hackathon" / "poses.json"
+    arm, other = uuid4(), uuid4()
+    path.parent.mkdir()
+    path.write_text(json.dumps({str(other): {"inspect": {"a": 1.0}}}))  # saved by the Hackathon page
+    poses = ArmPoses(path)
+    assert poses.save(arm, "home", {"a": 1.23456, "b": -2.0}) == {"a": 1.235, "b": -2.0}
+    assert poses.poses(arm) == {"home": {"a": 1.235, "b": -2.0}}
+    assert poses.poses(other) == {"inspect": {"a": 1.0}}  # the other follower's poses are kept
+    assert ArmPoses(tmp_path / "missing.json").poses(arm) == {}
+
+
+def test_move_profile_eases_to_the_target_within_the_time_bound() -> None:
+    start, target = np.zeros(2), np.array([400.0, 0.0])
+    waypoints = move_profile(start, target, hz=10)
+    assert len(waypoints) == MOVE_MAX_S * 10  # a long move is slowed down to the maximum time, not sped up
+    assert np.allclose(waypoints[-1], target)
+    steps = np.diff([w[0] for w in [start, *waypoints]])
+    assert steps[0] < steps[len(steps) // 2]  # eased in
