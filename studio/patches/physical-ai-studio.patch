new file mode 100644
index 00000000..f3185617
--- /dev/null
+++ b/application/backend/src/services/hackathon_arm.py
@@ -0,0 +1,273 @@
+"""junction-2026: drive the follower outside a session, from the Hackathon page.
+
+Saved poses (``inspect``: the brick held up to the camera, ...) the follower moves to smoothly and then holds, and
+leader-to-follower teleop to put it there. Each action takes the robots' Studio claim, so a session and this page
+never drive the arm together, and refuses while another program (SortOps, Lucy) has the serial port open: two
+programs on one servo bus garble each other's packets.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import os
+import threading
+import time
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+import numpy as np
+
+from runtime_session.controls.move import by_bare_joint
+from loguru import logger
+
+from workers.robot_worker import claim_devices
+
+if TYPE_CHECKING:
+    from uuid import UUID
+
+    from physicalai.robot import Robot
+
+TELEOP_HZ = 50.0
+TELEOP_GRACE_S = 1.5
+"""Teleop starts by closing the gap to the leader over this long, so the follower does not jump to it."""
+
+MOVE_HZ = 50.0
+MOVE_SPEED = 40.0
+"""Units per second on the joint that moves most (joints span -100..100, the gripper 0..100)."""
+MOVE_MIN_S, MOVE_MAX_S = 1.0, 5.0
+
+
+class ArmBusyError(RuntimeError):
+    """The arm is in use: by another program, or by an action on this page that is still running."""
+
+
+def port_holders(port: str) -> list[str]:
+    """Other programs that have ``port`` open, named for a person ("SortOps (pid 12)"). Linux only."""
+    target = os.path.realpath(port)
+    me = os.getpid()
+    holders = []
+    for fd_dir in Path("/proc").glob("[0-9]*/fd"):
+        pid = int(fd_dir.parent.name)
+        if pid == me:
+            continue
+        try:
+            if not any(os.path.realpath(fd) == target for fd in fd_dir.iterdir()):
+                continue
+            cmdline = (fd_dir.parent / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
+            ppid = int((fd_dir.parent / "stat").read_text().rsplit(")", 1)[1].split()[1])
+        except (OSError, ValueError, IndexError):
+            continue  # gone, or not ours to read
+        if "sortops" in cmdline:
+            name = "SortOps"
+        elif "ros" in cmdline or "lucy" in cmdline.lower():
+            name = "Lucy (ROS)"
+        elif ppid == me:
+            name = "a Studio session"
+        else:
+            name = Path(cmdline.split(" ", 1)[0]).name or "another program"
+        holders.append(f"{name} (pid {pid})")
+    return holders
+
+
+def move_profile(start: np.ndarray, target: np.ndarray, hz: float = MOVE_HZ) -> list[np.ndarray]:
+    """Waypoints from ``start`` to ``target`` at ``hz``, eased in and out, the busiest joint at about MOVE_SPEED."""
+    duration = float(np.clip(np.max(np.abs(target - start)) / MOVE_SPEED, MOVE_MIN_S, MOVE_MAX_S))
+    steps = max(1, round(duration * hz))
+    waypoints = []
+    for step in range(1, steps + 1):
+        s = step / steps
+        s = s * s * (3 - 2 * s)  # smoothstep: no jerk at either end
+        waypoints.append(start + (target - start) * s)
+    return waypoints
+
+
+class _Teleop:
+    """The follower tracks the leader in a thread, holding both robots' claims until stopped."""
+
+    def __init__(self, follower: Robot, leader: Robot, claims: contextlib.ExitStack) -> None:
+        self.follower, self.leader, self.claims = follower, leader, claims
+        self.latest: np.ndarray | None = None
+        self.error: str | None = None
+        self._stop = threading.Event()
+        self._thread = threading.Thread(target=self._run, name="hackathon-teleop", daemon=True)
+        self._thread.start()
+
+    @property
+    def running(self) -> bool:
+        return self._thread.is_alive()
+
+    def _run(self) -> None:
+        try:
+            start = self.follower.get_observation().joint_positions
+            started = time.monotonic()
+            while not self._stop.wait(1 / TELEOP_HZ):
+                self.latest = self.follower.get_observation().joint_positions
+                target = self.leader.get_observation().joint_positions
+                blend = min(1.0, (time.monotonic() - started) / TELEOP_GRACE_S)
+                self.follower.send_action(start + (target - start) * blend)
+        except Exception as error:
+            logger.exception("Hackathon teleop stopped")
+            self.error = str(error)
+        finally:
+            # The follower holds where it is (torque on), the leader stays limp.
+            for robot in (self.leader, self.follower):
+                with contextlib.suppress(Exception):
+                    robot.disconnect()
+            self.claims.close()
+
+    def stop(self) -> None:
+        self._stop.set()
+        self._thread.join(timeout=5)
+
+
+class HackathonArm:
+    """One per backend: the poses file and the teleop thread, if any."""
+
+    def __init__(self, poses_file: Path) -> None:
+        self.poses_file = poses_file
+        self._lock = threading.Lock()
+        self._teleop: _Teleop | None = None
+        self.last_error: str | None = None
+
+    # Poses: {follower robot id: {pose name: {joint name: value}}}
+
+    def _read_all(self) -> dict[str, dict[str, dict[str, float]]]:
+        try:
+            return json.loads(self.poses_file.read_text())
+        except FileNotFoundError:
+            return {}
+
+    def _write_all(self, poses: dict[str, Any]) -> None:
+        self.poses_file.parent.mkdir(parents=True, exist_ok=True)
+        tmp = self.poses_file.with_suffix(".tmp")
+        tmp.write_text(json.dumps(poses, indent=2))
+        tmp.replace(self.poses_file)
+
+    def poses(self, follower_id: UUID) -> dict[str, dict[str, float]]:
+        return self._read_all().get(str(follower_id), {})
+
+    def delete_pose(self, follower_id: UUID, name: str) -> None:
+        with self._lock:
+            poses = self._read_all()
+            if poses.get(str(follower_id), {}).pop(name, None) is None:
+                raise KeyError(name)
+            self._write_all(poses)
+
+    @property
+    def teleop_on(self) -> bool:
+        return self._teleop is not None and self._teleop.running
+
+    def status_error(self) -> str | None:
+        """Why teleop stopped by itself (the arm dropped off USB, ...), else the last action's error."""
+        if self._teleop is not None and not self._teleop.running:
+            return self._teleop.error
+        return self.last_error
+
+    # Actions. Blocking: run them in a thread.
+
+    @contextlib.contextmanager
+    def _action(self) -> Any:
+        if not self._lock.acquire(blocking=False):
+            raise ArmBusyError("The arm is still busy with the last action.")
+        try:
+            self.last_error = None
+            yield
+        except ArmBusyError:
+            raise
+        except Exception as error:
+            self.last_error = str(error)
+            raise
+        finally:
+            self._lock.release()
+
+    def _stop_teleop(self) -> None:
+        if self._teleop is not None:
+            self._teleop.stop()
+            self._teleop = None
+
+    @staticmethod
+    def _claim(stack: contextlib.ExitStack, robot_id: UUID, driver: Robot) -> None:
+        """Take the robot's Studio claim and make sure no other program has its port open."""
+        stack.enter_context(claim_devices(f"studio-hackathon-{robot_id}", tuple(driver.device_ids)))
+        if holders := port_holders(driver.port):
+            raise ArmBusyError(f"{driver.port} is open in {', '.join(holders)}. Stop it first.")
+
+    def start_teleop(self, follower_id: UUID, follower: Robot, leader_id: UUID, leader: Robot) -> None:
+        with self._action():
+            if self.teleop_on:
+                return
+            if tuple(leader.joint_names) != tuple(follower.joint_names):
+                raise ValueError(f"The leader's joints {leader.joint_names} differ from {follower.joint_names}")
+            claims = contextlib.ExitStack()
+            try:
+                self._claim(claims, follower_id, follower)
+                self._claim(claims, leader_id, leader)
+                follower.connect()
+                leader.connect()
+            except BaseException:
+                for robot in (leader, follower):
+                    with contextlib.suppress(Exception):
+                        robot.disconnect()
+                claims.close()
+                raise
+            self._teleop = _Teleop(follower, leader, claims)
+
+    def stop_teleop(self) -> None:
+        with self._action():
+            self._stop_teleop()
+
+    def _with_follower(self, follower_id: UUID, follower: Robot, act: Any) -> Any:
+        """Stop teleop, then connect the follower alone for ``act(follower)``; it holds its pose afterwards."""
+        self._stop_teleop()
+        with contextlib.ExitStack() as claims:
+            self._claim(claims, follower_id, follower)
+            follower.connect()
+            try:
+                return act(follower)
+            finally:
+                follower.disconnect()
+
+    def save_pose(self, follower_id: UUID, follower: Robot, name: str) -> dict[str, float]:
+        with self._action():
+            if self.teleop_on and self._teleop is not None and self._teleop.latest is not None:
+                positions = self._teleop.latest  # read by the teleop thread, which owns the port
+            else:
+                positions = self._with_follower(
+                    follower_id, follower, lambda robot: robot.get_observation().joint_positions
+                )
+            pose = {joint: round(float(value), 3) for joint, value in zip(follower.joint_names, positions, strict=True)}
+            poses = self._read_all()
+            poses.setdefault(str(follower_id), {})[name] = pose
+            self._write_all(poses)
+            return pose
+
+    def go_to_pose(self, follower_id: UUID, follower: Robot, name: str) -> None:
+        with self._action():
+            pose = self.poses(follower_id).get(name)
+            if pose is None:
+                raise KeyError(name)
+            # junction-2026: poses saved by a runtime session use bare joint names, the driver "<joint>.pos": accept both.
+            bare = by_bare_joint(pose, f"Pose {name!r}")
+            if set(bare) != set(by_bare_joint(dict.fromkeys(follower.joint_names, 0.0), "The follower")):
+                raise ValueError(f"Pose {name!r} has joints {sorted(pose)}, the follower {follower.joint_names}")
+            target = np.array([bare[joint.removesuffix(".pos")] for joint in follower.joint_names], dtype=np.float64)
+
+            def move(robot: Robot) -> None:
+                start = robot.get_observation().joint_positions.astype(np.float64)
+                for waypoint in move_profile(start, target):
+                    robot.send_action(waypoint.astype(np.float32))
+                    time.sleep(1 / MOVE_HZ)
+                time.sleep(0.3)  # let the servos settle on the last goal before the driver re-reads it to hold
+
+            self._with_follower(follower_id, follower, move)
+
+    def torque_off(self, follower_id: UUID, follower: Robot) -> None:
+        """Let the follower go limp, to pose it by hand. It drops under gravity."""
+        with self._action():
+
+            def release(robot: Robot) -> None:
+                robot.set_torque(enabled=False)
+                robot.torque_on_disconnect = False
+
+            self._with_follower(follower_id, follower, release)
