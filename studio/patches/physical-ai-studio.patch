new file mode 100644
index 00000000..6a991925
--- /dev/null
+++ b/application/ui/src/features/cameras/camera-settings-io.tsx
@@ -0,0 +1,114 @@
+import { ChangeEvent, useRef, useState } from 'react';
+
+import { Button, Flex, toast } from '@geti-ui/ui';
+import { useQueryClient } from '@tanstack/react-query';
+
+import { fetchClient } from '../../api/client';
+import { getApiErrorMessage } from '../../api/errors';
+
+interface ImportOutcome {
+    name: string;
+    action: 'created' | 'updated' | 'skipped';
+    needs_reselection: boolean;
+    detail?: string | null;
+}
+
+const summarize = (outcomes: ImportOutcome[]) => {
+    const count = (action: ImportOutcome['action']) => outcomes.filter((o) => o.action === action).length;
+    const parts = [`${count('updated')} updated`, `${count('created')} created`];
+    if (count('skipped') > 0) {
+        parts.push(`${count('skipped')} skipped`);
+    }
+    return parts.join(', ');
+};
+
+/** Export the project's cameras to a JSON file, or import such a file by camera name (junction-2026 patch). */
+export const CameraSettingsIO = ({ projectId }: { projectId: string }) => {
+    const inputRef = useRef<HTMLInputElement>(null);
+    const [isBusy, setIsBusy] = useState(false);
+    const queryClient = useQueryClient();
+    const pathParams = { params: { path: { project_id: projectId } } };
+
+    const exportCameras = async () => {
+        setIsBusy(true);
+        try {
+            const response = await fetch(fetchClient.PATH('/api/projects/{project_id}/cameras/export', pathParams));
+            if (!response.ok) {
+                throw new Error(`HTTP ${response.status}`);
+            }
+            const json = JSON.stringify(await response.json(), null, 2);
+            const url = URL.createObjectURL(new Blob([json], { type: 'application/json' }));
+            const link = document.createElement('a');
+            link.href = url;
+            link.download = `cameras-${new Date().toISOString().slice(0, 10)}.json`;
+            link.click();
+            URL.revokeObjectURL(url);
+        } catch (error) {
+            toast.negative(`Camera export failed: ${error instanceof Error ? error.message : String(error)}`);
+        } finally {
+            setIsBusy(false);
+        }
+    };
+
+    const importCameras = async (event: ChangeEvent<HTMLInputElement>) => {
+        const file = event.target.files?.[0];
+        event.target.value = '';
+        if (!file) {
+            return;
+        }
+        setIsBusy(true);
+        try {
+            let document: unknown;
+            try {
+                document = JSON.parse(await file.text());
+            } catch {
+                toast.negative(`${file.name} is not a JSON file.`);
+                return;
+            }
+            const response = await fetch(fetchClient.PATH('/api/projects/{project_id}/cameras/import', pathParams), {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify(document),
+            });
+            const body = await response.json();
+            if (!response.ok) {
+                toast.negative(getApiErrorMessage(body) ?? `Camera import failed (HTTP ${response.status}).`);
+                return;
+            }
+            const outcomes = body as ImportOutcome[];
+            const reselect = outcomes.filter((o) => o.needs_reselection).map((o) => o.name);
+            const skipped = outcomes.filter((o) => o.action === 'skipped').map((o) => `${o.name} (${o.detail})`);
+            toast.positive(`Cameras imported: ${summarize(outcomes)}.`);
+            if (reselect.length > 0) {
+                toast.info(`Not plugged in here, choose their device again: ${reselect.join(', ')}.`);
+            }
+            if (skipped.length > 0) {
+                toast.negative(`Skipped: ${skipped.join('; ')}.`);
+            }
+            await queryClient.invalidateQueries();
+        } catch (error) {
+            toast.negative(`Camera import failed: ${error instanceof Error ? error.message : String(error)}`);
+        } finally {
+            setIsBusy(false);
+        }
+    };
+
+    return (
+        <Flex gap='size-100'>
+            <Button variant='secondary' isDisabled={isBusy} onPress={exportCameras}>
+                Export JSON
+            </Button>
+            <Button variant='secondary' isDisabled={isBusy} onPress={() => inputRef.current?.click()}>
+                Import JSON
+            </Button>
+            <input
+                ref={inputRef}
+                type='file'
+                accept='application/json,.json'
+                hidden
+                aria-label='Camera settings file'
+                onChange={importCameras}
+            />
+        </Flex>
+    );
+};
