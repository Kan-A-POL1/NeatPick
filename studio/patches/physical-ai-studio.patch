new file mode 100644
index 00000000..2a89dff3
--- /dev/null
+++ b/application/backend/tests/unit/test_camera_calibration.py
@@ -0,0 +1,65 @@
+import cv2
+import numpy as np
+import pytest
+
+from utils import camera_calibration
+from utils.camera_calibration import load_undistorter
+
+K = np.array([[600.0, 0, 320], [0, 600, 240], [0, 0, 1]])
+DIST = np.array([[-0.2, 0.05, 0, 0, 0]])
+
+
+@pytest.fixture
+def calib_dir(tmp_path, monkeypatch):
+    monkeypatch.setattr(camera_calibration, "calibration_dir", lambda: tmp_path)
+    return tmp_path
+
+
+def _write_interactive(path, frames=20, resolution=(640, 480)):
+    """Mimic opencv_interactive-calibration's output keys."""
+    fs = cv2.FileStorage(str(path), cv2.FILE_STORAGE_WRITE)
+    fs.write("framesCount", frames)
+    fs.write("cameraResolution", np.array(resolution, dtype=np.int32))
+    fs.write("cameraMatrix", K)
+    fs.write("dist_coeffs", DIST)
+    fs.release()
+
+
+def test_no_file_means_no_undistortion(calib_dir):
+    assert load_undistorter("overhead_not_calibrated") is None
+
+
+def test_interactive_calibration_file(calib_dir):
+    _write_interactive(calib_dir / "overhead.xml")
+    undistort = load_undistorter("overhead")
+    assert undistort is not None
+    frame = np.random.default_rng(0).integers(0, 255, (480, 640, 3), dtype=np.uint8)
+    out = undistort(frame)
+    assert out.shape == frame.shape
+    assert out.dtype == frame.dtype
+    assert not np.array_equal(out, frame)
+
+
+def test_calibrate_camera_style_file(calib_dir):
+    fs = cv2.FileStorage(str(calib_dir / "wrist.yaml"), cv2.FILE_STORAGE_WRITE)
+    fs.write("image_width", 640)
+    fs.write("image_height", 480)
+    fs.write("camera_matrix", K)
+    fs.write("dist_coeffs", DIST)
+    fs.release()
+    undistort = load_undistorter("wrist")
+    assert undistort is not None
+    # scaled frame of the same aspect ratio is accepted
+    assert undistort(np.zeros((240, 320, 3), np.uint8)).shape == (240, 320, 3)
+
+
+def test_rejects_calibration_from_too_few_frames(calib_dir):
+    _write_interactive(calib_dir / "overhead.xml", frames=2)
+    assert load_undistorter("overhead") is None
+
+
+def test_rejects_other_aspect_ratio(calib_dir):
+    _write_interactive(calib_dir / "overhead.xml")
+    undistort = load_undistorter("overhead")
+    with pytest.raises(ValueError, match="aspect ratio"):
+        undistort(np.zeros((720, 1280, 3), np.uint8))
diff --git a/application/backend/tests/unit/test_camera_crop.py b/application/backend/tests/unit/test_camera_crop.py
new file mode 100644
index 00000000..1312c310
--- /dev/null
+++ b/application/backend/tests/unit/test_camera_crop.py
@@ -0,0 +1,118 @@
+"""Camera crop / digital zoom (junction-2026 patch)."""
+
+import cv2
+import numpy as np
+import pytest
+from pydantic import ValidationError
+
+from schemas.project_camera import CameraAdapter, CameraCrop
+from utils.camera_crop import crop_box, crop_frame, output_size
+from utils.camera_factory import build_camera_config
+
+
+def _quadrants(width: int = 640, height: int = 480) -> np.ndarray:
+    """Four flat colours, one per quadrant, so a crop is identifiable by the colour it keeps."""
+    image = np.zeros((height, width, 3), np.uint8)
+    image[: height // 2, : width // 2] = (255, 0, 0)
+    image[: height // 2, width // 2 :] = (0, 255, 0)
+    image[height // 2 :, : width // 2] = (0, 0, 255)
+    image[height // 2 :, width // 2 :] = (255, 255, 0)
+    return image
+
+
+class TestCropSchema:
+    def test_a_region_inside_the_frame_is_accepted(self) -> None:
+        crop = CameraCrop(x=0.25, y=0.25, width=0.5, height=0.5)
+        assert crop.x + crop.width == 0.75
+
+    @pytest.mark.parametrize(
+        "region",
+        [
+            {"x": 0.6, "y": 0.0, "width": 0.5, "height": 0.5},  # past the right edge
+            {"x": 0.0, "y": 0.7, "width": 0.5, "height": 0.4},  # past the bottom
+            {"x": 0.0, "y": 0.0, "width": 0.05, "height": 0.05},  # too small to be useful
+            {"x": -0.1, "y": 0.0, "width": 0.5, "height": 0.5},
+            {"x": 0.0, "y": 0.0, "width": 0.5, "height": 0.5, "angle": 3},  # unknown field
+        ],
+    )
+    def test_invalid_regions_are_rejected(self, region: dict) -> None:
+        with pytest.raises(ValidationError):
+            CameraCrop(**region)
+
+    def test_a_camera_without_crop_still_validates(self) -> None:
+        camera = CameraAdapter.validate_python(
+            {
+                "name": "front",
+                "driver": "realsense",
+                "fingerprint": {"serial": "1"},
+                "hardware_name": "D415",
+                "payload": {"width": 640, "height": 480, "fps": 30},
+            }
+        )
+        assert camera.payload.crop is None
+
+    def test_crop_never_reaches_the_camera_driver(self) -> None:
+        camera = CameraAdapter.validate_python(
+            {
+                "name": "overhead",
+                "driver": "realsense",
+                "fingerprint": {"serial": "243722063473"},
+                "hardware_name": "D415",
+                "payload": {
+                    "width": 640,
+                    "height": 480,
+                    "fps": 30,
+                    "crop": {"x": 0.1, "y": 0.1, "width": 0.5, "height": 0.5},
+                },
+            }
+        )
+        assert camera.payload.crop is not None
+        assert "crop" not in build_camera_config(camera).init_args
+
+
+class TestCropFrame:
+    def test_no_crop_keeps_a_frame_of_the_right_size_untouched(self) -> None:
+        image = _quadrants()
+        assert crop_frame(image, None, (640, 480)) is image
+
+    def test_no_crop_resizes_a_frame_of_another_size(self) -> None:
+        assert crop_frame(_quadrants(1280, 960), None, (640, 480)).shape == (480, 640, 3)
+
+    def test_crop_keeps_the_region_and_zooms_it_to_the_output_size(self) -> None:
+        out = crop_frame(_quadrants(), CameraCrop(x=0.5, y=0.0, width=0.5, height=0.5), (640, 480))
+        assert out.shape == (480, 640, 3)
+        assert (out == (0, 255, 0)).all()  # only the top-right quadrant is left
+
+    def test_depth_uses_nearest_so_no_reading_is_invented(self) -> None:
+        depth = np.zeros((480, 640, 3), np.uint8)
+        depth[:, 320:] = 200
+        out = crop_frame(depth, CameraCrop(x=0.25, y=0.25, width=0.5, height=0.5), (640, 480), cv2.INTER_NEAREST)
+        assert set(np.unique(out)) == {0, 200}
+
+    def test_colour_and_depth_get_the_same_region(self) -> None:
+        crop = CameraCrop(x=0.1, y=0.2, width=0.4, height=0.4)
+        assert crop_box(crop, 640, 480) == (64, 96, 320, 288)
+        colour = crop_frame(_quadrants(), crop, (640, 480))
+        depth = crop_frame(_quadrants(), crop, (640, 480), cv2.INTER_NEAREST)
+        assert colour.shape == depth.shape
+
+
+class TestOutputSize:
+    def test_no_crop_keeps_the_configured_size(self) -> None:
+        assert output_size(640, 480, None) == (640, 480)
+
+    def test_same_ratio_crop_keeps_the_configured_size(self) -> None:
+        assert output_size(640, 480, CameraCrop(x=0.25, y=0.25, width=0.5, height=0.5)) == (640, 480)
+
+    def test_wide_crop_keeps_its_ratio_within_the_configured_width(self) -> None:
+        # 0.8 x 640 = 512 px wide, 0.4 x 480 = 192 px high -> 8:3 -> 640x240
+        assert output_size(640, 480, CameraCrop(x=0.1, y=0.3, width=0.8, height=0.4)) == (640, 240)
+
+    def test_tall_crop_keeps_its_ratio_within_the_configured_height(self) -> None:
+        # 0.3 x 640 = 192 px wide, 0.9 x 480 = 432 px high -> 480 high, 213.3 -> 214 wide (even)
+        assert output_size(640, 480, CameraCrop(x=0.1, y=0.05, width=0.3, height=0.9)) == (214, 480)
+
+    def test_cropped_frame_is_not_stretched(self) -> None:
+        crop = CameraCrop(x=0.1, y=0.3, width=0.8, height=0.4)
+        out = crop_frame(_quadrants(), crop, output_size(640, 480, crop))
+        assert out.shape == (240, 640, 3)
