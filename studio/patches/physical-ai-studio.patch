+"""Snapshots imported while a Modal run trains (junction-2026 patch)."""
+
+import asyncio
+from dataclasses import dataclass
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+from uuid import uuid4
+
+import pytest
+
+from schemas import Model
+from services.training_backends.modal import ModalTrainingBackend
+from services.training_snapshots import build_live_snapshot_model, materialize_snapshot_models
+from training.job import CHECKPOINT_NAME, SNAPSHOTS_DIRNAME
+
+
+def _model(path: Path) -> Model:
+    return Model(
+        id=uuid4(), name="act-run", path=str(path), policy="act", properties={},
+        project_id=uuid4(), dataset_id=uuid4(), snapshot_id=uuid4(), train_job_id=uuid4(),
