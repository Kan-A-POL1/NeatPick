+def test_modal_poll_hands_each_published_snapshot_over_once() -> None:
+    prefix = "jobs/x"
+    volume = _Volume({f"{prefix}/snapshots/step-002500.ckpt": b"a", f"{prefix}/snapshots/.step-005000.ckpt.partial": b"b"})
+    seen: list[tuple[int, bytes]] = []
+
+    async def on_snapshot(step: int, checkpoint: Path) -> None:
+        seen.append((step, checkpoint.read_bytes()))
+
+    context = _context(on_snapshot)
+    backend = ModalTrainingBackend.__new__(ModalTrainingBackend)
+    asyncio.run(backend._sync_snapshots(context, volume, prefix))
+    asyncio.run(backend._sync_snapshots(context, volume, prefix))
+    assert seen == [(2500, b"a")]
