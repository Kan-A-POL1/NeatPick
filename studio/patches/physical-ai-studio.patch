+"""Correction take-over (junction-2026): hold control, leader alignment gate, take-over timeout."""
+
+import time
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from runtime_session.controls.hold import HoldControl
+from runtime_session.controls.teleop import NotAlignedError, TeleopControl, joint_spans, misalignment
+from runtime_session.store import ACTION, LEADER, STATE
+from schemas.runtime_session import HoldControlConfig, TeleopControlConfig
+
+JOINTS = ("shoulder_pan.pos", "shoulder_lift.pos", "elbow_flex.pos", "wrist_flex.pos", "wrist_roll.pos", "gripper.pos")
+
+
+class FakeStore:
+    def __init__(self) -> None:
+        self.spec = SimpleNamespace(joint_names=JOINTS)
+        self.samples: dict[str, SimpleNamespace] = {}
+
+    def write(self, key, values, *, timestamp):
+        self.samples[key] = SimpleNamespace(value=np.array(values, float), timestamp=timestamp)
+
+    def read(self, key):
+        return self.samples.get(key)
+
+
+class FakeLeader:
+    joint_names = [name.removesuffix(".pos") for name in JOINTS]
+
+    def __init__(self, positions) -> None:
+        self.positions = np.array(positions, float)
+
+    def get_observation(self):
+        return SimpleNamespace(joint_positions=self.positions, timestamp=time.monotonic())
+
+
+FOLLOWER = [10.0, -20.0, 30.0, 0.0, 5.0, 40.0]
+
+
+def _store() -> FakeStore:
+    store = FakeStore()
+    store.write(STATE, FOLLOWER, timestamp=time.monotonic())
+    return store
+
+
+def _teleop(store, leader, **config) -> TeleopControl:
+    control = TeleopControl.__new__(TeleopControl)
+    control.store = store
+    control.leader = leader
+    control.teleop_config = TeleopControlConfig(**config)
+    control.grace_s = control.teleop_config.grace_s
+    control.hz = control.teleop_config.hz
+    control._held = None
+    control.started_at = 0.0
+    return control
+
+
+def test_spans_follow_the_calibrated_units() -> None:
+    assert list(joint_spans(JOINTS)) == [200, 200, 200, 200, 200, 100]
+    assert misalignment([20, -20, 30, 0, 5, 45], FOLLOWER, joint_spans(JOINTS))[0] == pytest.approx(0.05)
+
+
+def test_hold_resends_the_starting_pose_and_publishes_the_leader() -> None:
+    store = _store()
+    hold = HoldControl(store, HoldControlConfig(), FakeLeader([0, 0, 0, 0, 0, 0]))
+    hold.on_start()
+    store.write(STATE, [99] * 6, timestamp=time.monotonic())  # the arm drifts: the hold keeps the original pose
+    hold.on_tick()
+    assert list(store.read(ACTION).value) == FOLLOWER
+    assert store.read(ACTION).timestamp == pytest.approx(time.monotonic(), abs=0.5)
+    assert list(store.read(LEADER).value) == [0] * 6
+
+
+def test_hold_refuses_without_a_known_follower_position() -> None:
+    with pytest.raises(ValueError):
+        HoldControl(FakeStore(), HoldControlConfig()).on_start()
+
+
+def test_take_over_is_refused_when_the_leader_is_far() -> None:
+    leader = FakeLeader([10, -20, 30, 0, 5, 80])  # gripper 40 % of its range away
+    with pytest.raises(NotAlignedError, match="gripper"):
+        _teleop(_store(), leader, require_alignment=True, alignment_hold_s=0.1).on_start()
+
+
+def test_take_over_is_allowed_when_aligned_for_the_whole_hold_time() -> None:
+    control = _teleop(_store(), FakeLeader([11, -21, 31, 1, 4, 41]), require_alignment=True, alignment_hold_s=0.1)
+    control.on_start()
+    assert control.started_at > 0
+
+
+def test_alignment_is_not_checked_for_plain_teleop() -> None:
+    control = _teleop(_store(), FakeLeader([90] * 6))
+    control.on_start()  # recording teleop keeps its grace-period glide, no gate
+
+
+def test_take_over_ends_in_a_hold_after_max_duration() -> None:
+    store = _store()
+    control = _teleop(store, FakeLeader([50] * 6), max_duration_s=1.0)
+    control.started_at = time.monotonic() - 5
+    control.on_tick()
+    assert list(store.read(ACTION).value) == FOLLOWER  # held where the follower is, not following the leader
