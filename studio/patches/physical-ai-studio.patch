@@ -0,0 +1,92 @@
+"""junction-2026: model benchmarks (timed trials marked success or fail), and the follower poses a trial returns to."""
+
+import asyncio
+from uuid import UUID
+
+from fastapi import APIRouter, HTTPException, status
+from fastapi.responses import Response
+
+from api.dependencies import ModelServiceDep, RobotServiceDep
+from services.arm_poses import get_arm_poses
+from services.benchmarks import (
+    Benchmark,
+    BenchmarkCreate,
+    BenchmarkWithStats,
+    benchmark_csv,
+    get_benchmarks,
+    with_stats,
+)
+
+router = APIRouter(prefix="/api/projects/{project_id}/benchmarks", tags=["Benchmarks"])
+
+
+def _benchmark(project_id: UUID, benchmark_id: UUID) -> Benchmark:
+    try:
+        benchmark = get_benchmarks().get(benchmark_id)
+    except KeyError:
+        benchmark = None
+    if benchmark is None or benchmark.project_id != project_id:
+        raise HTTPException(status.HTTP_404_NOT_FOUND, f"No benchmark {benchmark_id}")
+    return benchmark
+
+
+@router.get("")
+async def list_benchmarks(project_id: UUID, model_id: UUID | None = None) -> list[BenchmarkWithStats]:
+    """The project's benchmarks, of one model if ``model_id`` is given, newest first, with their statistics."""
+    benchmarks = await asyncio.to_thread(get_benchmarks().list, project_id, model_id)
+    return [with_stats(benchmark) for benchmark in benchmarks]
+
+
+@router.post("", status_code=status.HTTP_201_CREATED)
+async def create_benchmark(project_id: UUID, body: BenchmarkCreate, models: ModelServiceDep) -> BenchmarkWithStats:
+    """Start a series of trials of one model of the project."""
+    model = await models.get_model_by_id(body.model_id)
+    if model.project_id != project_id:
+        raise HTTPException(status.HTTP_404_NOT_FOUND, f"No model {body.model_id} in this project")
+    benchmark = await asyncio.to_thread(get_benchmarks().create, project_id, model.name, body)
+    return with_stats(benchmark)
+
+
+@router.get("/poses/{robot_id}")
+async def get_poses(project_id: UUID, robot_id: UUID, robots: RobotServiceDep) -> dict[str, dict[str, float]]:
+    """The project's follower's saved poses (``home`` is where a trial returns), as the Hackathon page keeps them."""
+    await robots.get_robot_by_id(project_id, robot_id)  # 404 unless the robot is this project's
+    return await asyncio.to_thread(get_arm_poses().poses, robot_id)
+
+
+@router.get("/{benchmark_id}")
+async def get_benchmark(project_id: UUID, benchmark_id: UUID) -> BenchmarkWithStats:
+    """One benchmark, its trials and its statistics."""
+    return with_stats(await asyncio.to_thread(_benchmark, project_id, benchmark_id))
+
+
+@router.delete("/{benchmark_id}/trials/last")
+async def remove_last_trial(project_id: UUID, benchmark_id: UUID) -> BenchmarkWithStats:
+    """Undo the last mark (a mis-click)."""
+    await asyncio.to_thread(_benchmark, project_id, benchmark_id)
+    try:
+        benchmark = await asyncio.to_thread(get_benchmarks().remove_last_trial, benchmark_id)
+    except ValueError as error:
+        raise HTTPException(status.HTTP_409_CONFLICT, str(error)) from error
+    return with_stats(benchmark)
+
+
+@router.delete("/{benchmark_id}", status_code=status.HTTP_204_NO_CONTENT)
+async def delete_benchmark(project_id: UUID, benchmark_id: UUID) -> None:
+    """Forget a benchmark and its trials."""
+    await asyncio.to_thread(_benchmark, project_id, benchmark_id)
+    await asyncio.to_thread(get_benchmarks().delete, benchmark_id)
+
+
+@router.get("/{benchmark_id}/csv", response_class=Response)
+async def export_benchmark_csv(project_id: UUID, benchmark_id: UUID) -> Response:
+    """One row per trial: index, outcome, elapsed seconds, timed out, start and mark times."""
+    benchmark = await asyncio.to_thread(_benchmark, project_id, benchmark_id)
+    label = f"{benchmark.name}-{benchmark.model_name}"
+    # ASCII only: the header is latin-1, and a quote would end the file name.
+    safe = "".join(char if char.isascii() and (char.isalnum() or char in "-_.") else "-" for char in label)
+    return Response(
+        benchmark_csv(benchmark),
+        media_type="text/csv",
+        headers={"Content-Disposition": f'attachment; filename="{safe.strip("-") or "benchmark"}.csv"'},
+    )
