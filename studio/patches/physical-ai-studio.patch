+def _loss_target_stop(train_target: float | None, val_target: float | None) -> Any:
+    """Lightning callback ending the run once the epoch's losses reach every target that is set (junction-2026).
+
+    The train loss is averaged over the epoch's steps (one step is too noisy to stop on); the validation loss is the
+    epoch's ``val/loss``. An epoch without a validation loss never satisfies a validation target.
+    """
+    from lightning.pytorch.callbacks import Callback
+
+    class LossTargetStop(Callback):
+        def __init__(self) -> None:
+            self._sum = 0.0
+            self._count = 0
+
+        def on_train_epoch_start(self, trainer: Any, pl_module: Any) -> None:
+            self._sum, self._count = 0.0, 0
+
+        def on_train_batch_end(self, trainer: Any, pl_module: Any, outputs: Any, batch: Any, batch_idx: int) -> None:
+            value = trainer.callback_metrics.get("train/loss")
+            if value is not None:
+                self._sum += float(value)
+                self._count += 1
+
+        def on_train_epoch_end(self, trainer: Any, pl_module: Any) -> None:
+            train = self._sum / self._count if self._count else None
+            val_value = trainer.callback_metrics.get("val/loss")
+            val = float(val_value) if val_value is not None else None
+            if train_target is not None and (train is None or train > train_target):
+                return
+            if val_target is not None and (val is None or val > val_target):
+                return
+            logger.info(
+                "Loss targets reached at epoch %d (train %s <= %s, val %s <= %s): stopping",
+                trainer.current_epoch, train, train_target, val, val_target,
+            )
+            trainer.should_stop = True
+
+    return LossTargetStop()
