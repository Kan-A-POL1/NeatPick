diff --git a/application/ui/src/features/datasets/copy-dataset-dialog.tsx b/application/ui/src/features/datasets/copy-dataset-dialog.tsx
new file mode 100644
index 00000000..7c099d7a
--- /dev/null
+++ b/application/ui/src/features/datasets/copy-dataset-dialog.tsx
@@ -0,0 +1,181 @@
+import { useState } from 'react';
+
+import {
+    Button,
+    ButtonGroup,
+    Checkbox,
+    CheckboxGroup,
+    Content,
+    Dialog,
+    Divider,
+    Flex,
+    Heading,
+    Loading,
+    Text,
+    TextField,
+    toast,
+} from '@geti-ui/ui';
+import { useNavigate } from 'react-router';
+
+import { $api, fetchClient } from '../../api/client';
+import { getApiErrorMessage } from '../../api/errors';
+import { SchemaDatasetContents, SchemaDatasetOutput } from '../../api/openapi-spec';
+import { paths } from '../../paths';
+import { DatasetContentsLine, tagLabel, telemetryQuantities, useDatasetContents } from './dataset-contents';
+
+type Dataset = SchemaDatasetOutput;
+
+const CopyDatasetForm = ({
+    dataset,
+    contents,
+    onDone,
+}: {
+    dataset: Dataset;
+    contents: SchemaDatasetContents;
+    onDone: () => void;
+}) => {
+    const navigate = useNavigate();
+    const allTags = Object.keys(contents.tags);
+    const [name, setName] = useState(`${dataset.name} copy`);
+    const [cameras, setCameras] = useState(contents.cameras);
+    const [telemetry, setTelemetry] = useState(true);
+    const [tags, setTags] = useState(allTags);
+    const copy = $api.useMutation('post', '/api/dataset/{dataset_id}/copy', {
+        meta: {
+            invalidates: [
+                ['get', '/api/projects/{project_id}', { params: { path: { project_id: dataset.project_id } } }],
+                ['get', '/api/projects'],
+            ],
+        },
+    });
+
+    const keptEpisodes = tags.reduce((sum, tag) => sum + (contents.tags[tag] ?? 0), 0);
+    const isDisabled = name.trim() === '' || keptEpisodes === 0 || copy.isPending;
+
+    const submit = async (download: boolean) => {
+        try {
+            const created = await copy.mutateAsync({
+                params: { path: { dataset_id: dataset.id! } },
+                body: {
+                    name: name.trim(),
+                    cameras: cameras.length === contents.cameras.length ? null : cameras,
+                    telemetry,
+                    tags: tags.length === allTags.length ? null : tags,
+                },
+            });
+            if (download) {
+                // An attachment downloads without leaving the page.
+                window.location.assign(
+                    fetchClient.PATH('/api/dataset/{dataset_id}/download', {
+                        params: { path: { dataset_id: created.id! } },
+                    })
+                );
+            }
+            onDone();
+            navigate(paths.project.datasets.show({ project_id: dataset.project_id, dataset_id: created.id! }));
+        } catch (error) {
+            toast.negative(getApiErrorMessage(error) ?? 'Could not copy the dataset.');
+        }
+    };
+
+    return (
+        <Dialog width='size-6000'>
+            <Heading>Duplicate dataset</Heading>
+            <Divider />
+            <Content>
+                <Flex direction='column' gap='size-200'>
+                    <DatasetContentsLine contents={contents} />
+                    <TextField
+                        // eslint-disable-next-line jsx-a11y/no-autofocus
+                        autoFocus
+                        isRequired
+                        width='100%'
+                        label='New dataset name'
+                        value={name}
+                        onChange={setName}
+                    />
+                    <CheckboxGroup
+                        label='Cameras to keep'
+                        orientation='horizontal'
+                        value={cameras}
+                        onChange={setCameras}
+                    >
+                        {contents.cameras.map((camera) => (
+                            <Checkbox key={camera} value={camera}>
+                                {camera}
+                            </Checkbox>
+                        ))}
+                    </CheckboxGroup>
+                    {contents.telemetry.length > 0 && (
+                        <Checkbox isSelected={telemetry} onChange={setTelemetry}>
+                            {`Keep telemetry (${telemetryQuantities(contents.telemetry).join(', ')})`}
+                        </Checkbox>
+                    )}
+                    {allTags.some((tag) => tag !== '') && (
+                        <CheckboxGroup
+                            label='Episodes to keep, by tag'
+                            orientation='horizontal'
+                            value={tags}
+                            onChange={setTags}
+                        >
+                            {allTags.map((tag) => (
+                                <Checkbox key={tag} value={tag}>
+                                    {`${tagLabel(tag)} (${contents.tags[tag]})`}
+                                </Checkbox>
+                            ))}
+                        </CheckboxGroup>
+                    )}
+                    <Text>
+                        {`Keeps ${keptEpisodes} of ${contents.episodes} episodes.`}
+                        {keptEpisodes < contents.episodes &&
+                            ' Dropping episodes re-encodes the videos: it takes a while.'}
+                    </Text>
+                </Flex>
+            </Content>
+            <ButtonGroup>
+                <Button variant='secondary' onPress={onDone} isDisabled={copy.isPending}>
+                    Cancel
+                </Button>
+                <Button variant='secondary' onPress={() => void submit(true)} isDisabled={isDisabled}>
+                    Duplicate & download
+                </Button>
+                <Button
+                    variant='accent'
+                    onPress={() => void submit(false)}
+                    isDisabled={isDisabled}
+                    isPending={copy.isPending}
+                >
+                    Duplicate
+                </Button>
+            </ButtonGroup>
+        </Dialog>
+    );
+};
+
+/** Copy a dataset, keeping only some cameras, tagged episodes, or no telemetry: a smaller one to train on or export. */
+export const CopyDatasetDialog = ({ dataset, onDone }: { dataset: Dataset; onDone: () => void }) => {
+    // Fresh, so the form starts from what is on disk now.
+    const { data: contents, isFetching } = useDatasetContents(dataset.id, 'always');
+
+    if (contents === undefined || isFetching) {
+        return (
+            <Dialog width='size-6000'>
+                <Heading>Duplicate dataset</Heading>
+                <Content>
+                    <Loading />
+                </Content>
+            </Dialog>
+        );
+    }
+    if (contents.episodes === 0) {
+        return (
+            <Dialog width='size-6000' isDismissable onDismiss={onDone}>
+                <Heading>Duplicate dataset</Heading>
+                <Content>
+                    <Text>The dataset has no episodes yet.</Text>
+                </Content>
+            </Dialog>
+        );
+    }
+    return <CopyDatasetForm dataset={dataset} contents={contents} onDone={onDone} />;
+};
