index 00000000..c8940990
--- /dev/null
+++ b/application/ui/src/features/models/models-table/model-groups.ts
@@ -0,0 +1,89 @@
+import { SchemaModel } from '../../../api/openapi-spec';
+
+/** junction-2026: models grouped by dataset, with snapshots and fine-tuned versions nested under their model. */
+
+const STEP_SUFFIX = /^(.*)-step(\d+)$/;
+
+export interface ModelFamily {
+    /** The model shown in the row: the final model, or the newest snapshot while a run still trains. */
+    root: SchemaModel;
+    /** Other loadable versions of the same model (snapshots, fine-tuned versions), newest first. */
+    versions: SchemaModel[];
+    /** No final model yet: the run is still producing snapshots. */
+    isInProgress: boolean;
+}
+
+export interface DatasetGroup {
+    datasetId: string | null;
+    families: ModelFamily[];
+    newest: number;
+}
+
+const createdAt = (model: SchemaModel) => (model.created_at ? new Date(model.created_at).getTime() : 0);
+
+export const snapshotStep = (model: SchemaModel): number | null => {
+    const match = STEP_SUFFIX.exec(model.name);
+    return match ? Number(match[2]) : null;
+};
+
+const byNewest = (a: SchemaModel, b: SchemaModel) => {
+    const stepA = snapshotStep(a);
+    const stepB = snapshotStep(b);
+    if (stepA !== null && stepB !== null && stepA !== stepB) {
+        return stepB - stepA;
+    }
+    return createdAt(b) - createdAt(a);
+};
+
+/** Fine-tuned versions point at the model they came from; follow the chain to the family's original model. */
+const lineageRoot = (model: SchemaModel, byId: Map<string, SchemaModel>): SchemaModel => {
+    let current = model;
+    const seen = new Set<string>();
+    while (current.parent_model_id && byId.has(current.parent_model_id) && !seen.has(current.id!)) {
+        seen.add(current.id!);
+        current = byId.get(current.parent_model_id)!;
+    }
+    return current;
+};
+
+const familyKey = (model: SchemaModel, byId: Map<string, SchemaModel>) => {
+    // Snapshots share their run's training job; fine-tuned versions share the lineage of their original model.
+    if (snapshotStep(model) !== null && model.train_job_id) {
+        return `job:${model.train_job_id}`;
+    }
+    const root = lineageRoot(model, byId);
+    return root.train_job_id ? `job:${root.train_job_id}` : `model:${root.id}`;
+};
+
+export const groupModels = (models: SchemaModel[]): DatasetGroup[] => {
+    const byId = new Map(models.map((model) => [model.id!, model]));
+    const families = new Map<string, SchemaModel[]>();
+    for (const model of models) {
+        const key = familyKey(model, byId);
+        families.set(key, [...(families.get(key) ?? []), model]);
+    }
+
+    const groups = new Map<string, DatasetGroup>();
+    for (const members of families.values()) {
+        const finals = members.filter((model) => snapshotStep(model) === null).sort(byNewest);
+        const root = finals[0] ?? [...members].sort(byNewest)[0];
+        const family: ModelFamily = {
+            root,
+            versions: members.filter((model) => model.id !== root.id).sort(byNewest),
+            isInProgress: finals.length === 0,
+        };
+        const datasetKey = root.dataset_id ?? 'none';
+        const group = groups.get(datasetKey) ?? { datasetId: root.dataset_id ?? null, families: [], newest: 0 };
+        group.families.push(family);
+        group.newest = Math.max(group.newest, ...members.map(createdAt));
+        groups.set(datasetKey, group);
+    }
+
+    for (const group of groups.values()) {
+        // Favorites first (a starred version stars its family), then the family trained most recently.
+        const isFavorite = (family: ModelFamily) => [family.root, ...family.versions].some((model) => model.favorite);
+        const newest = (family: ModelFamily) => Math.max(...[family.root, ...family.versions].map(createdAt));
+        group.families.sort((a, b) => Number(isFavorite(b)) - Number(isFavorite(a)) || newest(b) - newest(a));
+    }
+    return [...groups.values()].sort((a, b) => b.newest - a.newest);
+};
