index 00000000..740d0e0f
--- /dev/null
+++ b/application/backend/src/services/arm_poses.py
@@ -0,0 +1,72 @@
+"""junction-2026: the follower's saved poses (``home`` for benchmark trials), and how to move to one smoothly.
+
+The file is the one the Hackathon page keeps its poses in (``<storage>/hackathon/poses.json``,
+``{follower robot id: {pose name: {joint name: value}}}``), so a pose saved on either side is seen by the other.
+Writes replace the file atomically.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+from functools import cache
+from typing import TYPE_CHECKING, Any
+
+import numpy as np
+
+from settings import get_settings
+
+if TYPE_CHECKING:
+    from pathlib import Path
+    from uuid import UUID
+
+MOVE_SPEED = 40.0
+"""Units per second on the joint that moves most (joints span -100..100, the gripper 0..100)."""
+MOVE_MIN_S, MOVE_MAX_S = 1.0, 5.0
+
+
+def move_profile(start: np.ndarray, target: np.ndarray, hz: float) -> list[np.ndarray]:
+    """Waypoints from ``start`` to ``target`` at ``hz``, eased in and out, the busiest joint at about MOVE_SPEED."""
+    duration = float(np.clip(np.max(np.abs(target - start)) / MOVE_SPEED, MOVE_MIN_S, MOVE_MAX_S))
+    steps = max(1, round(duration * hz))
+    waypoints = []
+    for step in range(1, steps + 1):
+        s = step / steps
+        s = s * s * (3 - 2 * s)  # smoothstep: no jerk at either end
+        waypoints.append(start + (target - start) * s)
+    return waypoints
+
+
+class ArmPoses:
+    def __init__(self, poses_file: Path) -> None:
+        self.poses_file = poses_file
+        self._lock = threading.Lock()
+
+    def _read_all(self) -> dict[str, Any]:
+        try:
+            return json.loads(self.poses_file.read_text())
+        except FileNotFoundError:
+            return {}
+
+    def poses(self, robot_id: UUID) -> dict[str, dict[str, float]]:
+        """The follower's poses by name."""
+        with self._lock:
+            return self._read_all().get(str(robot_id), {})
+
+    def save(self, robot_id: UUID, name: str, joints: dict[str, float]) -> dict[str, float]:
+        """Save ``joints`` as the pose ``name`` of the follower, replacing a pose of that name."""
+        pose = {joint: round(float(value), 3) for joint, value in joints.items()}
+        with self._lock:
+            poses = self._read_all()
+            poses.setdefault(str(robot_id), {})[name] = pose
+            self.poses_file.parent.mkdir(parents=True, exist_ok=True)
+            tmp = self.poses_file.with_suffix(".benchmark.tmp")
+            tmp.write_text(json.dumps(poses, indent=2))
+            tmp.replace(self.poses_file)
+        return pose
+
+
+@cache
+def get_arm_poses() -> ArmPoses:
+    """The one pose store of this backend."""
+    return ArmPoses(get_settings().storage_dir / "hackathon" / "poses.json")
diff --git a/application/backend/src/services/benchmarks.py b/application/backend/src/services/benchmarks.py
new file mode 100644
index 00000000..bed266bb
--- /dev/null
+++ b/application/backend/src/services/benchmarks.py
@@ -0,0 +1,262 @@
+"""junction-2026: model benchmarks, as series of timed trials a human marks success or fail.
+
+A benchmark is one model on one task ("pick the blue brick"), ``target_trials`` trials of ``duration_s`` each. The
+trial control (``runtime_session/controls/trial.py``) appends each trial when it is marked; this module stores the
+series as one JSON file per benchmark under ``<storage>/benchmarks`` and computes its statistics.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import math
+import statistics
+import threading
+from datetime import UTC, datetime
+from functools import cache
+from typing import TYPE_CHECKING, Annotated, Literal
+from uuid import UUID, uuid4
+
+from pydantic import BaseModel, Field, StringConstraints, ValidationError
+
+from schemas.base import UTCDatetime
+from settings import get_settings
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+TrialOutcome = Literal["success", "fail", "aborted"]
+
+_Z95 = 1.959963984540054
+"""The normal quantile of a two-sided 95 % interval."""
+
+
+class BenchmarkCreate(BaseModel):
+    name: Annotated[str, StringConstraints(strip_whitespace=True, min_length=1, max_length=120)]
+    """What is measured, e.g. "blue brick pick-up"."""
+    model_id: UUID
+    duration_s: float = Field(10, gt=0, le=300)
+    target_trials: int = Field(100, ge=1, le=1000)
+
+
+class BenchmarkTrial(BaseModel):
+    index: int
+    """1-based, in the order the trials were run."""
+    outcome: TrialOutcome
+    elapsed_s: float
+    """From the model's start to the human's mark, at most the trial's duration."""
+    timed_out: bool
+    """Marked after the time was up: ``elapsed_s`` is the duration, not when the task was done."""
+    started_at: UTCDatetime
+    marked_at: UTCDatetime
+
+
+class BenchmarkStats(BaseModel):
+    trials: int
+    successes: int
+    failures: int
+    aborted: int
+    """Trials that ended unmarked (stopped, taken over, failed); not counted in the success rate."""
+    success_rate: float | None
+    """Successes over marked trials (successes + failures)."""
+    ci_low: float | None
+    ci_high: float | None
+    """The rate's 95 % Wilson score interval."""
+    mean_time_to_success_s: float | None
+    median_time_to_success_s: float | None
+    """Over the successes marked before the time was up."""
+
+
+class Benchmark(BenchmarkCreate):
+    id: UUID
+    project_id: UUID
+    model_name: str
+    created_at: UTCDatetime
+    trials: list[BenchmarkTrial] = Field(default_factory=list)
+
+
+class BenchmarkWithStats(Benchmark):
+    stats: BenchmarkStats
+
+
+def wilson_interval(successes: int, total: int, z: float = _Z95) -> tuple[float, float] | None:
+    """The Wilson score interval of ``successes`` out of ``total``, or ``None`` with no trials."""
+    if total <= 0:
+        return None
+    p = successes / total
+    denominator = 1 + z * z / total
+    center = (p + z * z / (2 * total)) / denominator
+    half = z * math.sqrt(p * (1 - p) / total + z * z / (4 * total * total)) / denominator
+    return max(0.0, center - half), min(1.0, center + half)
+
+
+def marked_trials(benchmark: Benchmark) -> int:
+    """Trials marked success or fail: what counts towards ``target_trials`` (aborted ones are run again)."""
+    return sum(trial.outcome != "aborted" for trial in benchmark.trials)
+
+
+def benchmark_stats(trials: list[BenchmarkTrial]) -> BenchmarkStats:
+    """Counts, the success rate over marked trials with its Wilson interval, and the time to success."""
+    successes = sum(trial.outcome == "success" for trial in trials)
+    failures = sum(trial.outcome == "fail" for trial in trials)
+    marked = successes + failures
+    interval = wilson_interval(successes, marked)
+    times = [trial.elapsed_s for trial in trials if trial.outcome == "success" and not trial.timed_out]
+    return BenchmarkStats(
+        trials=len(trials),
+        successes=successes,
+        failures=failures,
+        aborted=len(trials) - marked,
+        success_rate=successes / marked if marked else None,
+        ci_low=interval[0] if interval else None,
+        ci_high=interval[1] if interval else None,
+        mean_time_to_success_s=statistics.fmean(times) if times else None,
+        median_time_to_success_s=statistics.median(times) if times else None,
+    )
+
+
+def with_stats(benchmark: Benchmark) -> BenchmarkWithStats:
+    """``benchmark`` as the API returns it, with its statistics."""
+    return BenchmarkWithStats(**benchmark.model_dump(), stats=benchmark_stats(benchmark.trials))
+
+
+CSV_COLUMNS = ("trial", "outcome", "elapsed_s", "timed_out", "started_at", "marked_at")
+
+
+def benchmark_csv(benchmark: Benchmark) -> str:
+    """One row per trial, under a ``CSV_COLUMNS`` header."""
+    out = io.StringIO()
+    writer = csv.writer(out)
+    writer.writerow(CSV_COLUMNS)
+    for trial in benchmark.trials:
+        writer.writerow(
+            (
+                trial.index,
+                trial.outcome,
+                f"{trial.elapsed_s:.3f}",
+                int(trial.timed_out),
+                trial.started_at.isoformat(),
+                trial.marked_at.isoformat(),
+            )
+        )
+    return out.getvalue()
+
+
+class BenchmarkStore:
+    """One JSON file per benchmark. Thread-safe: trials are appended from a control's thread."""
+
+    def __init__(self, directory: Path) -> None:
+        self.directory = directory
+        self._lock = threading.Lock()
+
+    def _path(self, benchmark_id: UUID) -> Path:
+        return self.directory / f"{benchmark_id}.json"
+
+    def _read(self, path: Path) -> Benchmark:
+        return Benchmark.model_validate_json(path.read_text())
+
+    def _write(self, benchmark: Benchmark) -> None:
+        self.directory.mkdir(parents=True, exist_ok=True)
+        path = self._path(benchmark.id)
+        tmp = path.with_suffix(".tmp")
+        tmp.write_text(benchmark.model_dump_json(indent=2))
+        tmp.replace(path)
+
+    def create(self, project_id: UUID, model_name: str, body: BenchmarkCreate) -> Benchmark:
+        benchmark = Benchmark(
+            **body.model_dump(),
+            id=uuid4(),
+            project_id=project_id,
+            model_name=model_name,
+            created_at=datetime.now(UTC),
+        )
+        with self._lock:
+            self._write(benchmark)
+        return benchmark
+
+    def get(self, benchmark_id: UUID) -> Benchmark:
+        """Raises ``KeyError`` when there is no such benchmark."""
+        path = self._path(benchmark_id)
+        with self._lock:
+            if not path.is_file():
+                raise KeyError(str(benchmark_id))
+            return self._read(path)
+
+    def list(self, project_id: UUID, model_id: UUID | None = None) -> list[Benchmark]:
+        """The project's benchmarks (of ``model_id`` only, if given), newest first. Unreadable files are skipped."""
+        with self._lock:
+            paths = sorted(self.directory.glob("*.json")) if self.directory.is_dir() else []
+            benchmarks = []
+            for path in paths:
+                try:
+                    benchmark = self._read(path)
+                except (OSError, ValueError, ValidationError):
+                    continue
+                if benchmark.project_id == project_id and (model_id is None or benchmark.model_id == model_id):
+                    benchmarks.append(benchmark)
+        return sorted(benchmarks, key=lambda benchmark: benchmark.created_at, reverse=True)
+
+    def add_trial(
+        self,
+        benchmark_id: UUID,
+        *,
+        outcome: TrialOutcome,
+        elapsed_s: float,
+        timed_out: bool,
+        started_at: datetime,
+        marked_at: datetime,
+    ) -> BenchmarkTrial:
+        """Raises ``KeyError`` when there is no such benchmark, ``ValueError`` once its marked trials reach the target.
+
+        The target is checked here, under the lock, so no two marks can both take the last slot. An aborted trial is
+        always recorded: it does not count towards the target.
+        """
+        with self._lock:
+            path = self._path(benchmark_id)
+            if not path.is_file():
+                raise KeyError(str(benchmark_id))
+            benchmark = self._read(path)
+            if outcome != "aborted" and marked_trials(benchmark) >= benchmark.target_trials:
+                raise ValueError(f"Benchmark {benchmark.name!r} is complete ({benchmark.target_trials} trials)")
+            trial = BenchmarkTrial(
+                index=(benchmark.trials[-1].index + 1) if benchmark.trials else 1,
+                outcome=outcome,
+                elapsed_s=round(max(0.0, elapsed_s), 3),
+                timed_out=timed_out,
+                started_at=started_at,
+                marked_at=marked_at,
+            )
+            benchmark.trials.append(trial)
+            self._write(benchmark)
+            return trial
+
+    def remove_last_trial(self, benchmark_id: UUID) -> Benchmark:
+        """Undo a wrong mark: remove the last trial marked success or fail. Aborted trials are history and stay.
+
+        Raises ``KeyError`` when there is no such benchmark, ``ValueError`` with no marked trial.
+        """
+        with self._lock:
+            path = self._path(benchmark_id)
+            if not path.is_file():
+                raise KeyError(str(benchmark_id))
+            benchmark = self._read(path)
+            marked = [index for index, trial in enumerate(benchmark.trials) if trial.outcome != "aborted"]
+            if not marked:
+                raise ValueError("This benchmark has no marked trial to undo")
+            del benchmark.trials[marked[-1]]
+            self._write(benchmark)
+            return benchmark
+
+    def delete(self, benchmark_id: UUID) -> None:
+        """Raises ``KeyError`` when there is no such benchmark."""
+        with self._lock:
+            path = self._path(benchmark_id)
+            if not path.is_file():
+                raise KeyError(str(benchmark_id))
+            path.unlink()
+
+
+@cache
+def get_benchmarks() -> BenchmarkStore:
+    """The one benchmark store of this backend."""
+    return BenchmarkStore(get_settings().storage_dir / "benchmarks")
