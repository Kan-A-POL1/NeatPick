+from internal_datasets.lerobot.lerobot_dataset import InternalLeRobotDataset
+from schemas import EpisodeSegment
+
+FRAMES = 10
+
+
+def markers(**frames: int) -> list[dict]:
+    return [{"label": label.replace("_", " "), "frame": frame} for label, frame in frames.items()]
+
+
+def test_segment_range() -> None:
+    marks = [*markers(tourne=3, bac_valid=7), {"label": "tourne", "frame": 4}]
+    assert segment_range(marks, 10, None, "tourne", False) == (0, 4)  # the last press counts
+    assert segment_range(marks, 10, "tourne", None, True) == (4, 7)  # up to the next marker
+    assert segment_range(marks, 10, "bac valid", None, False) == (7, 10)
+    assert segment_range(marks, 10, "bac default", None, False) is None
+    assert segment_range(markers(tourne=9), 10, "tourne", None, False) is None  # 1 frame: too short
+    assert segment_range([], 10, None, None, True) == (0, 10)
+
+
+@pytest.fixture(scope="module")
+def recorded(tmp_path_factory: pytest.TempPathFactory) -> Path:
+    return record_dataset(tmp_path_factory.mktemp("recorded") / "dataset", ["sort", "sort", "sort"], frames=FRAMES)
+
+
+@pytest.fixture
+def root(recorded: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    monkeypatch.setattr(lerobot_dataset, "get_settings", lambda: SimpleNamespace(cache_dir=tmp_path / "cache"))
+    root = Path(shutil.copytree(recorded, tmp_path / "dataset"))
+    set_markers(root, 0, markers(tourne=3, bac_valid=7))
+    set_markers(root, 1, markers(tourne=4, bac_default=8))
+    set_tag(root, 1, "slow")
+    return root
+
+
+def _frames(dataset: InternalLeRobotDataset, episode_index: int) -> tuple[list[float], list[int]]:
+    """Each frame's recorded frame number (``observation.state``) and image value (``10 * source episode``)."""
+    episode = dataset._find_episode_metadata(episode_index)
+    rows = dataset._dataset.hf_dataset[episode["dataset_from_index"] : episode["dataset_to_index"]]
+    images = dataset._decode_frames(episode, "observation.images.camera", rows["timestamp"])
+    return [float(state[0]) for state in rows["observation.state"]], [int(np.median(image)) for image in images]
+
+
+def test_episodes_show_their_markers_and_the_contents_count_them(root: Path) -> None:
+    dataset = InternalLeRobotDataset(root)
+    assert [[m.label for m in episode.markers] for episode in dataset.get_episode_infos()] == [
+        ["tourne", "bac valid"],
+        ["tourne", "bac default"],
+        [],
+    ]
+    assert dataset.find_episode(1).markers[1].frame == 8
+    assert dataset.get_contents().markers == {"tourne": 2, "bac valid": 1, "bac default": 1}
+
+
+def test_deleting_an_episode_renumbers_the_markers(root: Path, tmp_path: Path) -> None:
+    InternalLeRobotDataset(root).delete_episodes([0], tmp_path / "out")
+    assert read_markers(tmp_path / "out") == {0: markers(tourne=4, bac_default=8)}
+
+
+def test_a_segment_copy_keeps_only_that_part_of_each_episode(root: Path, tmp_path: Path) -> None:
+    source = InternalLeRobotDataset(root)
+
+    source.export(tmp_path / "pick", cameras=None, telemetry=True, tags=None, segment=EpisodeSegment(end="tourne"))
+    pick = InternalLeRobotDataset(tmp_path / "pick")
+    assert [episode.length for episode in pick.get_episode_infos()] == [3, 4]  # episode 2 has no "tourne"
+    assert _frames(pick, 1) == ([0.0, 1.0, 2.0, 3.0], [10, 10, 10, 10])
+    assert [episode.tag for episode in pick.get_episode_infos()] == [None, "slow"]
+
+    source.export(
+        tmp_path / "turn",
+        cameras=None,
+        telemetry=True,
+        tags=None,
+        segment=EpisodeSegment(start="tourne", end_at_next_marker=True),
+    )
+    turn = InternalLeRobotDataset(tmp_path / "turn")
+    assert [episode.length for episode in turn.get_episode_infos()] == [4, 4]
+    assert _frames(turn, 0)[0] == [3.0, 4.0, 5.0, 6.0]
+    assert read_markers(tmp_path / "turn") == {0: markers(tourne=0), 1: markers(tourne=0)}
+
+    source.export(
+        tmp_path / "valid", cameras=None, telemetry=True, tags=None, segment=EpisodeSegment(start="bac valid")
+    )
+    valid = InternalLeRobotDataset(tmp_path / "valid")
+    assert [episode.length for episode in valid.get_episode_infos()] == [3]
+    assert _frames(valid, 0) == ([7.0, 8.0, 9.0], [0, 0, 0])
+
+    with pytest.raises(ValueError, match="No episode has those markers"):
+        source.export(tmp_path / "x", cameras=None, telemetry=True, tags=None, segment=EpisodeSegment(start="nope"))
