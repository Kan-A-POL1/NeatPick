diff --git a/application/ui/src/features/runtime-session/workspace/benchmark-panel.tsx b/application/ui/src/features/runtime-session/workspace/benchmark-panel.tsx
new file mode 100644
index 00000000..2f012e20
--- /dev/null
+++ b/application/ui/src/features/runtime-session/workspace/benchmark-panel.tsx
@@ -0,0 +1,355 @@
+import { useEffect, useState } from 'react';
+
+import { Button, Divider, Flex, Heading, Item, NumberField, Picker, Text, TextField, toast } from '@geti-ui/ui';
+
+import { $api, fetchClient } from '../../../api/client';
+import { SchemaModelControlConfig } from '../../../api/openapi-spec';
+import { useHotkey } from '../../hotkeys/use-hotkey';
+import { useProjectId } from '../../projects/use-project';
+import { ERROR_TOAST, useRuntimeSession } from '../runtime-session-provider';
+import { formatPercent, formatRate, formatSeconds, remainingSeconds } from './benchmark-format';
+
+import classes from './benchmark-panel.module.css';
+
+/**
+ * junction-2026: measure a model. A benchmark is a series of trials of one model on one task ("pick the blue
+ * brick"): the model drives for N seconds, a human marks success or fail, then the follower returns to the saved
+ * home pose by itself, ready for the next trial. The server times each trial and records it; this panel only asks.
+ */
+const HOME = 'home';
+const HOLD = { type: 'hold', hz: 20 } as const;
+const NEW_KEY = '__new__';
+
+type Outcome = 'success' | 'fail';
+
+export const BenchmarkPanel = ({ modelControl }: { modelControl: SchemaModelControlConfig }) => {
+    const { state, send } = useRuntimeSession();
+    const { project_id } = useProjectId();
+    const modelId = state?.model?.model_id;
+    const robotId = state?.environment?.robot_id;
+    const control = state?.control;
+    const trial = control?.type === 'trial' ? control : null;
+
+    /** The benchmark picked in the list, NEW_KEY for the creation form, or undefined for the newest one. */
+    const [picked, setPicked] = useState<string | undefined>();
+    const [name, setName] = useState('');
+    const [duration, setDuration] = useState(10);
+    const [target, setTarget] = useState(100);
+    const [isBusy, setIsBusy] = useState(false);
+    const [now, setNow] = useState(() => Date.now());
+
+    const poses = $api.useQuery(
+        'get',
+        '/api/projects/{project_id}/benchmarks/poses/{robot_id}',
+        { params: { path: { project_id, robot_id: robotId ?? '' } } },
+        { enabled: robotId !== undefined }
+    );
+    const hasHome = poses.data?.[HOME] !== undefined;
+
+    const benchmarks = $api.useQuery(
+        'get',
+        '/api/projects/{project_id}/benchmarks',
+        { params: { path: { project_id }, query: { model_id: modelId } } },
+        { enabled: modelId !== undefined }
+    );
+    const list = benchmarks.data ?? [];
+    // A trial in progress names its benchmark; otherwise the one picked, else the newest of this model.
+    const activeId = trial?.benchmark_id ?? (picked === NEW_KEY ? null : (picked ?? list[0]?.id ?? null));
+    const benchmark = list.find((each) => each.id === activeId) ?? null;
+    const refetchBenchmarks = benchmarks.refetch;
+
+    // A mark (or an aborted trial) changes the series: reload its statistics.
+    const outcomeKey = trial ? `${trial.phase}:${trial.outcome ?? ''}` : (control?.type ?? 'none');
+    useEffect(() => {
+        void refetchBenchmarks();
+    }, [outcomeKey, refetchBenchmarks]);
+
+    const isRunning = trial?.phase === 'running';
+    useEffect(() => {
+        if (!isRunning) {
+            return;
+        }
+        const timer = window.setInterval(() => setNow(Date.now()), 100);
+        return () => window.clearInterval(timer);
+    }, [isRunning]);
+
+    const step = async (work: () => Promise<void>) => {
+        setIsBusy(true);
+        try {
+            await work();
+        } catch (error) {
+            toast.negative(error instanceof Error ? error.message : String(error), ERROR_TOAST);
+        } finally {
+            setIsBusy(false);
+        }
+    };
+
+    const command = async (payload: Parameters<typeof send>[0], failure: string) => {
+        const ack = await send(payload);
+        if (!ack.ok) {
+            throw new Error(ack.error?.message ?? failure);
+        }
+    };
+
+    const setHome = () =>
+        step(async () => {
+            await command({ command: 'save_pose', name: HOME }, 'Could not save the home pose.');
+            await poses.refetch();
+            toast.positive('Home pose saved: trials return here.');
+        });
+
+    const returnHome = () =>
+        step(() =>
+            command({ command: 'set_control', control: { type: 'move', pose: HOME, hz: 30 } }, 'Could not return home.')
+        );
+
+    const createBenchmark = () =>
+        step(async () => {
+            if (!modelId) {
+                return;
+            }
+            const { data, error } = await fetchClient.POST('/api/projects/{project_id}/benchmarks', {
+                params: { path: { project_id } },
+                body: { name: name.trim(), model_id: modelId, duration_s: duration, target_trials: target },
+            });
+            if (error || !data) {
+                throw new Error('Could not create the benchmark.');
+            }
+            setPicked(data.id);
+            setName('');
+            await refetchBenchmarks();
+        });
+
+    // Not while the follower is still on its way home: the model would start from mid-way.
+    // Marked trials count towards the target; aborted ones are run again. The server refuses past the target too.
+    const marked = benchmark ? benchmark.stats.successes + benchmark.stats.failures : 0;
+    const isComplete = benchmark !== null && marked >= benchmark.target_trials;
+    const canStart =
+        benchmark !== null && !isComplete && hasHome && !isBusy && (trial === null || trial.phase === 'home');
+    const startTrial = () =>
+        step(async () => {
+            if (benchmark === null) {
+                return;
+            }
+            await command(
+                {
+                    command: 'set_control',
+                    control: {
+                        type: 'trial',
+                        benchmark_id: benchmark.id,
+                        model: modelControl,
+                        duration_s: benchmark.duration_s,
+                        home_pose: HOME,
+                        phase: 'running',
+                    },
+                },
+                'Could not start the trial.'
+            );
+        });
+
+    const canMark = trial !== null && (trial.phase === 'running' || trial.phase === 'awaiting_mark') && !isBusy;
+    const mark = (outcome: Outcome) =>
+        step(() => command({ command: 'trial_mark', outcome }, 'Could not record the trial.'));
+
+    const stop = () => step(() => command({ command: 'set_control', control: HOLD }, 'Could not stop the trial.'));
+
+    const undo = () =>
+        step(async () => {
+            if (!benchmark) {
+                return;
+            }
+            const { error } = await fetchClient.DELETE(
+                '/api/projects/{project_id}/benchmarks/{benchmark_id}/trials/last',
+                { params: { path: { project_id, benchmark_id: benchmark.id } } }
+            );
+            if (error) {
+                throw new Error('Could not undo the last trial.');
+            }
+            await refetchBenchmarks();
+        });
+
+    useHotkey(' ', () => void startTrial(), canStart);
+    useHotkey('R', () => void mark('success'), canMark);
+    useHotkey('E', () => void mark('fail'), canMark);
+
+    if (!modelId || !robotId) {
+        return null;
+    }
+
+    const stats = benchmark?.stats;
+    const remaining = trial ? remainingSeconds(trial.started_at, trial.duration_s ?? 10, now) : 0;
+    const recent = (benchmark?.trials ?? []).slice(-8).reverse();
+
+    return (
+        <Flex direction='column' gap='size-150'>
+            <Divider size='S' />
+            <Heading level={4} margin={0}>
+                Benchmark
+            </Heading>
+
+            <Flex gap='size-100' wrap>
+                <Button variant='secondary' isDisabled={isBusy || !hasHome} onPress={() => void returnHome()}>
+                    Return home
+                </Button>
+                <Button variant='secondary' isDisabled={isBusy || isRunning} onPress={() => void setHome()}>
+                    Set home here
+                </Button>
+            </Flex>
+            <Text UNSAFE_className={classes.hint}>
+                {hasHome
+                    ? 'Trials return to the saved home pose. Set home replaces it with where the follower is now.'
+                    : 'No home pose yet: put the follower where every trial should start ' +
+                      '(Take over, or the Hackathon page), then Set home here.'}
+            </Text>
+
+            <Picker
+                label='Benchmark'
+                width='100%'
+                selectedKey={benchmark?.id ?? NEW_KEY}
+                isDisabled={trial !== null && trial.phase !== 'home'}
+                onSelectionChange={(key) => key !== null && setPicked(String(key))}
+                items={[
+                    ...list.map((each) => ({
+                        id: each.id,
+                        label: `${each.name} · ${each.stats.trials}/${each.target_trials}`,
+                    })),
+                    { id: NEW_KEY, label: 'New benchmark…' },
+                ]}
+            >
+                {(item) => <Item key={item.id}>{item.label}</Item>}
+            </Picker>
+
+            {benchmark === null && (
+                <Flex direction='column' gap='size-100'>
+                    <TextField
+                        label='What is measured'
+                        width='100%'
+                        value={name}
+                        onChange={setName}
+                        placeholder='Pick the blue brick'
+                    />
+                    <Flex gap='size-100'>
+                        <NumberField
+                            label='Seconds per trial'
+                            value={duration}
+                            onChange={(value) => setDuration(Number.isFinite(value) ? value : 10)}
+                            minValue={1}
+                            maxValue={300}
+                            width='size-1600'
+                        />
+                        <NumberField
+                            label='Trials'
+                            value={target}
+                            onChange={(value) => setTarget(Number.isFinite(value) ? value : 100)}
+                            minValue={1}
+                            maxValue={1000}
+                            width='size-1200'
+                        />
+                    </Flex>
+                    <Button
+                        variant='accent'
+                        isPending={isBusy}
+                        isDisabled={name.trim() === ''}
+                        onPress={() => void createBenchmark()}
+                    >
+                        Create benchmark
+                    </Button>
+                </Flex>
+            )}
+
+            {benchmark !== null && stats && (
+                <>
+                    <div className={classes.stats} aria-label='Benchmark results'>
+                        <span className={classes.label}>Trials</span>
+                        <span>
+                            {marked} / {benchmark.target_trials}
+                            {stats.aborted > 0 ? ` (${stats.aborted} aborted)` : ''}
+                        </span>
+                        <span className={classes.label}>Success</span>
+                        <span className={classes.rate}>{formatRate(stats)}</span>
+                        <span className={classes.label}>Time to success</span>
+                        <span>
+                            {formatSeconds(stats.mean_time_to_success_s)} mean ·{' '}
+                            {formatSeconds(stats.median_time_to_success_s)} median
+                        </span>
+                    </div>
+                    <div className={classes.progress}>
+                        <span
+                            className={classes.progressFill}
+                            style={{ width: `${Math.min(100, (marked / benchmark.target_trials) * 100)}%` }}
+                        />
+                    </div>
+
+                    {trial === null || trial.phase === 'home' || trial.phase === 'returning' ? (
+                        <>
+                            {trial?.phase === 'returning' && (
+                                <Text UNSAFE_className={classes.hint}>Returning home…</Text>
+                            )}
+                            <Text UNSAFE_className={classes.hint}>
+                                Put the brick in place, then start: the model drives for {benchmark.duration_s} s.
+                            </Text>
+                            <Button variant='accent' isDisabled={!canStart} onPress={() => void startTrial()}>
+                                {isComplete ? 'Benchmark complete' : `Start trial ${marked + 1} (Space)`}
+                            </Button>
+                        </>
+                    ) : (
+                        <>
+                            <div className={trial.phase === 'running' ? classes.timer : classes.timeUp} role='timer'>
+                                {trial.phase === 'running'
+                                    ? `${remaining.toFixed(1)} s`
+                                    : 'Time is up: did it succeed?'}
+                            </div>
+                            <Flex gap='size-100'>
+                                <Button variant='accent' isDisabled={!canMark} onPress={() => void mark('success')}>
+                                    Success (R)
+                                </Button>
+                                <Button variant='negative' isDisabled={!canMark} onPress={() => void mark('fail')}>
+                                    Fail (E)
+                                </Button>
+                                <Button variant='secondary' isDisabled={isBusy} onPress={() => void stop()}>
+                                    Abort
+                                </Button>
+                            </Flex>
+                        </>
+                    )}
+
+                    {recent.length > 0 && (
+                        <div className={classes.trials} role='list' aria-label='Last trials'>
+                            {recent.map((each) => (
+                                <div key={each.index} role='listitem' className={classes.trial}>
+                                    <span>#{each.index}</span>
+                                    <span className={classes[each.outcome]}>{each.outcome}</span>
+                                    <span>
+                                        {each.timed_out
+                                            ? `${formatSeconds(each.elapsed_s)} (time up)`
+                                            : formatSeconds(each.elapsed_s)}
+                                    </span>
+                                </div>
+                            ))}
+                        </div>
+                    )}
+                    <Flex gap='size-100' wrap>
+                        <Button
+                            variant='secondary'
+                            isDisabled={isBusy || marked === 0 || trial?.phase === 'running'}
+                            onPress={() => void undo()}
+                        >
+                            Undo last trial
+                        </Button>
+                        <a
+                            className={classes.link}
+                            href={`/api/projects/${project_id}/benchmarks/${benchmark.id}/csv`}
+                            download
+                        >
+                            Export CSV
+                        </a>
+                    </Flex>
+                    <Text UNSAFE_className={classes.hint}>
+                        Success rate over marked trials ({formatPercent(stats.success_rate)}); aborted trials (stopped,
+                        taken over) are kept apart.
+                    </Text>
+                </>
+            )}
+        </Flex>
+    );
+};
