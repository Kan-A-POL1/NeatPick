index 00000000..83d6ec6a
--- /dev/null
+++ b/application/backend/src/services/camera_settings_io.py
@@ -0,0 +1,120 @@
+"""Export a project's cameras to JSON and import them on another PC (junction-2026 patch).
+
+Import matches cameras by **name**. An existing camera of the same driver gets the file's settings (resolution, fps,
+crop…) but keeps the device chosen on this PC. A new camera keeps the file's device only if that device is plugged
+in here (same fingerprint, or same serial for a camera re-enumerated elsewhere); otherwise it is created with no
+device, which Studio shows as "Camera must be reselected".
+"""
+
+from __future__ import annotations
+
+from typing import Any, Literal
+from uuid import uuid4
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from schemas.project_camera import Camera, CameraAdapter
+
+EXPORT_FORMAT = "physicalai-studio-cameras"
+EXPORT_VERSION = 1
+
+
+class CameraExportEntry(BaseModel):
+    model_config = ConfigDict(extra="ignore")
+
+    name: str
+    driver: str
+    hardware_name: str | None = None
+    fingerprint: dict[str, Any] | None = None
+    payload: dict[str, Any]
+
+
+class CameraExport(BaseModel):
+    model_config = ConfigDict(extra="ignore")
+
+    format: Literal["physicalai-studio-cameras"] = EXPORT_FORMAT
+    version: int = Field(EXPORT_VERSION, ge=1, le=EXPORT_VERSION)
+    project_name: str | None = None
+    cameras: list[CameraExportEntry]
+
+
+class CameraImportOutcome(BaseModel):
+    name: str
+    action: Literal["created", "updated", "skipped"]
+    needs_reselection: bool = False
+    detail: str | None = None
+
+
+def export_cameras(cameras: list[Camera], project_name: str | None = None) -> CameraExport:
+    """Describe every camera of a project, device identity included, as an importable document."""
+    return CameraExport(
+        project_name=project_name,
+        cameras=[
+            CameraExportEntry(
+                name=camera.name,
+                driver=camera.driver,
+                hardware_name=camera.hardware_name,
+                fingerprint=camera.fingerprint,
+                payload=camera.payload.model_dump(mode="json"),
+            )
+            for camera in sorted(cameras, key=lambda c: c.name)
+        ],
+    )
+
+
+def match_fingerprint(wanted: dict[str, Any] | None, available: list[dict[str, Any]]) -> dict[str, Any] | None:
+    """The plugged-in fingerprint that is the same device as ``wanted``, or None."""
+    if not wanted:
+        return None
+    if wanted in available:
+        return wanted
+    serial = wanted.get("serial")
+    if isinstance(serial, str) and serial:
+        for fingerprint in available:
+            if fingerprint.get("serial") == serial:
+                return fingerprint
+    return None
+
+
+def plan_import(
+    export: CameraExport, existing: list[Camera], available: list[dict[str, Any]]
+) -> list[tuple[Camera | None, Camera | None, CameraImportOutcome]]:
+    """Decide what to do with each camera of ``export``, without touching the database.
+
+    Returns:
+        ``(existing camera or None, camera to save or None, outcome)`` per entry, in file order.
+    """
+    by_name = {camera.name: camera for camera in existing}
+    seen: set[str] = set()
+    plan: list[tuple[Camera | None, Camera | None, CameraImportOutcome]] = []
+    for entry in export.cameras:
+        if entry.name in seen:
+            plan.append((None, None, CameraImportOutcome(name=entry.name, action="skipped", detail="duplicate name")))
+            continue
+        current = by_name.get(entry.name)
+        keep_device = current is not None and current.driver == entry.driver and current.fingerprint
+        fingerprint = current.fingerprint if keep_device else match_fingerprint(entry.fingerprint, available)
+        hardware_name = current.hardware_name if keep_device else entry.hardware_name
+        try:
+            camera = CameraAdapter.validate_python(
+                {
+                    "id": current.id if current is not None else uuid4(),
+                    "name": entry.name,
+                    "driver": entry.driver,
+                    "hardware_name": hardware_name,
+                    "fingerprint": fingerprint,
+                    "payload": entry.payload,
+                }
+            )
+        except ValueError as error:
+            outcome = CameraImportOutcome(name=entry.name, action="skipped", detail=f"invalid settings: {error}")
+            plan.append((current, None, outcome))
+            continue
+        seen.add(entry.name)
+        outcome = CameraImportOutcome(
+            name=entry.name,
+            action="updated" if current is not None else "created",
+            needs_reselection=fingerprint is None,
+        )
+        plan.append((current, camera, outcome))
+    return plan
