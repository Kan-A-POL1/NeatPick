index 00000000..15d75878
--- /dev/null
+++ b/application/ui/src/features/robots/camera-form/components/crop-field.tsx
@@ -0,0 +1,46 @@
+import { Button, Flex, Text } from '@geti-ui/ui';
+
+import { CameraCrop, isFullFrame, outputSize } from '../../../cameras/crop-math';
+import { useCameraForm, useSetCameraForm } from '../provider';
+
+export const useCropValue = () => {
+    const { getFormData, state } = useCameraForm();
+    const { updateFormData } = useSetCameraForm();
+    const driver = state.activeDriver;
+    const payload = getFormData(driver).payload as
+        { crop?: CameraCrop | null; width?: number | null; height?: number | null } | undefined;
+
+    const setCrop = (crop: CameraCrop | null) => {
+        const value = crop === null || isFullFrame(crop) ? null : crop;
+        // The crop field is the same on every driver's payload.
+        updateFormData(driver, (prev) => ({ ...prev, payload: { ...prev.payload, crop: value } }) as typeof prev);
+    };
+
+    return { crop: payload?.crop ?? null, setCrop, width: payload?.width ?? 640, height: payload?.height ?? 480 };
+};
+
+export const CropField = () => {
+    const { crop, setCrop, width, height } = useCropValue();
+    const [outWidth, outHeight] = outputSize(width, height, crop);
+
+    return (
+        <Flex direction='column' gap='size-100' width='100%'>
+            <Flex alignItems='center' justifyContent='space-between' gap='size-150' width='100%'>
+                <Flex direction='column'>
+                    <Text UNSAFE_style={{ fontWeight: 600 }}>Crop</Text>
+                    <Text UNSAFE_style={{ fontSize: '12px', fontVariantNumeric: 'tabular-nums' }}>
+                        {crop === null ? `Full frame, ${width} × ${height}` : `Output ${outWidth} × ${outHeight}`}
+                    </Text>
+                </Flex>
+                <Button variant='secondary' isDisabled={crop === null} onPress={() => setCrop(null)}>
+                    Reset
+                </Button>
+            </Flex>
+            <Text UNSAFE_style={{ fontSize: '12px', color: 'var(--spectrum-global-color-gray-700)' }}>
+                Drag the handles of the frame on the preview to crop, drag inside it to move it (arrow keys move it,
+                Shift + arrows resize it). Preview, recording and inference all use this view. Changing the shape
+                changes the image size: record new datasets with it rather than adding to old ones.
+            </Text>
+        </Flex>
+    );
+};
