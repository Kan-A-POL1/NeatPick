+import asyncio
+import uuid
+from unittest.mock import MagicMock
+
+import numpy as np
+import pytest
+
+from runtime_session.store import FeatureSpec, Store
+from schemas.project_camera import CameraAdapter
+from workers.camera_worker import CameraWorker, camera_image_spec, depth_to_image, records_depth
+
+
+def _realsense(output_type: str):
+    return CameraAdapter.validate_python(
+        {
+            "driver": "realsense",
+            "name": "test_depth_cam",
+            "fingerprint": {"serial": "123"},
+            "hardware_name": None,
+            "payload": {"width": 640, "height": 480, "fps": 30, "output_type": output_type,
+                        "depth_range_min": 0.3, "depth_range_max": 3.0},
+        }
+    )
+
+
+def _frame(data: np.ndarray, timestamp: float = 1.0) -> MagicMock:
+    frame = MagicMock()
+    frame.data, frame.timestamp = data, timestamp
+    return frame
+
+
+def test_depth_maps_near_bright_far_dark_and_no_reading_black():
+    depth = np.array([[0, 300, 1000, 3000, 9000]], dtype=np.uint16)
+    image = depth_to_image(depth, 0.3, 3.0)
+    assert image.shape == (1, 5, 3) and image.dtype == np.uint8
+    assert image[0, :, 0].tolist() == [0, 255, 189, 1, 1]
+
+
+def test_only_cameras_set_to_output_depth_record_it():
+    assert records_depth(_realsense("both"))
+    assert not records_depth(_realsense("color"))
+
+
+@pytest.fixture
+def store():
+    spec = camera_image_spec(_realsense("both"))
+    store = Store.create(FeatureSpec((), {"cam": spec, "cam_depth": spec}), uuid.uuid4().hex)
+    yield store
+    store.unlink()
+
+
+def test_the_worker_writes_depth_beside_colour_and_invalidates_both(store):
+    worker = CameraWorker(_realsense("both"), store, "cam")
+    camera = MagicMock()
+
+    def read_latest():
+        worker.request_stop()
+        return _frame(np.zeros((480, 640, 3), np.uint8), timestamp=2.0)
+
+    camera.read_latest.side_effect = read_latest
+    camera.read_latest_depth.return_value = _frame(np.full((240, 320), 300, np.uint16))
+    asyncio.run(worker.run_loop(camera))
+
+    depth = store.read_observation("cam_depth")
+    assert depth.timestamp == 2.0
+    # Resized to the colour slot.
+    assert depth.value.shape == (480, 640, 3)
+    assert np.all(depth.value == 255)
+
+    camera.read_latest.side_effect = RuntimeError("unplugged")
+    with pytest.raises(RuntimeError):
+        asyncio.run(CameraWorker(_realsense("both"), store, "cam").run_loop(camera))
+    assert store.read_observation("cam") is None
+    assert store.read_observation("cam_depth") is None
+
+
+def test_a_session_shows_each_depth_image_as_a_camera_of_its_own(tmp_path):
+    from runtime_session.environment import EnvironmentDescription
+    from workers.robot_worker import RobotRecipe
+
+    from .fake_robot import FakeRobot
+
+    depth, colour = _realsense("both"), _realsense("color")
+    follower = RobotRecipe.from_driver(uuid.uuid4(), FakeRobot(str(tmp_path / "log"), ["gripper"], [0.0]))
+    image = camera_image_spec(depth)
+    spec = FeatureSpec(follower.joint_names, {"top": image, "top_depth": image, "side": image})
+    description = EnvironmentDescription(None, "env", {}, spec, follower, None, {"top": depth, "side": colour})
+
+    cameras = description.session_environment().cameras
+    assert [(camera.key, camera.name) for camera in cameras] == [
+        ("top", "test_depth_cam"), ("side", "test_depth_cam"), ("top_depth", "test_depth_cam depth")
+    ]
+    assert len({camera.camera_id for camera in cameras}) == 3
