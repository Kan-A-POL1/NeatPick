+import { Text } from '@geti-ui/ui';
+
+import { $api } from '../../api/client';
+import { SchemaDatasetContents } from '../../api/openapi-spec';
+import { getQueryKey } from '../../query-client/query-client.interface';
+
+export const DEFAULT_EPISODE_TAGS = ['do nothing', 'failed to pick'];
+
+export const getContentsQueryKey = (dataset_id: string) =>
+    getQueryKey(['get', '/api/dataset/{dataset_id}/contents', { params: { path: { dataset_id } } }]);
+
+export const useDatasetContents = (dataset_id: string | undefined, refetchOnMount: boolean | 'always' = true) =>
+    $api.useQuery(
+        'get',
+        '/api/dataset/{dataset_id}/contents',
+        { params: { path: { dataset_id: dataset_id ?? '' } } },
+        { enabled: dataset_id !== undefined, refetchOnMount }
+    );
+
+/** Tags to pick from: the usual ones, then those the dataset already uses. */
+export const useTagSuggestions = (dataset_id: string | undefined) => {
+    const { data } = useDatasetContents(dataset_id);
+    const used = Object.keys(data?.tags ?? {}).filter((tag) => tag !== '');
+    return [...new Set([...DEFAULT_EPISODE_TAGS, ...used])];
+};
+
+/** "load", "current", ... from `motor.<quantity>.<joint>` names; the `ee.*` pose counts as one. */
+export const telemetryQuantities = (names: string[]) => [
+    ...new Set(names.map((name) => (name.startsWith('ee.') ? 'ee pose' : (name.split('.')[1] ?? name)))),
+];
+
+export const tagLabel = (tag: string) => (tag === '' ? 'untagged' : tag);
+
+/** One line saying what the dataset records: joint positions, telemetry (load, current, ...), cameras, tags. */
+export const DatasetContentsLine = ({
+    contents,
+    tags = contents.tags,
+}: {
+    contents: SchemaDatasetContents;
+    tags?: Record<string, number>;
+}) => {
+    const quantities = telemetryQuantities(contents.telemetry);
+    const parts = [
+        contents.joint_positions.length > 0
+            ? `${contents.joint_positions.length} joint positions`
+            : 'no joint positions',
+        quantities.length > 0 ? `telemetry: ${quantities.join(', ')}` : 'no telemetry',
+        `cameras: ${contents.cameras.join(', ') || 'none'}`,
+    ];
+    if (Object.keys(tags).some((tag) => tag !== '')) {
+        parts.push(
+            `tags: ${Object.entries(tags)
+                .map(([tag, count]) => `${tagLabel(tag)} ${count}`)
+                .join(', ')}`
+        );
+    }
+    return (
+        <Text UNSAFE_style={{ fontSize: 'var(--spectrum-global-dimension-font-size-75)' }}>{parts.join(' · ')}</Text>
+    );
+};
