@@ -0,0 +1,239 @@
+"""junction-2026: benchmark trials and moving to a saved pose (Return home)."""
+
+import time
+from datetime import UTC, datetime
+from types import SimpleNamespace
+from uuid import uuid4
+
+import numpy as np
+import pytest
+
+from runtime_session.controls import trial as trial_module
+from runtime_session.controls.move import MoveControl
+from runtime_session.controls.trial import TrialControl
+from runtime_session.store import ACTION, STATE
+from schemas.runtime_session import ModelControlConfig, MoveControlConfig, TrialControlConfig, TrialMarkCommand
+from services.benchmarks import BenchmarkCreate, BenchmarkStore
+
+JOINTS = ("shoulder_pan.pos", "gripper.pos")
+HOME = {"shoulder_pan.pos": 0.0, "gripper.pos": 10.0}
+START = [40.0, 50.0]
+
+
+class FakeStore:
+    def __init__(self) -> None:
+        self.spec = SimpleNamespace(joint_names=JOINTS)
+        self.samples: dict[str, SimpleNamespace] = {}
+
+    def write(self, key, values, *, timestamp):
+        self.samples[key] = SimpleNamespace(value=np.array(values, float), timestamp=timestamp)
+
+    def read(self, key):
+        return self.samples.get(key)
+
+
+class FakeModelControl:
+    """Stands for ModelControl: commands a fixed pose while it runs."""
+
+    def __init__(self, store, _model, _config) -> None:
+        self.store = store
+        self.running = False
+        self.ticks = 0
+
+    def on_start(self) -> None:
+        self.running = True
+
+    def on_stop(self) -> None:
+        self.running = False
+
+    def on_tick(self) -> None:
+        self.ticks += 1
+        self.store.write(ACTION, [20.0, 20.0], timestamp=time.monotonic())
+
+
+def _store() -> FakeStore:
+    store = FakeStore()
+    store.write(STATE, START, timestamp=time.monotonic())
+    return store
+
+
+def _run_until_home(control, limit: int = 1000) -> None:
+    for _ in range(limit):
+        control.on_tick()
+        if control.trial.phase == "home":
+            return
+    raise AssertionError("never got home")
+
+
+@pytest.fixture
+def setup(tmp_path, monkeypatch):
+    monkeypatch.setattr(trial_module, "ModelControl", FakeModelControl)
+    benchmarks = BenchmarkStore(tmp_path)
+    benchmark = benchmarks.create(uuid4(), "act", BenchmarkCreate(name="blue brick", model_id=uuid4(), duration_s=10))
+    store = _store()
+
+    def make(**config) -> TrialControl:
+        trial = TrialControl(
+            store,
+            object(),
+            TrialControlConfig(benchmark_id=benchmark.id, model=ModelControlConfig(), target=HOME, **config),
+            benchmarks,
+        )
+        trial.on_start()
+        return trial
+
+    return SimpleNamespace(store=store, benchmarks=benchmarks, benchmark=benchmark, make=make)
+
+
+def test_move_goes_smoothly_to_the_pose_then_holds_it() -> None:
+    store = _store()
+    move = MoveControl(store, MoveControlConfig(target=HOME, hz=50))
+    move.on_start()
+    move.on_tick()
+    first = store.read(ACTION).value
+    assert 0 < np.abs(first - START).max() < 5  # a small first step, not a jump
+    for _ in range(400):
+        move.on_tick()
+    assert store.read(ACTION).value.tolist() == [0.0, 10.0]
+    move.on_tick()
+    assert store.read(ACTION).value.tolist() == [0.0, 10.0]  # held there
+
+
+def test_move_refuses_a_missing_or_foreign_pose() -> None:
+    with pytest.raises(ValueError, match="No pose 'home'"):
+        MoveControl(_store(), MoveControlConfig())
+    with pytest.raises(ValueError, match="joints"):
+        MoveControl(_store(), MoveControlConfig(target={"elbow.pos": 1.0}))
+
+
+def test_move_needs_a_known_follower_position() -> None:
+    with pytest.raises(ValueError, match="unknown"):
+        MoveControl(FakeStore(), MoveControlConfig(target=HOME)).on_start()
+
+
+def test_an_early_success_is_recorded_then_the_follower_goes_home(setup) -> None:
+    trial = setup.make()
+    trial.on_tick()
+    assert trial.model_control.ticks == 1 and trial.trial.phase == "running"
+    assert trial.trial.started_at is not None
+
+    trial.mark(TrialMarkCommand(request_id="r", outcome="success"))
+    assert not trial.model_control.running
+    assert trial.trial.phase == "returning" and trial.trial.outcome == "success"
+    recorded = setup.benchmarks.get(setup.benchmark.id).trials
+    assert [(t.outcome, t.timed_out) for t in recorded] == [("success", False)]
+    assert recorded[0].elapsed_s < 10
+
+    _run_until_home(trial)
+    assert setup.store.read(ACTION).value.tolist() == [0.0, 10.0]
+    with pytest.raises(ValueError, match="already marked"):
+        trial.mark(TrialMarkCommand(request_id="r", outcome="fail"))
+    trial.on_stop()
+    assert len(setup.benchmarks.get(setup.benchmark.id).trials) == 1  # no extra "aborted" for a marked trial
+
+
+def test_time_up_stops_the_model_and_holds_until_marked(setup) -> None:
+    trial = setup.make()
+    trial.on_tick()
+    trial._started -= 11  # the 10 s are up
+    setup.store.write(STATE, [25.0, 30.0], timestamp=time.monotonic())
+    trial.on_tick()
+    assert trial.trial.phase == "awaiting_mark" and not trial.model_control.running
+    setup.store.write(STATE, [99.0, 99.0], timestamp=time.monotonic())  # sagging: the hold keeps the pose
+    trial.on_tick()
+    assert setup.store.read(ACTION).value.tolist() == [25.0, 30.0]
+
+    trial.mark(TrialMarkCommand(request_id="r", outcome="fail"))
+    (recorded,) = setup.benchmarks.get(setup.benchmark.id).trials
+    assert (recorded.outcome, recorded.timed_out, recorded.elapsed_s) == ("fail", True, 10.0)
+    _run_until_home(trial)
+
+
+def test_a_trial_stopped_before_its_mark_is_recorded_aborted(setup) -> None:
+    trial = setup.make()
+    trial.on_tick()
+    trial.on_stop()
+    assert not trial.model_control.running
+    assert [t.outcome for t in setup.benchmarks.get(setup.benchmark.id).trials] == ["aborted"]
+
+
+def test_a_complete_benchmark_refuses_another_trial(setup) -> None:
+    two = BenchmarkCreate(name="two", model_id=uuid4(), target_trials=2)
+    small = setup.benchmarks.create(uuid4(), "act", two)
+    now = datetime.now(UTC)
+    for outcome in ("success", "aborted", "fail"):  # aborted trials do not count towards the target
+        setup.benchmarks.add_trial(
+            small.id, outcome=outcome, elapsed_s=1, timed_out=False, started_at=now, marked_at=now
+        )
+    trial = TrialControl(
+        setup.store,
+        object(),
+        TrialControlConfig(benchmark_id=small.id, model=ModelControlConfig(), target=HOME),
+        setup.benchmarks,
+    )
+    with pytest.raises(ValueError, match="complete"):
+        trial.on_start()
+
+
+def test_a_trial_needs_its_benchmark_and_a_home_pose(setup) -> None:
+    with pytest.raises(KeyError):
+        TrialControl(
+            setup.store,
+            object(),
+            TrialControlConfig(benchmark_id=uuid4(), model=ModelControlConfig(), target=HOME),
+            setup.benchmarks,
+        ).on_start()
+    with pytest.raises(ValueError, match="No pose 'home'"):
+        TrialControl(
+            setup.store,
+            object(),
+            TrialControlConfig(benchmark_id=setup.benchmark.id, model=ModelControlConfig()),
+            setup.benchmarks,
+        )
+
+
+def test_an_aborted_trial_that_cannot_be_recorded_is_reported(setup) -> None:
+    published = []
+    trial = setup.make()
+    trial.bus = SimpleNamespace(publish=lambda key, message: published.append((key, message)))
+    setup.benchmarks.delete(setup.benchmark.id)  # the record now fails
+    trial.on_stop()  # does not raise: the arm must still end held
+    ((key, message),) = published
+    assert key == "evt/session"
+    assert message.error_code == "trial_not_recorded" and message.session_alive
+
+
+def test_a_pose_saved_with_dotted_joint_names_fits_the_follower() -> None:
+    """The Hackathon page saves "shoulder_pan.pos"; the store may name the joint "shoulder_pan"."""
+    store = _store()
+    move = MoveControl(store, MoveControlConfig(target={"shoulder_pan": 0.0, "gripper": 10.0}))
+    move.on_start()
+    for _ in range(400):
+        move.on_tick()
+    assert store.read(ACTION).value.tolist() == [0.0, 10.0]
+
+
+def test_a_pose_naming_a_joint_twice_is_refused() -> None:
+    with pytest.raises(ValueError, match="twice"):
+        MoveControl(_store(), MoveControlConfig(target={**HOME, "gripper": 3.0}))
+
+
+def test_a_verdict_that_cannot_be_recorded_still_stops_the_model_and_holds(setup) -> None:
+    trial = setup.make()
+    trial.on_tick()
+    setup.store.write(STATE, [25.0, 30.0], timestamp=time.monotonic())
+    setup.benchmarks.delete(setup.benchmark.id)  # recording the verdict now fails
+    with pytest.raises(KeyError):
+        trial.mark(TrialMarkCommand(request_id="r", outcome="success"))
+    assert not trial.model_control.running
+    assert trial.trial.phase == "awaiting_mark" and trial.trial.outcome is None
+    trial.on_tick()
+    assert setup.store.read(ACTION).value.tolist() == [25.0, 30.0]  # held, not driven by the model
+
+
+def test_an_early_mark_is_not_counted_as_timed_out(setup) -> None:
+    trial = setup.make()
+    trial.on_tick()
+    trial.mark(TrialMarkCommand(request_id="r", outcome="fail"))
+    (recorded,) = setup.benchmarks.get(setup.benchmark.id).trials
+    assert recorded.timed_out is False and recorded.elapsed_s < 10
