+"""Camera settings export / import by name (junction-2026 patch)."""
+
+from uuid import uuid4
+
+from schemas.project_camera import CameraAdapter
+from services.camera_settings_io import CameraExport, export_cameras, match_fingerprint, plan_import
+
+CROP = {"x": 0.2, "y": 0.1, "width": 0.6, "height": 0.6}
+
+
+def _camera(name: str, serial: str | None, *, crop: dict | None = None, driver: str = "realsense"):
+    payload = {"width": 640, "height": 480, "fps": 30, "crop": crop}
+    fingerprint = None if serial is None else {"serial": serial}
+    if driver == "usb_camera":
+        fingerprint = None if serial is None else {"bus": "usb-1", "index": 4, "sensor": "", "serial": serial}
+    return CameraAdapter.validate_python(
+        {
+            "id": uuid4(),
+            "name": name,
+            "driver": driver,
+            "fingerprint": fingerprint,
+            "hardware_name": "hw",
+            "payload": payload,
+        }
+    )
+
+
+def test_export_round_trips_through_json() -> None:
+    document = export_cameras([_camera("overhead", "A", crop=CROP), _camera("front", "B")])
+    again = CameraExport.model_validate_json(document.model_dump_json())
+    assert [c.name for c in again.cameras] == ["front", "overhead"]
+    assert again.cameras[1].payload["crop"] == CROP
+
+
+def test_existing_camera_gets_the_settings_but_keeps_its_local_device() -> None:
+    local = _camera("overhead", "LOCAL-SERIAL")
+    document = export_cameras([_camera("overhead", "OTHER-PC-SERIAL", crop=CROP)])
+    [(current, camera, outcome)] = plan_import(document, [local], available=[{"serial": "LOCAL-SERIAL"}])
+    assert current is local and outcome.action == "updated" and not outcome.needs_reselection
+    assert camera.id == local.id
+    assert camera.fingerprint == {"serial": "LOCAL-SERIAL"}
+    assert camera.payload.crop is not None and camera.payload.crop.x == 0.2
+
+
+def test_new_camera_keeps_its_device_when_plugged_in_here() -> None:
+    document = export_cameras([_camera("wrist", "HB1", driver="usb_camera")])
+    plugged = {"bus": "usb-9", "index": 2, "sensor": "", "serial": "HB1"}  # re-enumerated on another port
+    [(_, camera, outcome)] = plan_import(document, [], available=[plugged])
+    assert outcome.action == "created" and not outcome.needs_reselection
+    assert camera.fingerprint == plugged
+
+
+def test_new_camera_whose_device_is_absent_must_be_reselected() -> None:
+    document = export_cameras([_camera("front", "NOT-HERE")])
+    [(_, camera, outcome)] = plan_import(document, [], available=[{"serial": "SOMETHING-ELSE"}])
+    assert outcome.action == "created" and outcome.needs_reselection
+    assert camera.fingerprint is None
+
+
+def test_invalid_settings_and_duplicates_are_skipped_not_fatal() -> None:
+    document = export_cameras([_camera("overhead", "A")])
+    bad = document.cameras[0].model_copy(
+        update={
+            "payload": {"width": 640, "height": 480, "fps": 30, "crop": {"x": 0.9, "y": 0, "width": 0.5, "height": 0.5}}
+        }
+    )
+    document = document.model_copy(update={"cameras": [bad, document.cameras[0], document.cameras[0]]})
+    outcomes = [outcome for _, _, outcome in plan_import(document, [], available=[])]
+    assert [o.action for o in outcomes] == ["skipped", "created", "skipped"]
+
+
+def test_match_fingerprint_needs_an_exact_device_or_the_same_serial() -> None:
+    assert match_fingerprint({"serial": "A"}, [{"serial": "A"}]) == {"serial": "A"}
+    assert match_fingerprint({"url": "rtsp://x"}, [{"url": "rtsp://y"}]) is None
+    assert match_fingerprint(None, [{"serial": "A"}]) is None
diff --git a/application/backend/tests/services/test_hackathon_arm.py b/application/backend/tests/services/test_hackathon_arm.py
new file mode 100644
index 00000000..cdbfc50d
--- /dev/null
+++ b/application/backend/tests/services/test_hackathon_arm.py
@@ -0,0 +1,143 @@
+import contextlib
+import subprocess
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+from uuid import uuid4
+
+import numpy as np
+import pytest
+
+from services import hackathon_arm
+from services.hackathon_arm import ArmBusyError, HackathonArm, move_profile, port_holders
+
+JOINTS = ["shoulder_pan", "shoulder_lift", "elbow_flex", "wrist_flex", "wrist_roll", "gripper"]
+
+
+class FakeRobot:
+    def __init__(self, port: str, positions: list[float]) -> None:
+        self.port = port
+        self.device_ids = (port,)
+        self.joint_names = JOINTS
+        self.positions = np.array(positions, dtype=np.float64)
+        self.sent: list[np.ndarray] = []
+        self.connected = False
+        self.torque: bool | None = None
+        self.torque_on_disconnect = True
+
+    def connect(self) -> None:
+        self.connected = True
+
+    def disconnect(self) -> None:
+        self.connected = False
+
+    def get_observation(self) -> SimpleNamespace:
+        assert self.connected
+        return SimpleNamespace(joint_positions=self.positions.copy(), timestamp=time.monotonic())
+
+    def send_action(self, action: np.ndarray, goal_time: float = 0.1) -> None:
+        assert self.connected
+        self.sent.append(np.array(action, dtype=np.float64))
+        self.positions = np.array(action, dtype=np.float64)
+
+    def set_torque(self, *, enabled: bool) -> None:
+        self.torque = enabled
+
+
+@pytest.fixture
+def claims(monkeypatch: pytest.MonkeyPatch) -> list[str]:
+    """Claims taken and not yet released."""
+    held: list[str] = []
+
+    @contextlib.contextmanager
+    def fake_claim(name: str, device_ids: tuple[str, ...]):
+        held.append(name)
+        try:
+            yield
+        finally:
+            held.remove(name)
+
+    monkeypatch.setattr(hackathon_arm, "claim_devices", fake_claim)
+    monkeypatch.setattr(hackathon_arm, "port_holders", lambda port: [])
+    monkeypatch.setattr(hackathon_arm.time, "sleep", lambda _s: None)
+    return held
+
+
+def test_move_profile_eases_from_start_to_target() -> None:
+    start, target = np.zeros(6), np.array([80.0, 0, 0, 0, 0, 10])
+    waypoints = move_profile(start, target, hz=50)
+    assert np.allclose(waypoints[-1], target)
+    assert len(waypoints) == 100  # 80 units at 40/s: 2 s
+    steps = np.diff([w[0] for w in [start, *waypoints]])
+    assert (steps >= 0).all() and steps[0] < steps[len(steps) // 2]  # slow start, faster middle
+    assert len(move_profile(start, start + 1, hz=50)) == 50  # at least MOVE_MIN_S
+
+
+def test_save_then_go_to_pose_moves_smoothly_and_holds(tmp_path: Path, claims: list[str]) -> None:
+    arm, robot_id = HackathonArm(tmp_path / "poses.json"), uuid4()
+    follower = FakeRobot("/dev/fake-follower", [10, 20, 30, 40, 50, 5])
+
+    pose = arm.save_pose(robot_id, follower, "inspect")
+    assert pose == dict(zip(JOINTS, [10, 20, 30, 40, 50, 5], strict=True))
+    assert HackathonArm(tmp_path / "poses.json").poses(robot_id) == {"inspect": pose}  # on disk
+
+    follower.positions = np.zeros(6)
+    arm.go_to_pose(robot_id, follower, "inspect")
+    assert np.allclose(follower.sent[-1], [10, 20, 30, 40, 50, 5])
+    assert np.max(np.abs(np.diff(follower.sent, axis=0))) < 2  # no jump
+    assert not follower.connected and claims == []
+    with pytest.raises(KeyError):
+        arm.go_to_pose(robot_id, follower, "missing")
+
+
+def test_teleop_tracks_the_leader_and_releases_on_stop(tmp_path: Path, claims: list[str]) -> None:
+    arm, follower_id, leader_id = HackathonArm(tmp_path / "poses.json"), uuid4(), uuid4()
+    follower = FakeRobot("/dev/fake-follower", [0] * 6)
+    leader = FakeRobot("/dev/fake-leader", [30] * 6)
+
+    arm.start_teleop(follower_id, follower, leader_id, leader)
+    assert arm.teleop_on and len(claims) == 2
+    deadline = time.monotonic() + 5
+    while not np.allclose(follower.positions, 30) and time.monotonic() < deadline:
+        time.sleep(0.05)
+    assert np.allclose(follower.positions, 30)
+    # Read by the teleop thread, one tick behind its last command.
+    assert arm.save_pose(follower_id, follower, "held")["gripper"] == pytest.approx(30, abs=1)
+
+    arm.stop_teleop()
+    assert not arm.teleop_on and claims == [] and not follower.connected and not leader.connected
+
+
+def test_refuses_an_arm_another_program_has_open(
+    tmp_path: Path, claims: list[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(hackathon_arm, "port_holders", lambda port: ["SortOps (pid 1)"])
+    follower = FakeRobot("/dev/fake-follower", [0] * 6)
+    with pytest.raises(ArmBusyError, match="SortOps"):
+        HackathonArm(tmp_path / "poses.json").save_pose(uuid4(), follower, "x")
+    assert claims == [] and not follower.connected
+
+
+def test_torque_off_leaves_the_follower_limp(tmp_path: Path, claims: list[str]) -> None:
+    follower = FakeRobot("/dev/fake-follower", [0] * 6)
+    HackathonArm(tmp_path / "poses.json").torque_off(uuid4(), follower)
+    assert follower.torque is False and follower.torque_on_disconnect is False and not follower.connected
+
+
+@pytest.mark.skipif(not Path("/proc/self/fd").exists(), reason="reads /proc")
+def test_port_holders_names_the_process_with_the_port_open(tmp_path: Path) -> None:
+    port = tmp_path / "ttyFAKE"
+    port.write_text("")
+    with port.open() as handle:
+        child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(10)"], stdin=handle)
+    try:
+        deadline = time.monotonic() + 5
+        while not (holders := port_holders(str(port))) and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert holders == [f"{Path(sys.executable).name} (pid {child.pid})"] or holders == [
+            f"a Studio session (pid {child.pid})"
+        ]
+    finally:
+        child.kill()
+        child.wait()
