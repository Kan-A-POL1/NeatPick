+
+
+async def test_a_take_over_that_fails_mid_way_falls_back_to_hold(new_session, robot_factory, tmp_path) -> None:
+    """junction-2026: the leader drops out during a correction; the follower holds instead of losing its torque."""
+    from schemas.runtime_session import HoldControlConfig, TeleopControlConfig
+
+    await _leader_at(robot_factory, tmp_path, [1.0, 2.0])
+    session = await new_session()
+    await session.load_environment(make_environment(cameras=0))
+    try:
+        await session.set_control(TeleopControlConfig(require_alignment=True, alignment_hold_s=0.1, grace_s=0))
+
+        def unplugged():
+            raise ConnectionError("leader unplugged")
+
+        session.leader.get_observation = unplugged
+        await _until(lambda: session.state().control == HoldControlConfig())
+    finally:
+        await session.stop()
+
+
+async def test_a_failing_plain_teleop_still_ends_with_no_control(new_session) -> None:
+    """Outside a correction the upstream behaviour stays: a failed control is dropped."""
+    from schemas.runtime_session import TeleopControlConfig
+
+    session = await new_session()
+    await session.load_environment(make_environment(cameras=0))
+    try:
+        await session.set_control(TeleopControlConfig())
+
+        def unplugged():
+            raise ConnectionError("leader unplugged")
+
+        session.leader.get_observation = unplugged
+        await _until(lambda: session.state().control is None)
+    finally:
+        await session.stop()
+
+
+async def test_a_correction_whose_episode_cannot_stop_still_ends_held(new_session, robot_factory, tmp_path) -> None:
+    """junction-2026: save/discard broke the recording; leaving the take-over must still hold the follower."""
+    from schemas.runtime_session import HoldControlConfig, TeleopControlConfig
+
+    await _leader_at(robot_factory, tmp_path, [1.0, 2.0])
+    session = await new_session()
+    await session.load_environment(make_environment(cameras=0))
+    try:
+        await session.set_control(TeleopControlConfig(require_alignment=True, alignment_hold_s=0.1, grace_s=0))
+
+        async def broken_stop() -> None:
+            raise RuntimeError("episode stuck")
+
+        session._stop_recording = broken_stop
+        with pytest.raises(RuntimeError, match="episode stuck"):
+            await session.set_control(None)  # even a request for no control ends in a hold during a correction
+        assert session.state().control == HoldControlConfig()
