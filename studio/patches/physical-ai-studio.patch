+def _hand_over_snapshots(output_dir: Path) -> None:
+    """Move the snapshot checkpoints out of the model so its runner publishes them (they are already live)."""
+    snapshots_dir = output_dir / SNAPSHOTS_DIRNAME
+    if not snapshots_dir.is_dir():
+        return
+    target = live_snapshots_dir(output_dir)
+    target.mkdir(parents=True, exist_ok=True)
+    for checkpoint in snapshots_dir.glob(f"{SNAPSHOT_PREFIX}*.ckpt"):
+        shutil.move(str(checkpoint), str(target / checkpoint.name))
+    shutil.rmtree(snapshots_dir, ignore_errors=True)
+
+
+def _export_snapshots(spec: TrainingJobSpec, output_dir: Path, report: ReportFn) -> None:
+    """Turn every ``snapshots/step-NNNNNN.ckpt`` into a ``snapshots/step-NNNNNN/`` model directory.
+
+    Each directory gets the checkpoint as :data:`CHECKPOINT_NAME` plus its own exports, so the studio can
+    register it as a standalone model. Best-effort per snapshot: a failed export leaves that snapshot with
+    its checkpoint only and never fails the run, whose main model is already exported.
+    """
+    snapshots_dir = output_dir / SNAPSHOTS_DIRNAME
+    if not snapshots_dir.is_dir():
+        return
+    uncompiled = spec.model_copy(update={"compile_model": False})
+    checkpoints = sorted(snapshots_dir.glob(f"{SNAPSHOT_PREFIX}*.ckpt"))
+    for index, checkpoint in enumerate(checkpoints, start=1):
+        model_dir = snapshots_dir / checkpoint.stem
+        try:
+            model_dir.mkdir(exist_ok=True)
+            shutil.move(str(checkpoint), str(model_dir / CHECKPOINT_NAME))
+            report(99, f"Exporting snapshot {checkpoint.stem} ({index}/{len(checkpoints)})", {})
+            policy = _load_policy_from_checkpoint(uncompiled, model_dir / CHECKPOINT_NAME)
+            _export(policy, model_dir, report, spec.export_backends)
+            del policy
+        except Exception:
+            logger.exception("Failed exporting snapshot %s", checkpoint.stem)
+        finally:
+            _release_memory()
 
 
