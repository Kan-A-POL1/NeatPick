index 00000000..e4e4900a
--- /dev/null
+++ b/application/backend/src/utils/camera_calibration.py
@@ -0,0 +1,106 @@
+"""Optional lens undistortion for project cameras.
+
+A camera is undistorted when ``<storage_dir>/camera_calibration/<camera name>.xml`` (or ``.yaml``) exists.
+The file is an OpenCV FileStorage file as written by ``opencv_interactive-calibration`` (``cameraMatrix``,
+``dist_coeffs``, ``cameraResolution``, ``framesCount``) or by ``cv.calibrateCamera`` scripts
+(``camera_matrix``, ``dist_coeffs``, ``image_width``, ``image_height``).
+
+The output keeps the frame size and is cropped to valid pixels (``alpha=0``), so dataset and policy shapes are
+unchanged. A camera with no file passes frames through untouched, so a second camera entry on the same device
+(e.g. ``overhead_not_calibrated``) shows the raw image.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import cv2
+import numpy as np
+from loguru import logger
+
+from settings import get_settings
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+MIN_FRAMES = 10
+"""Reject calibrations computed from fewer board views than this; they are not reliable."""
+
+
+class Undistorter:
+    """Remap frames with precomputed maps; maps are built per frame size on first use."""
+
+    def __init__(self, camera_matrix: np.ndarray, dist_coeffs: np.ndarray, calib_size: tuple[int, int]) -> None:
+        self.camera_matrix = camera_matrix
+        self.dist_coeffs = dist_coeffs
+        self.calib_size = calib_size
+        self._maps: dict[tuple[int, int], tuple[np.ndarray, np.ndarray]] = {}
+
+    def _maps_for(self, size: tuple[int, int]) -> tuple[np.ndarray, np.ndarray]:
+        maps = self._maps.get(size)
+        if maps is None:
+            (w, h), (cw, ch) = size, self.calib_size
+            if abs(w / h - cw / ch) > 1e-3:
+                msg = f"frame {w}x{h} has a different aspect ratio than the calibration ({cw}x{ch})"
+                raise ValueError(msg)
+            # Intrinsics scale linearly with resolution at a fixed aspect ratio.
+            k = self.camera_matrix.copy()
+            k[:2] *= w / cw
+            new_k, _ = cv2.getOptimalNewCameraMatrix(k, self.dist_coeffs, size, 0, size)
+            maps = cv2.initUndistortRectifyMap(k, self.dist_coeffs, None, new_k, size, cv2.CV_16SC2)
+            self._maps[size] = maps
+        return maps
+
+    def __call__(self, frame: np.ndarray) -> np.ndarray:
+        map1, map2 = self._maps_for((frame.shape[1], frame.shape[0]))
+        return cv2.remap(frame, map1, map2, cv2.INTER_LINEAR)
+
+
+def calibration_dir() -> Path:
+    """Directory holding ``<camera name>.xml`` calibration files."""
+    return get_settings().storage_dir / "camera_calibration"
+
+
+def _read(path: Path) -> Undistorter:
+    fs = cv2.FileStorage(str(path), cv2.FILE_STORAGE_READ)
+    if not fs.isOpened():
+        msg = f"cannot read {path}"
+        raise ValueError(msg)
+    try:
+        k = fs.getNode("cameraMatrix").mat()
+        if k is None:
+            k = fs.getNode("camera_matrix").mat()
+        dist = fs.getNode("dist_coeffs").mat()
+        if k is None or dist is None:
+            msg = f"{path} has no cameraMatrix/camera_matrix or dist_coeffs"
+            raise ValueError(msg)
+        res = fs.getNode("cameraResolution")
+        if not res.empty():
+            size = tuple(int(v) for v in res.mat().ravel()[:2])
+        else:
+            size = (int(fs.getNode("image_width").real()), int(fs.getNode("image_height").real()))
+        frames = fs.getNode("framesCount")
+        if not frames.empty() and int(frames.real()) < MIN_FRAMES:
+            msg = f"{path} was computed from {int(frames.real())} frames (< {MIN_FRAMES}); recalibrate"
+            raise ValueError(msg)
+    finally:
+        fs.release()
+    if size[0] <= 0 or size[1] <= 0:
+        msg = f"{path} has no calibration resolution"
+        raise ValueError(msg)
+    return Undistorter(k.astype(np.float64), dist.astype(np.float64), size)
+
+
+def load_undistorter(camera_name: str) -> Undistorter | None:
+    """Return the undistorter for ``camera_name``, or ``None`` when it has no (valid) calibration file."""
+    for suffix in (".xml", ".yaml", ".yml"):
+        path = calibration_dir() / f"{camera_name}{suffix}"
+        if path.is_file():
+            try:
+                undistorter = _read(path)
+            except Exception as error:
+                logger.error("Ignoring camera calibration {}: {}", path, error)
+                return None
+            logger.info("Camera {!r}: undistorting with {}", camera_name, path)
+            return undistorter
+    return None
