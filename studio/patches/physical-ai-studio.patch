+
+@dataclass
+class _Entry:
+    path: str
+
+
+class _Volume:
+    def __init__(self, files: dict[str, bytes]) -> None:
+        self.files = files
+
+    def listdir(self, path: str):
+        return [_Entry(name) for name in self.files if name.startswith(path + "/")]
+
+    def read_file(self, path: str):
+        yield self.files[path]
+
+
+@pytest.fixture(autouse=True)
+def _snapshot_tmp(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
