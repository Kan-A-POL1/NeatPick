@@ -0,0 +1,81 @@
+"""junction-2026: move the follower smoothly to a saved pose, then hold it there (``Return home``)."""
+
+from __future__ import annotations
+
+import time
+from collections import deque
+from typing import TYPE_CHECKING
+
+import numpy as np
+
+from runtime_session.controls.base import Control
+from runtime_session.store import ACTION, STATE
+from services.arm_poses import move_profile
+
+if TYPE_CHECKING:
+    from runtime_session.store import Store
+    from schemas.runtime_session import MoveControlConfig
+
+
+def by_bare_joint(values: dict[str, float], what: str) -> dict[str, float]:
+    """junction-2026: key a pose by joint name without the ".pos" suffix, refusing a pose that names a joint twice
+    (``shoulder_pan`` and ``shoulder_pan.pos``): merging them would silently pick one target."""
+    out: dict[str, float] = {}
+    for key, value in values.items():
+        bare = key.removesuffix(".pos")
+        if bare in out:
+            raise ValueError(f"{what} names joint {bare!r} twice (with and without '.pos')")
+        out[bare] = value
+    return out
+
+
+def pose_vector(store: Store, pose: dict[str, float] | None, name: str) -> np.ndarray:
+    """The pose's joints in the store's order. Raises ``ValueError`` when it is missing or does not fit the follower."""
+    if pose is None:
+        raise ValueError(f"No pose {name!r} is saved for this follower; set it first")
+    joints = store.spec.joint_names
+    # junction-2026: the Hackathon page saves poses with the driver's names ("shoulder_pan.pos"), the runtime store
+    # uses bare names ("shoulder_pan"): compare them without the ".pos" suffix.
+    bare = by_bare_joint(pose, f"Pose {name!r}")
+    if set(bare) != set(by_bare_joint(dict.fromkeys(joints, 0.0), "The follower")):
+        raise ValueError(f"Pose {name!r} has joints {sorted(pose)}, the follower {list(joints)}")
+    return np.array([bare[joint.removesuffix(".pos")] for joint in joints], dtype=np.float64)
+
+
+class PoseMover:
+    """Waypoints from where the follower is to ``target``, eased in and out, then ``target`` for ever."""
+
+    def __init__(self, store: Store, target: np.ndarray, hz: float) -> None:
+        self.store = store
+        self.target = target
+        self.hz = hz
+        self._waypoints: deque[np.ndarray] = deque()
+
+    def start(self) -> None:
+        """Raises ``ValueError`` when the follower's position is unknown."""
+        state = self.store.read(STATE)
+        if state is None:
+            raise ValueError("The follower's position is unknown; cannot move it")
+        self._waypoints = deque(move_profile(np.asarray(state.value, dtype=np.float64), self.target, self.hz))
+
+    @property
+    def arrived(self) -> bool:
+        return not self._waypoints
+
+    def tick(self) -> None:
+        goal = self._waypoints.popleft() if self._waypoints else self.target
+        self.store.write(ACTION, goal, timestamp=time.monotonic())
+
+
+class MoveControl(Control):
+    """Send the follower to a saved pose at a bounded speed (``move_profile``), then keep it there, torque on."""
+
+    def __init__(self, store: Store, config: MoveControlConfig) -> None:
+        super().__init__(store, config, name="MoveControl", hz=config.hz)
+        self.mover = PoseMover(store, pose_vector(store, config.target, config.pose), config.hz)
+
+    def on_start(self) -> None:
+        self.mover.start()
+
+    def on_tick(self) -> None:
+        self.mover.tick()
