+"""Intermediate snapshots (junction-2026 patch): callback wiring and per-snapshot export."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+from pydantic import ValidationError
+
+from training import TrainingJobSpec
+from training.job import CHECKPOINT_NAME, SNAPSHOTS_DIRNAME, _export_snapshots
+
+JOB = "training.job"
+
+
+def _snapshot_callbacks(spec: TrainingJobSpec, tmp_path: Path) -> list:
+    from lightning.pytorch.callbacks import ModelCheckpoint
+
+    from training.job import run_training_job
+
+    cache_dir = tmp_path / "cache" / "job"
+
+    def fake_fit(*_args: object, **_kwargs: object) -> None:
+        (cache_dir / CHECKPOINT_NAME).write_text("best")
+
+    with (
+        patch("physicalai.data.LeRobotDataModule"),
+        patch(f"{JOB}.build_policy", return_value=MagicMock()),
+        patch(f"{JOB}._load_policy_from_checkpoint", return_value=MagicMock()),
+        patch("physicalai.train.trainer.Trainer") as trainer_class,
+    ):
+        trainer_class.return_value.fit.side_effect = fake_fit
+        run_training_job(
+            spec,
+            dataset_root=tmp_path / "snapshot",
+            output_dir=tmp_path / "model",
+            cache_dir=cache_dir,
+            report=MagicMock(),
+            should_stop=lambda: False,
+        )
+    callbacks = trainer_class.call_args.kwargs["callbacks"]
+    return [c for c in callbacks if isinstance(c, ModelCheckpoint) and c.monitor is None]
+
+
+class TestSnapshotSpec:
+    def test_snapshots_are_off_by_default(self) -> None:
+        assert TrainingJobSpec(policy="act").snapshot_every_n_steps is None
+
+    def test_interval_must_be_positive(self) -> None:
+        with pytest.raises(ValidationError):
+            TrainingJobSpec(policy="act", snapshot_every_n_steps=0)
+
+
+class TestSnapshotCallback:
+    def test_no_snapshot_callback_without_an_interval(self, tmp_path: Path) -> None:
+        assert _snapshot_callbacks(TrainingJobSpec(policy="act"), tmp_path) == []
+
+    def test_interval_keeps_every_step_checkpoint_weights_only(self, tmp_path: Path) -> None:
+        [callback] = _snapshot_callbacks(TrainingJobSpec(policy="act", snapshot_every_n_steps=500), tmp_path)
+        assert callback.dirpath == str(tmp_path / "cache" / "job" / SNAPSHOTS_DIRNAME)
+        assert callback._every_n_train_steps == 500
+        assert callback.save_top_k == -1
+        assert callback.save_weights_only is True
+        assert callback.format_checkpoint_name({"step": 1500}).endswith("step-001500.ckpt")
+
+
+class TestExportSnapshots:
