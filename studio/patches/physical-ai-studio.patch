+import { formatPercent, formatRate, formatSeconds, remainingSeconds } from './benchmark-format';
+
+const stats = {
+    trials: 5,
+    successes: 3,
+    failures: 1,
+    aborted: 1,
+    success_rate: 0.75,
+    ci_low: 0.3006,
+    ci_high: 0.9544,
+    mean_time_to_success_s: 4.25,
+    median_time_to_success_s: 4,
+};
+
+describe('benchmark formatting', () => {
+    it('shows the rate with its confidence interval', () => {
+        expect(formatRate(stats)).toBe('75 % (95 % CI 30–95 %)');
+    });
+
+    it('shows a dash before any marked trial', () => {
+        expect(formatRate({ ...stats, success_rate: null, ci_low: null, ci_high: null })).toBe('—');
+        expect(formatPercent(null)).toBe('—');
+        expect(formatSeconds(undefined)).toBe('—');
+        expect(formatSeconds(4.25)).toBe('4.3 s');
+    });
+
+    it('counts the time left down from the start and stops at zero', () => {
+        expect(remainingSeconds(100, 10, 103_500)).toBeCloseTo(6.5);
+        expect(remainingSeconds(100, 10, 200_000)).toBe(0);
+        expect(remainingSeconds(null, 10, 0)).toBe(10);
+    });
+});
diff --git a/application/ui/src/features/runtime-session/workspace/benchmark-format.ts b/application/ui/src/features/runtime-session/workspace/benchmark-format.ts
new file mode 100644
index 00000000..924d5a63
--- /dev/null
+++ b/application/ui/src/features/runtime-session/workspace/benchmark-format.ts
@@ -0,0 +1,21 @@
+import { SchemaBenchmarkStats } from '../../../api/openapi-spec';
+
+/** junction-2026: how the benchmark panel words its numbers. */
+
+export const formatPercent = (value: number | null | undefined) =>
+    value === null || value === undefined ? '—' : `${Math.round(value * 100)} %`;
+
+export const formatSeconds = (value: number | null | undefined) =>
+    value === null || value === undefined ? '—' : `${value.toFixed(1)} s`;
+
+/** "75 % (95 % CI 51–90 %)", or a dash before the first marked trial. */
+export const formatRate = (stats: SchemaBenchmarkStats) =>
+    stats.success_rate === null || stats.success_rate === undefined
+        ? '—'
+        : `${formatPercent(stats.success_rate)} (95 % CI ${Math.round((stats.ci_low ?? 0) * 100)}–${Math.round(
+              (stats.ci_high ?? 0) * 100
+          )} %)`;
+
+/** Seconds left in a trial started at ``startedAt`` (unix seconds), never below zero. */
+export const remainingSeconds = (startedAt: number | null | undefined, durationS: number, nowMs: number) =>
+    startedAt === null || startedAt === undefined ? durationS : Math.max(0, durationS - (nowMs / 1000 - startedAt));
