+            patch(f"{JOB}._export") as export,
+        ):
+            _export_snapshots(TrainingJobSpec(policy="act", compile_model=True), tmp_path, MagicMock())
+
+        for step in (300, 600):
+            assert (snapshots / f"step-{step:06d}" / CHECKPOINT_NAME).read_text() == str(step)
+        assert not list(snapshots.glob("*.ckpt"))
+        assert [call.args[1] for call in export.call_args_list] == [
+            snapshots / "step-000300",
+            snapshots / "step-000600",
+        ]
+        assert all(call.args[0].compile_model is False for call in load.call_args_list)
+
+    def test_a_failing_snapshot_does_not_stop_the_others(self, tmp_path: Path) -> None:
+        snapshots = tmp_path / SNAPSHOTS_DIRNAME
+        snapshots.mkdir()
+        for step in (300, 600):
+            (snapshots / f"step-{step:06d}.ckpt").write_text(str(step))
