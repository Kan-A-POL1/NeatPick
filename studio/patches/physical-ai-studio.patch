+
+def test_a_failed_import_is_retried_on_the_next_poll() -> None:
+    prefix = "jobs/y"
+    volume = _Volume({f"{prefix}/snapshots/step-000500.ckpt": b"a"})
+    calls = []
+
+    async def on_snapshot(step: int, checkpoint: Path) -> None:
+        calls.append(step)
+        if len(calls) == 1:
+            raise RuntimeError("export failed")
+
+    context = _context(on_snapshot)
+    backend = ModalTrainingBackend.__new__(ModalTrainingBackend)
+    asyncio.run(backend._sync_snapshots(context, volume, prefix))
+    asyncio.run(backend._sync_snapshots(context, volume, prefix))
+    asyncio.run(backend._sync_snapshots(context, volume, prefix))
+    assert calls == [500, 500]
+
+
+def test_a_snapshot_that_keeps_failing_is_dropped_after_three_attempts() -> None:
+    prefix = "jobs/z"
+    volume = _Volume({f"{prefix}/snapshots/step-000500.ckpt": b"a"})
+    calls = []
+
+    async def on_snapshot(step: int, checkpoint: Path) -> None:
+        calls.append(step)
+        raise OSError(122, "Disk quota exceeded")
+
+    context = _context(on_snapshot)
+    backend = ModalTrainingBackend.__new__(ModalTrainingBackend)
+    for _ in range(5):
+        asyncio.run(backend._sync_snapshots(context, volume, prefix))
+    assert calls == [500, 500, 500]
+
+
+def test_snapshots_are_fetched_to_disk_and_cleaned_up(_snapshot_tmp: Path) -> None:
+    prefix = "jobs/d"
+    volume = _Volume({f"{prefix}/snapshots/step-000500.ckpt": b"a"})
+    parents: list[Path] = []
+
+    async def on_snapshot(step: int, checkpoint: Path) -> None:
+        parents.append(checkpoint.parent.parent)
+
+    backend = ModalTrainingBackend.__new__(ModalTrainingBackend)
+    asyncio.run(backend._sync_snapshots(_context(on_snapshot), volume, prefix))
+    assert parents == [_snapshot_tmp]
+    assert list(_snapshot_tmp.iterdir()) == []
+
+
+def test_no_snapshot_is_fetched_while_a_stop_is_pending() -> None:
+    prefix = "jobs/s"
+    volume = _Volume({f"{prefix}/snapshots/step-000500.ckpt": b"a"})
+    volume.read_file = MagicMock(side_effect=AssertionError("must not download during a stop"))
+    seen = []
+
+    async def on_snapshot(step: int, checkpoint: Path) -> None:
+        seen.append(step)
+
+    backend = ModalTrainingBackend.__new__(ModalTrainingBackend)
+    asyncio.run(backend._sync_snapshots(_context(on_snapshot, stop=True), volume, prefix))
+    assert seen == []
+    volume.read_file.assert_not_called()
