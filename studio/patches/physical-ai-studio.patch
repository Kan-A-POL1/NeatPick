+    y: float = Field(..., ge=0.0, lt=1.0, description="Top edge, fraction of the frame height")
+    width: float = Field(..., gt=0.0, le=1.0, description="Region width, fraction of the frame width")
+    height: float = Field(..., gt=0.0, le=1.0, description="Region height, fraction of the frame height")
+
+    @model_validator(mode="after")
+    def _inside_frame(self) -> "CameraCrop":
+        if self.x + self.width > 1.0 + 1e-6 or self.y + self.height > 1.0 + 1e-6:
+            raise ValueError("crop region must stay inside the frame")
+        if self.width < MIN_CROP_FRACTION or self.height < MIN_CROP_FRACTION:
+            raise ValueError(f"crop region must keep at least {MIN_CROP_FRACTION:.0%} of each dimension")
+        return self
+
+
+MIN_CROP_FRACTION = 0.1
+"""Smallest crop side (10 %, i.e. a 10x zoom) — below that the upscaled image is mostly interpolation."""
+
+CROP_FIELD = Field(None, description="Region of the frame to keep (digital zoom); null keeps the full frame")
