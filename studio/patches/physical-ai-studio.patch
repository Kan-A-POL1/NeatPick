--- /dev/null
+++ b/application/ui/src/features/cameras/crop-math.ts
@@ -0,0 +1,60 @@
+/** Crop region of the full frame, in fractions of its width and height (junction-2026 patch). */
+export interface CameraCrop {
+    x: number;
+    y: number;
+    width: number;
+    height: number;
+}
+
+/** Smallest crop side, as the backend enforces. */
+export const MIN_CROP = 0.1;
+
+export const FULL_FRAME: CameraCrop = { x: 0, y: 0, width: 1, height: 1 };
+
+const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);
+
+export const isFullFrame = (crop: CameraCrop) =>
+    crop.x <= 0.0005 && crop.y <= 0.0005 && crop.width >= 0.999 && crop.height >= 0.999;
+
+/**
+ * Size of the frames a cropped camera delivers, as the backend computes it: the crop's own shape, as large as fits
+ * in the configured resolution, with even sides.
+ */
+export const outputSize = (width: number, height: number, crop: CameraCrop | null | undefined): [number, number] => {
+    if (!crop) {
+        return [width, height];
+    }
+    const ratio = (crop.width * width) / (crop.height * height);
+    const [w, h] = ratio >= width / height ? [width, width / ratio] : [height * ratio, height];
+    return [Math.max(2, Math.round(w / 2) * 2), Math.max(2, Math.round(h / 2) * 2)];
+};
+
+/** ``crop`` moved by (dx, dy) fractions of the frame, kept inside it. */
+export const moveCrop = (crop: CameraCrop, dx: number, dy: number): CameraCrop => ({
+    ...crop,
+    x: clamp(crop.x + dx, 0, 1 - crop.width),
+    y: clamp(crop.y + dy, 0, 1 - crop.height),
+});
+
+export type Edge = 'n' | 's' | 'e' | 'w' | 'ne' | 'nw' | 'se' | 'sw';
+
+/** ``crop`` with the edges named by ``edge`` dragged by (dx, dy), kept inside the frame and above MIN_CROP. */
+export const resizeCrop = (crop: CameraCrop, edge: Edge, dx: number, dy: number): CameraCrop => {
+    let left = crop.x;
+    let top = crop.y;
+    let right = crop.x + crop.width;
+    let bottom = crop.y + crop.height;
+    if (edge.includes('w')) {
+        left = clamp(left + dx, 0, right - MIN_CROP);
+    }
+    if (edge.includes('e')) {
+        right = clamp(right + dx, left + MIN_CROP, 1);
+    }
+    if (edge.includes('n')) {
+        top = clamp(top + dy, 0, bottom - MIN_CROP);
+    }
+    if (edge.includes('s')) {
+        bottom = clamp(bottom + dy, top + MIN_CROP, 1);
+    }
+    return { x: left, y: top, width: right - left, height: bottom - top };
+};
