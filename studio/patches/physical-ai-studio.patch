--- /dev/null
+++ b/application/ui/src/features/hackathon/hackathon-page.tsx
@@ -0,0 +1,209 @@
+import { useState } from 'react';
+
+import {
+    ActionButton,
+    Button,
+    Divider,
+    Flex,
+    Heading,
+    Item,
+    Picker,
+    Switch,
+    Text,
+    TextField,
+    toast,
+    View,
+} from '@geti-ui/ui';
+import { Delete } from '@geti-ui/ui/icons';
+
+import { $api } from '../../api/client';
+import { getApiErrorMessage } from '../../api/errors';
+import { SchemaArmStatus } from '../../api/openapi-spec';
+import { getQueryKey } from '../../query-client/query-client.interface';
+import { useProjectId } from '../projects/use-project';
+
+import classes from './hackathon-page.module.css';
+
+const useArm = (project_id: string, environment_id: string) => {
+    const params = { path: { project_id }, query: { environment_id } };
+    // Polled: teleop can stop by itself (the arm dropped off USB) and another program can take the arm.
+    const status = $api.useQuery(
+        'get',
+        '/api/projects/{project_id}/hackathon/arm',
+        { params },
+        { refetchInterval: 2000 }
+    );
+    const options = {
+        meta: { invalidates: [getQueryKey(['get', '/api/projects/{project_id}/hackathon/arm', { params }])] },
+        onError: (error: unknown) => {
+            toastError(error);
+        },
+    };
+    return {
+        params,
+        status,
+        teleop: $api.useMutation('post', '/api/projects/{project_id}/hackathon/arm/teleop', options),
+        save: $api.useMutation('post', '/api/projects/{project_id}/hackathon/arm/poses', options),
+        go: $api.useMutation('post', '/api/projects/{project_id}/hackathon/arm/poses/{name}/go', options),
+        remove: $api.useMutation('delete', '/api/projects/{project_id}/hackathon/arm/poses/{name}', options),
+        torqueOff: $api.useMutation('post', '/api/projects/{project_id}/hackathon/arm/torque-off', options),
+    };
+};
+
+const toastError = (error: unknown) => toast.negative(getApiErrorMessage(error) ?? 'The arm did not respond.');
+
+const ArmStatusLine = ({ status }: { status: SchemaArmStatus }) => (
+    <Flex direction='column' gap='size-50'>
+        <Text>{`Follower: ${status.follower} · Leader: ${status.leader ?? 'none'}`}</Text>
+        {status.in_use_by.length > 0 && (
+            <Text UNSAFE_className={classes.warning}>
+                {`In use by ${status.in_use_by.join(', ')}: stop it to drive the arm from here.`}
+            </Text>
+        )}
+        {status.error && <Text UNSAFE_className={classes.warning}>{`Last error: ${status.error}`}</Text>}
+    </Flex>
+);
+
+const ArmPanel = ({ project_id, environment_id }: { project_id: string; environment_id: string }) => {
+    const arm = useArm(project_id, environment_id);
+    const [name, setName] = useState('');
+    const [moving, setMoving] = useState<string | null>(null);
+    const status = arm.status.data;
+    const isBusy = [arm.teleop, arm.save, arm.go, arm.remove, arm.torqueOff].some((mutation) => mutation.isPending);
+
+    if (status === undefined) {
+        return (
+            <Text>{arm.status.error ? (getApiErrorMessage(arm.status.error) ?? 'No arm status.') : 'Loading…'}</Text>
+        );
+    }
+
+    const goTo = (pose: string) => {
+        setMoving(pose);
+        arm.go.mutate(
+            { params: { ...arm.params, path: { ...arm.params.path, name: pose } } },
+            { onSettled: () => setMoving(null) }
+        );
+    };
+
+    return (
+        <Flex direction='column' gap='size-200'>
+            <ArmStatusLine status={status} />
+            <Flex alignItems='center' gap='size-300' wrap>
+                <Switch
+                    isSelected={status.teleop}
+                    isDisabled={isBusy || status.leader === null}
+                    onChange={(on) => arm.teleop.mutate({ params: arm.params, body: { on } })}
+                >
+                    Teleop (the leader drives the follower)
+                </Switch>
+                <Button
+                    variant='negative'
+                    isDisabled={isBusy}
+                    onPress={() => arm.torqueOff.mutate({ params: arm.params })}
+                >
+                    Torque off
+                </Button>
+                <Text UNSAFE_className={classes.hint}>Torque off: the arm drops, hold it. Then pose it by hand.</Text>
+            </Flex>
+
+            <Divider size='S' />
+            <Heading level={3} margin={0}>
+                Poses
+            </Heading>
+            {Object.keys(status.poses).length === 0 && (
+                <Text UNSAFE_className={classes.hint}>
+                    No pose yet: put the arm where you want it (teleop or by hand), name it and save it.
+                </Text>
+            )}
+            {Object.keys(status.poses)
+                .sort()
+                .map((pose) => (
+                    <Flex key={pose} alignItems='center' gap='size-150'>
+                        <Button
+                            variant='accent'
+                            isDisabled={isBusy}
+                            isPending={moving === pose}
+                            onPress={() => goTo(pose)}
+                        >
+                            {`Go to ${pose}`}
+                        </Button>
+                        <Text UNSAFE_className={classes.joints}>
+                            {Object.values(status.poses[pose])
+                                .map((value) => value.toFixed(0))
+                                .join(' · ')}
+                        </Text>
+                        <ActionButton
+                            isQuiet
+                            aria-label={`Delete pose ${pose}`}
+                            isDisabled={isBusy}
+                            onPress={() =>
+                                arm.remove.mutate({
+                                    params: { ...arm.params, path: { ...arm.params.path, name: pose } },
+                                })
+                            }
+                        >
+                            <Delete />
+                        </ActionButton>
+                    </Flex>
+                ))}
+            <form
+                onSubmit={(event) => {
+                    event.preventDefault();
+                    if (name.trim() === '') return;
+                    arm.save.mutate(
+                        { params: arm.params, body: { name: name.trim() } },
+                        { onSuccess: () => setName('') }
+                    );
+                }}
+            >
+                <Flex alignItems='end' gap='size-150'>
+                    <TextField
+                        label='Pose name'
+                        description='Saving a name that exists replaces it'
+                        value={name}
+                        onChange={setName}
+                    />
+                    <Button type='submit' variant='primary' isDisabled={isBusy || name.trim() === ''}>
+                        Save current pose
+                    </Button>
+                </Flex>
+            </form>
+        </Flex>
+    );
+};
+
+/** junction-2026: the arm controls we need between sessions, on one page. */
+export const HackathonPage = () => {
+    const { project_id } = useProjectId();
+    const { data: environments } = $api.useSuspenseQuery('get', '/api/projects/{project_id}/environments', {
+        params: { path: { project_id } },
+    });
+    const [environmentId, setEnvironmentId] = useState<string | undefined>(environments[0]?.id);
+
+    return (
+        <View padding='size-300' height='100%' UNSAFE_style={{ overflowY: 'auto' }}>
+            <Flex direction='column' gap='size-200' maxWidth='size-6000'>
+                <Heading level={2} margin={0}>
+                    Arm
+                </Heading>
+                {environments.length === 0 ? (
+                    <Text>Create an environment with a follower and a leader first.</Text>
+                ) : (
+                    <>
+                        <Picker
+                            label='Environment'
+                            items={environments}
+                            selectedKey={environmentId}
+                            onSelectionChange={(key) => key !== null && setEnvironmentId(String(key))}
+                        >
+                            {(environment) => <Item key={environment.id}>{environment.name}</Item>}
+                        </Picker>
+                        {environmentId !== undefined && (
+                            <ArmPanel key={environmentId} project_id={project_id} environment_id={environmentId} />
+                        )}
+                    </>
+                )}
+            </Flex>
+        </View>
+    );
+};
