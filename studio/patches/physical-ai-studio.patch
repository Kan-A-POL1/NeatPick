+"""Stop on loss targets (junction-2026 patch)."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from pydantic import ValidationError
+
+from training import TrainingJobSpec
+from training.job import _loss_target_stop
+
+
+def _epoch(callback, train_losses: list[float], val_loss: float | None) -> bool:
+    trainer = SimpleNamespace(callback_metrics={}, current_epoch=3, should_stop=False)
+    callback.on_train_epoch_start(trainer, None)
+    for loss in train_losses:
+        trainer.callback_metrics["train/loss"] = torch.tensor(loss)
+        callback.on_train_batch_end(trainer, None, None, None, 0)
+    if val_loss is not None:
+        trainer.callback_metrics["val/loss"] = torch.tensor(val_loss)
+    callback.on_train_epoch_end(trainer, None)
+    return trainer.should_stop
+
+
+def test_stops_when_both_targets_are_reached() -> None:
+    assert _epoch(_loss_target_stop(0.05, 0.1), [0.06, 0.04, 0.03], 0.09)
+
+
+def test_mean_train_loss_not_the_last_step_decides() -> None:
+    assert not _epoch(_loss_target_stop(0.05, None), [0.2, 0.01], None)  # last step 0.01 but mean 0.105
+
+
+def test_validation_target_alone_is_not_enough_when_train_is_above() -> None:
+    assert not _epoch(_loss_target_stop(0.05, 0.1), [0.08], 0.05)
+
+
+def test_validation_target_needs_a_validation_loss() -> None:
+    assert not _epoch(_loss_target_stop(None, 0.1), [0.01], None)
+
+
+def test_each_epoch_is_judged_on_its_own_steps() -> None:
+    callback = _loss_target_stop(0.05, None)
+    assert not _epoch(callback, [1.0, 1.0], None)
+    assert _epoch(callback, [0.04], None)
+
+
+def test_targets_must_be_positive() -> None:
+    with pytest.raises(ValidationError):
+        TrainingJobSpec(policy="act", stop_train_loss=0)
+
+
+def test_live_runs_hand_snapshots_over_instead_of_exporting_them(tmp_path) -> None:
+    from training.job import SNAPSHOTS_DIRNAME, _hand_over_snapshots, live_snapshots_dir
+
+    output = tmp_path / "models" / "job"
+    (output / SNAPSHOTS_DIRNAME).mkdir(parents=True)
+    (output / SNAPSHOTS_DIRNAME / "step-000100.ckpt").write_text("w")
+    _hand_over_snapshots(output)
+    assert not (output / SNAPSHOTS_DIRNAME).exists()  # nothing left to archive with the model
+    assert (live_snapshots_dir(output) / "step-000100.ckpt").read_text() == "w"
