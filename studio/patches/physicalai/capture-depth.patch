+def _hardware_reset_realsense(config: dict) -> None:
+    """Power-cycle a RealSense from firmware (best-effort): clears the -71 / stuck-stream USB states."""
+    camera = config.get("camera") or {}
+    if not str(camera.get("class_path", "")).endswith("RealSenseCamera"):
+        return
+    serial = str((camera.get("init_args") or {}).get("serial_number", ""))
+    try:
+        import pyrealsense2 as rs  # noqa: PLC0415
+
+        for device in rs.context().query_devices():
+            if device.get_info(rs.camera_info.serial_number) == serial:
+                logger.warning(f"Hardware-resetting RealSense {serial}")
+                device.hardware_reset()
+                return
+        logger.warning(f"RealSense {serial} not enumerated; cannot reset it")
+    except Exception as exc:  # noqa: BLE001
+        logger.warning(f"RealSense {serial} hardware reset failed: {exc!r}")
+
