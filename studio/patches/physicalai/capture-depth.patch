+def _recover_camera(state: _PublisherState, service_name: str, progress: list[float]) -> bool:
+    """Reopen the device after repeated read failures, resetting a RealSense once on the way.
+
+    Returns:
+        ``True`` once a reopened camera delivers frames, ``False`` after ``_RECOVER_FOR_S``.
+    """
+    deadline = time.monotonic() + _RECOVER_FOR_S
+    attempt = 0
+    with state.lock:
+        old_camera = state.camera
+    with contextlib.suppress(Exception):
+        old_camera.disconnect()
+    while not shutdown.is_set() and time.monotonic() < deadline:
+        attempt += 1
+        progress[0] = time.monotonic()
+        if attempt == 3:
+            _hardware_reset_realsense(state.config)
+            shutdown.wait(5.0)
+        try:
+            camera = build_camera(state.config)
+            camera.connect()
+            camera.read(timeout=2.0)
+        except Exception as exc:  # noqa: BLE001
+            logger.warning(f"Reopening camera for {service_name} failed (attempt {attempt}): {exc!r}")
+            with contextlib.suppress(Exception):
+                camera.disconnect()  # type: ignore[possibly-undefined]
+            shutdown.wait(_RECOVER_BACKOFF_S)
+            continue
+        with state.lock:
+            state.camera = camera
+        logger.info(f"Camera for {service_name} recovered after {attempt} attempt(s)")
+        return True
+    return False
+
+
+def _start_stall_watchdog(progress: list[float], service_name: str) -> None:
+    """Exit the process when the capture loop stops making progress (driver call stuck)."""
+
+    def watch() -> None:
+        while not shutdown.wait(1.0):
+            stalled = time.monotonic() - progress[0]
+            if stalled > _STALL_EXIT_S:
+                logger.error(
+                    f"Capture loop for {service_name} stuck for {stalled:.0f}s -- exiting so the device is released",
+                )
+                with contextlib.suppress(Exception):
+                    sys.stderr.flush()
+                os._exit(_STALL_EXIT_CODE)
+
+    threading.Thread(target=watch, daemon=True, name="stall-watchdog").start()
